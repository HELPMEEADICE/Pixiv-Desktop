target/
.DS_Store
*.pdb
# Screenshots are captured locally. Only the curated set used by the README is
# tracked, because everything else churns on every visual change.
/docs/screenshots/*
!/docs/screenshots/readme/
# The sidecar JSON carries a capture timestamp and the host's screen bounds, so
# it would produce a diff on every run without telling a reviewer anything.
/docs/screenshots/readme/*.json
target-rel/
# Harness scratch output.
/docs/*.log

# Local live-test credentials and captured network samples. Never committed.
.local-secrets/

# Local probe / harness scratch (never part of the project).
tools/_*
