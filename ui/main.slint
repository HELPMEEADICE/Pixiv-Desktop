// Application shell: top command bar, NavigationView pane, page router, status bar.
//
// Window chrome note: the window keeps the *native* frame. Slint can draw a custom
// one via `no-frame: true`, but then window dragging, Snap Layouts, per-monitor
// DPI changes and accessibility all have to be reimplemented against
// `Window::set_position`, which is jittery and loses Win11 snapping. Keeping the
// native frame and putting Fluent chrome inside it keeps correct DPI behaviour and
// real Snap Layouts; the in-app top bar supplies the Windows-11 look.
//
// Routing note: the five artwork destinations share one `GalleryPage` instance
// because Rust reloads the model for every navigation anyway. Scroll restoration
// is therefore owned by Rust (`App::scroll_offsets`) rather than by five parallel
// page instances, which keeps this file honest about what it does.
//
// Keyboard: every shortcut is handled by one ancestor `FocusScope`, so it works
// whether focus is on the window itself or inside the search box. Only
// modifier-qualified combinations are intercepted, so typing never fights the UI.
//
// Vertical alignment note: inside a `HorizontalLayout` a child with a fixed height
// is aligned to the *start* of the cross axis, not centred (measured: 15.5 physical
// px at 150 % DPI on the old navigation rail). Every fixed-size element in the top
// bar therefore either fills the bar (`IconButton.row-height`, `AppButton.row-height`)
// or derives its `y` from `Theme.topbar-height`.

// Re-exported rather than merely imported: `slint::include_modules!` only emits
// bindings for what the root file *exports*, and Rust has to reach the `Theme`
// global (`ui.global::<Theme>()`) to push the persisted theme choice into it.
import { Theme, Type, ThemeMode } from "theme.slint";
import { Tip, TipSide } from "tip.slint";
export { Theme, Type, ThemeMode } from "theme.slint";
export { Tip, TipSide } from "tip.slint";
import {
    IconButton, TextField, NavItem, Divider, HoverTip, IllustItem, IconSlot, TipPlacement,
    Avatar, RecommendTagItem, RecommendUserItem, SuggestionItem, ProfileStatItem,
} from "components.slint";
import { HomePage } from "pages/home.slint";
import { GalleryPage } from "pages/gallery.slint";
import { DetailPage, ViewerPage } from "pages/detail.slint";
import { DownloadsPage, DownloadRow } from "pages/downloads.slint";
import { SettingsPage } from "pages/settings.slint";
import { ProfilePage } from "pages/profile.slint";

/// One row of the search-suggestion dropdown.
///
/// Local search history is drawn with a different glyph and colour, because a
/// local recollection must never look like a Pixiv suggestion.
component SuggestRow inherits Rectangle {
    in property <SuggestionItem> item;
    callback choose();

    height: 34px;
    background: root.item.active ? Theme.accent-subtle
        : (row.has-hover ? Theme.layer-alt : transparent);

    row := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.choose(); }
    }

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-2;
        spacing: Theme.space-2;

        IconSlot {
            name: root.item.local ? "history" : "tag";
            slot: 14px;
            tint: root.item.local ? Theme.text-tertiary : Theme.text-secondary;
        }
        Text {
            text: root.item.label;
            color: Theme.text;
            font-size: Theme.font-small;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.item.count != "" : Text {
            text: root.item.count;
            color: Theme.text-tertiary;
            font-size: Theme.font-caption;
            vertical-alignment: center;
        }
    }
}

export enum Destination {
    Home,
    Discovery,
    Ranking,
    Search,
    Bookmarks,
    History,
    Detail,
    Downloads,
    Settings,
    /// The native artist / user page, reached from any author reference.
    UserProfile,
}

export component AppWindow inherits Window {
    title: "Pixiv Desktop";
    min-width: 720px;
    min-height: 520px;
    preferred-width: 1180px;
    preferred-height: 820px;
    background: Theme.canvas;
    // One place sets the app's typeface: every `Text` that does not override
    // `font-family` inherits this, and Windows falls back per-glyph for CJK.
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-body;

    in property <Destination> page: Destination.Home;
    /// User's manual override for the NavigationView pane.
    in-out property <bool> rail-collapsed: false;
    /// Pane collapsed state; set by Rust from the width-changed event.
    ///
    /// Deliberately not bound to the window width here: making the NavItem layout
    /// information depend on the window's own layout information is exactly the
    /// binding loop Slint warns about. The window width is known authoritatively
    /// to the host, so it is pushed in from Rust on the change event instead.
    in property <bool> narrow: false;
    out property <bool> rail-compact: root.rail-collapsed || root.narrow;
    /// Content box width (window minus the navigation pane), pushed from Rust so
    /// pages never have to read the window width from inside their own layout.
    in property <length> content-width: 880px;
    in property <bool> demo-mode: false;
    /// Debug-only anchor for one tooltip, set from `PIXIV_DESKTOP_TIP`. Hover
    /// cannot be synthesised here, so this is how the overlay is measured.
    in property <bool> debug-tip: false;
    in property <string> status-text: "";
    in property <string> session-user: "";
    in property <bool> authenticated: false;
    /// The signed-in account's real avatar, decoded from i.pximg.net.
    in property <image> account-avatar;
    /// 0 ok, 1 loading, 2 failed or absent
    in property <int> account-avatar-state: 2;

    // ---- home sections (each loads and fails on its own) ----
    in property <[RecommendTagItem]> home-tags: [];
    in property <[RecommendUserItem]> home-artists: [];
    in property <[IllustItem]> home-latest: [];
    in property <string> home-latest-title: "最新作品";
    /// 0 content, 1 loading, 2 empty, 3 error
    in property <int> home-feed-state: 1;
    in property <int> home-latest-state: 1;
    in property <int> home-tags-state: 1;
    in property <int> home-artists-state: 1;
    in property <string> home-feed-message: "";
    in property <string> home-latest-message: "";
    in property <string> home-tags-message: "";
    in property <string> home-artists-message: "";
    in property <string> home-source-note: "";

    // ---- discovery ----
    in property <[RecommendUserItem]> discovery-users: [];
    in property <int> discovery-users-state: 1;
    in property <string> discovery-users-message: "";

    // ---- search suggestions ----
    in property <[SuggestionItem]> suggestions: [];
    in property <bool> suggest-visible: false;
    in property <string> suggest-note: "";

    // ---- native user profile ----
    in property <string> profile-name: "";
    in property <string> profile-account: "";
    in property <string> profile-uid: "";
    in property <string> profile-comment: "";
    in property <string> profile-webpage: "";
    in property <image> profile-avatar;
    in property <int> profile-avatar-state: 1;
    in property <image> profile-background;
    in property <bool> profile-premium: false;
    in property <bool> profile-self: false;
    /// Content box is wide enough for the two-column profile header.
    in property <bool> profile-wide: true;
    in property <bool> profile-followed: false;
    in property <bool> profile-busy: false;
    in property <[ProfileStatItem]> profile-stats: [];
    in property <int> profile-state: 1;
    in property <string> profile-message: "";
    in property <string> profile-count-label: "";

    // ---- theme ----
    /// `Theme.mode` and `Theme.system-dark` live in the `Theme` global, which
    /// Rust writes directly: the theme is a process-wide choice, not a property of
    /// one window, and routing it through the shell only added a copy that could
    /// disagree. `dark` is derived inside the global, so no page can set a
    /// contradictory state.
    out property <bool> dark: Theme.dark;

    in-out property <string> search-text: "";
    in property <string> search-word: "";
    in property <bool> can-go-back: false;
    in property <bool> can-go-forward: false;

    // ---- shared artwork-feed state ----
    in property <[[IllustItem]]> grid-columns: [];
    in property <length> grid-card-width: 220px;
    in property <int> grid-state: 0;
    /// Headline and glyph for the empty/error/locked block of a feed page.
    in property <string> grid-state-title: "";
    in property <string> grid-state-glyph: "";
    in property <string> grid-message: "";
    in property <string> grid-action-label: "前往设置";
    in property <string> grid-count-label: "";
    /// Previous search terms for the empty-search state (real local history).
    in property <[string]> recent-searches: [];
    in property <[string]> grid-tags: [];
    in property <string> grid-active-tag: "";
    in property <bool> grid-loading-more: false;
    in property <int> ranking-filter: 0;
    in property <[string]> ranking-filters: [];
    in-out property <length> grid-scroll-y: 0px;
    in-out property <length> home-scroll-y: 0px;

    // ---- detail state ----
    in property <[ViewerPage]> detail-pages: [];
    in-out property <int> detail-page-index: 0;
    in property <int> detail-state: 0;
    in property <string> detail-message: "";
    in property <string> detail-title: "";
    in property <string> detail-author: "";
    in property <string> detail-author-id: "";
    in property <image> detail-author-avatar;
    in property <int> detail-author-avatar-state: 1;
    in property <string> detail-description: "";
    in property <[string]> detail-tags: [];
    in property <string> detail-posted: "";
    in property <int> detail-kind: 0;
    in property <int> detail-page-count: 1;
    in property <int> detail-views: 0;
    in property <int> detail-bookmarks: 0;
    in property <int> detail-likes: 0;
    in property <bool> detail-bookmarked: false;
    in property <bool> detail-following: false;
    in property <bool> detail-busy: false;
    in property <string> detail-ugoira-hint: "";
    in-out property <float> detail-zoom: 1.0;
    in-out property <length> detail-pan-x: 0px;
    in-out property <length> detail-pan-y: 0px;
    in property <bool> detail-fit-mode: true;

    // ---- downloads ----
    in property <[DownloadRow]> download-rows: [];
    in property <int> downloads-active: 0;
    in property <int> downloads-done: 0;
    in property <int> downloads-failed: 0;
    in property <string> download-directory: "";
    in property <string> download-template: "";
    in-out property <string> template-input: "";

    // ---- settings ----
    in property <string> cache-summary: "";
    in property <int> cache-memory-mb: 192;
    in property <int> cache-disk-mb: 1024;
    in property <string> app-version: "0.1.0";
    in property <bool> busy: false;
    in property <string> notice: "";
    in property <int> notice-kind: 0;
    in-out property <string> cookie-input: "";

    // ---- navigation / shell ----
    callback navigate(Destination);
    callback go-back();
    callback go-forward();
    callback search-submitted(string);
    /// The text changed; Rust debounces and asks Pixiv for candidates.
    callback search-edited(string);
    /// A suggestion row was chosen; the argument is the tag to search.
    callback suggest-chosen(string);
    callback suggest-dismissed();
    /// Up / Down pressed inside the search box.
    callback suggest-key(string);
    callback select-theme-mode(ThemeMode);
    callback toggle-theme();
    callback shell-shortcut(string);

    // ---- artwork feed ----
    callback open-illust(string);
    callback open-author(string);
    /// Author link on a *card*, which carries the work id rather than the user id
    /// so the profile can be opened without a lookup.
    callback open-card-author(string);
    callback open-profile(string);
    callback toggle-bookmark(string);
    callback open-tag(string);
    callback grid-measured(length);
    callback grid-scrolled(length);
    callback grid-retry();
    callback grid-action();
    callback load-more();
    callback select-ranking-filter(int);

    // ---- detail ----
    callback detail-back();
    callback detail-toggle-bookmark();
    callback detail-open-author();
    callback detail-open-tag(string);
    callback detail-download-page();
    callback detail-download-all();
    callback detail-export-ugoira();
    callback detail-open-external();
    callback detail-follow();
    callback detail-retry();
    callback detail-select-page(int);
    callback detail-request-zoom(float, float, float, float, float);
    callback detail-request-pan(float, float);
    callback detail-request-toggle-zoom(float, float);
    callback detail-reload-image();
    callback detail-set-fit-mode(bool);
    callback detail-set-zoom(float);
    callback toggle-fullscreen();

    // ---- downloads ----
    callback download-cancel(int);
    callback download-retry(int);
    callback download-retry-all();
    callback download-clear-finished();
    callback download-choose-directory();
    callback download-open-folder();
    callback download-open-task(int);

    // ---- settings ----
    callback sign-in-browser();
    callback submit-cookie();
    callback sign-out();
    callback clear-cache();
    callback clear-history();
    callback clear-downloads();
    callback choose-directory();
    callback apply-template(string);
    callback toggle-demo(bool);
    callback open-data-folder();
    callback open-project();
    callback dismiss-notice();

    // ---- profile page ----
    callback profile-back();
    callback profile-refresh();
    callback profile-retry();
    callback profile-follow();
    callback profile-load-more();



    out property <bool> is-gallery-page:
        root.page == Destination.Discovery || root.page == Destination.Ranking
        || root.page == Destination.Search || root.page == Destination.Bookmarks
        || root.page == Destination.History;

    // Diagnostics: the sizes the shell actually resolved to. Used by the DPI
    // verification trace and by the capture harness.
    out property <length> shell-height: shell.height;
    out property <length> body-height: body-row.height;
    out property <length> status-y: status-row.y;
    out property <length> status-height: status-row.height;

    out property <length> measured-width: 0px;

    /// Fired when the window size changes. Slint has no resize event, so the
    /// property change *is* the event; Rust then owns the narrow/compact decision
    /// and pushes `narrow` back. No timer, no polling, no second opinion.
    callback width-changed(length);
    changed width => {
        root.width-changed(root.width);
    }

    // Keyboard navigation of the rail. A `NavItem` cannot know its neighbours — it
    // is one shared component instantiated eight times — so Up/Down inside an
    // entry reports the delta here, where the rail's order is actually declared.
    // The wrap is two comparisons, not `%`: Slint has no modulo operator
    // (`Math.mod` is float-only) and a function body has no local variables, so an
    // index arithmetic one-liner is the only shape that compiles.
    public function move-nav-focus(from: int, delta: int) {
        root.focus-nav-step(from + delta);
    }

    public function focus-nav-step(index: int) {
        if (index < 0) { nav-settings.take-focus(); }
        else if (index > 7) { nav-home.take-focus(); }
        else { root.focus-nav-item(index); }
    }

    public function focus-nav-item(index: int) {
        if (index == 0) { nav-home.take-focus(); }
        else if (index == 1) { nav-discovery.take-focus(); }
        else if (index == 2) { nav-ranking.take-focus(); }
        else if (index == 3) { nav-search.take-focus(); }
        else if (index == 4) { nav-bookmarks.take-focus(); }
        else if (index == 5) { nav-history.take-focus(); }
        else if (index == 6) { nav-downloads.take-focus(); }
        else { nav-settings.take-focus(); }
    }

    init => {
        shortcuts.focus();
    }

    // A FocusScope is not a Rectangle: `width/height: 100%` inside one resolves
    // against its *content* size, so nesting the shell in a scope sized with a
    // percentage collapses it to `preferred-height` and leaves the rest of the
    // window unpainted. Sizing it from the window properties is what makes the
    // shell fill the frame at every DPI.
    shortcuts := FocusScope {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;

        // Key names in Slint are *character codes*, not English words: `e.text` for
        // the left arrow is U+F702 and for F11 is U+F70E. Comparing against
        // "LeftArrow" or "F11" compiles, reads correctly, and never matches - which
        // is exactly what had happened, so Alt+Left/Right and F11 had never worked
        // despite being documented. The escapes below are the documented values
        // from `i-slint-common`'s key table; `uiaudit` fails the build if a
        // multi-character key name reappears here.
        key-pressed(e) => {
            if (e.modifiers.control && (e.text == "f" || e.text == "k")) {
                search-field.focus-input();
                return EventResult.accept;
            }
            if (e.modifiers.alt && e.text == "\u{F702}") { root.go-back(); return EventResult.accept; }
            if (e.modifiers.alt && e.text == "\u{F703}") { root.go-forward(); return EventResult.accept; }
            if (e.modifiers.control && e.text == "r") { root.grid-retry(); return EventResult.accept; }
            if (e.text == "\u{F70E}") { root.toggle-fullscreen(); return EventResult.accept; }
            if (e.text == "\u{001b}") {
                // Escape closes the suggestion panel before it means anything
                // else: that is what the key does in every search field.
                if (root.suggest-visible) {
                    root.suggest-dismissed();
                } else {
                    root.shell-shortcut("escape");
                }
                return EventResult.accept;
            }
            if (e.modifiers.control && e.text == "1") { root.navigate(Destination.Home); return EventResult.accept; }
            if (e.modifiers.control && e.text == "2") { root.navigate(Destination.Discovery); return EventResult.accept; }
            if (e.modifiers.control && e.text == "3") { root.navigate(Destination.Ranking); return EventResult.accept; }
            if (e.modifiers.control && e.text == "4") { root.navigate(Destination.Bookmarks); return EventResult.accept; }
            if (e.modifiers.control && e.text == "5") { root.navigate(Destination.History); return EventResult.accept; }
            if (e.modifiers.control && e.text == "6") { root.navigate(Destination.Downloads); return EventResult.accept; }
            if (e.modifiers.control && (e.text == "," || e.text == "7")) {
                root.navigate(Destination.Settings);
                return EventResult.accept;
            }
            EventResult.reject
        }

        shell := VerticalLayout {
            width: 100%;
            height: 100%;

            // ================= top command bar =================
            Rectangle {
                height: Theme.topbar-height;
                background: Theme.chrome;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-2;
                    spacing: Theme.space-1;

                    // Wordmark: a Pixiv-blue tile with the brand letter. Not a
                    // fake button — it does not respond to the pointer. Wrapped in a
                    // full-height cell because a fixed-height child of this row
                    // would otherwise be top-aligned.
                    Rectangle {
                        width: 28px;
                        height: 100%;
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            y: (parent.height - self.height) / 2;
                            border-radius: Theme.radius-md;
                            background: Theme.accent-fill;
                            Text {
                                text: "P";
                                color: Theme.on-accent;
                                font-size: Theme.font-title;
                                font-weight: Type.bold;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle { width: Theme.space-1; }

                    back-button := IconButton {
                        icon: "back";
                        tip: "后退 (Alt+←)";
                        enabled: root.can-go-back;
                        row-height: Theme.topbar-height;
                        tip-placement: TipPlacement.Below;
                        clicked => { root.go-back(); }
                    }
                    IconButton {
                        icon: "forward";
                        tip: "前进 (Alt+→)";
                        enabled: root.can-go-forward;
                        row-height: Theme.topbar-height;
                        tip-placement: TipPlacement.Below;
                        clicked => { root.go-forward(); }
                    }

                    search-host := Rectangle {
                        horizontal-stretch: 1;
                        height: Theme.topbar-height;
                        min-width: 120px;

                        search-field := TextField {
                            height: Theme.control-height;
                            y: (parent.height - self.height) / 2;
                            placeholder: "搜索插画、漫画、动图或标签…  (Ctrl+F)";
                            leading-icon: "search";
                            text <=> root.search-text;
                            edited(t) => { root.search-edited(t); }
                            navigate-keys(k) => { root.suggest-key(k); }
                            accepted(t) => { root.search-submitted(t); }
                        }
                    }

                    // No demo badge here. The status bar already reports the data
                    // source on every page, and the home hero explains it once; a
                    // third marker 40px away from the second is the kind of
                    // duplication that makes the chrome feel busy for no gain.

                    IconButton {
                        icon: root.dark ? "light" : "dark";
                        tip: root.dark ? "切换到浅色主题" : "切换到深色主题";
                        row-height: Theme.topbar-height;
                        tip-placement: TipPlacement.Below;
                        clicked => { root.toggle-theme(); }
                    }

                    // Account affordance. The avatar is the account's real
                    // image; a letter in a coloured circle is not an avatar and
                    // read as one for a whole release.
                    Rectangle {
                        width: 28px;
                        height: 100%;

                        Avatar {
                            width: 28px;
                            height: 28px;
                            y: (parent.height - self.height) / 2;
                            size: 28px;
                            source: root.account-avatar;
                            state: root.authenticated ? root.account-avatar-state : 2;
                            fallback: root.authenticated
                                ? (root.session-user == "" ? "已" : root.session-user)
                                : "登";
                        }

                        avatar-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                // Signed in: your own page. Otherwise the only
                                // useful destination is the sign-in flow.
                                if (root.authenticated) {
                                    root.open-profile("");
                                } else {
                                    root.navigate(Destination.Settings);
                                }
                            }
                        }
                        // Published, not drawn here: `y: Theme.topbar-height + 6px`
                        // put this bubble under the page, which is painted after
                        // the command bar and owns an opaque background.
                        property <bool> hovering: avatar-area.has-hover;
                        changed hovering => {
                            if (hovering) {
                                Tip.text = root.authenticated
                                    ? "我的主页（登录管理在设置里）"
                                    : "未登录，点击前往设置";
                                Tip.side = TipSide.Below;
                                Tip.anchor-x = avatar-area.absolute-position.x
                                    + avatar-area.width / 2;
                                Tip.anchor-y = avatar-area.absolute-position.y
                                    + avatar-area.height;
                                Tip.visible = true;
                            } else {
                                Tip.visible = false;
                            }
                        }
                    }
                }
            }

            // ================= body =================
            body-row := HorizontalLayout {
                // Height is *derived from the window*, not negotiated with the
                // layout system. Slint walks constraints up from content: this row
                // contains the navigation column, whose preferred height is the sum
                // of its fixed rows. That becomes the row's implicit max-height, so
                // `vertical-stretch: 1` cannot grow it — the layout keeps the row at
                // its content height, parks the status bar right under it and leaves
                // every pixel below unpainted. Stating the height as "window minus
                // the two fixed bars" is exact, monotone in the window height, and
                // leaves no leftover for a stretch rule to get wrong.
                height: root.height - Theme.topbar-height - Theme.statusbar-height;
                spacing: 0px;

                // ---- NavigationView pane ----
                Rectangle {
                    width: root.rail-compact ? Theme.rail-width-compact : Theme.rail-width;
                    background: Theme.chrome;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;

                    VerticalLayout {
                        padding-top: Theme.space-2;
                        padding-bottom: Theme.space-2;
                        padding-left: Theme.space-2;
                        padding-right: Theme.space-2;
                        spacing: 2px;

                        nav-home := NavItem {
                            icon: "home"; label: "首页"; compact: root.rail-compact;
                            selected: root.page == Destination.Home;
                            clicked => { root.navigate(Destination.Home); }
                            move-focus(d) => { root.move-nav-focus(0, d); }
                        }
                        nav-discovery := NavItem {
                            icon: "discover"; label: "发现"; compact: root.rail-compact;
                            selected: root.page == Destination.Discovery;
                            clicked => { root.navigate(Destination.Discovery); }
                            move-focus(d) => { root.move-nav-focus(1, d); }
                        }
                        nav-ranking := NavItem {
                            icon: "ranking"; label: "排行榜"; compact: root.rail-compact;
                            selected: root.page == Destination.Ranking;
                            clicked => { root.navigate(Destination.Ranking); }
                            move-focus(d) => { root.move-nav-focus(2, d); }
                        }
                        nav-search := NavItem {
                            icon: "search"; label: "搜索"; compact: root.rail-compact;
                            selected: root.page == Destination.Search;
                            clicked => { root.navigate(Destination.Search); }
                            move-focus(d) => { root.move-nav-focus(3, d); }
                        }
                        nav-bookmarks := NavItem {
                            icon: "star"; label: "收藏"; compact: root.rail-compact;
                            selected: root.page == Destination.Bookmarks;
                            clicked => { root.navigate(Destination.Bookmarks); }
                            move-focus(d) => { root.move-nav-focus(4, d); }
                        }
                        nav-history := NavItem {
                            icon: "history"; label: "浏览历史"; compact: root.rail-compact;
                            selected: root.page == Destination.History;
                            clicked => { root.navigate(Destination.History); }
                            move-focus(d) => { root.move-nav-focus(5, d); }
                        }
                        nav-downloads := NavItem {
                            icon: "downloads"; label: "下载管理"; compact: root.rail-compact;
                            selected: root.page == Destination.Downloads;
                            badge: root.downloads-active;
                            clicked => { root.navigate(Destination.Downloads); }
                            move-focus(d) => { root.move-nav-focus(6, d); }
                        }

                        Rectangle { vertical-stretch: 1; }

                        Divider { }
                        nav-settings := NavItem {
                            icon: "settings"; label: "设置"; compact: root.rail-compact;
                            selected: root.page == Destination.Settings;
                            clicked => { root.navigate(Destination.Settings); }
                            move-focus(d) => { root.move-nav-focus(7, d); }
                        }
                        // Hidden while the host has auto-compacted the pane: at that
                        // size the toggle cannot change anything, and a control that
                        // does nothing is worse than no control.
                        if !root.narrow : NavItem {
                            icon: root.rail-collapsed ? "chevron-right" : "chevron-left";
                            label: root.rail-collapsed ? "展开侧栏" : "收起侧栏";
                            compact: root.rail-compact;
                            clicked => { root.rail-collapsed = !root.rail-collapsed; }
                        }
                    }
                }

                // ---- page router ----
                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.canvas;
                    clip: true;

                    home-page := HomePage {
                        width: parent.width;
                        height: parent.height;
                        visible: root.page == Destination.Home;
                        columns: root.grid-columns;
                        card-width: root.grid-card-width;
                        count-label: root.grid-count-label;
                        demo-mode: root.demo-mode;
                        loading-more: root.grid-loading-more;
                        scroll-y <=> root.home-scroll-y;

                        feed-state: root.home-feed-state;
                        feed-message: root.home-feed-message;
                        source-note: root.home-source-note;
                        recommend-tags: root.home-tags;
                        tags-state: root.home-tags-state;
                        tags-message: root.home-tags-message;
                        latest: root.home-latest;
                        latest-title: root.home-latest-title;
                        latest-state: root.home-latest-state;
                        latest-message: root.home-latest-message;
                        artists: root.home-artists;
                        artists-state: root.home-artists-state;
                        artists-message: root.home-artists-message;

                        measured(w) => { root.grid-measured(w); }
                        open-illust(id) => { root.open-illust(id); }
                        open-author(id) => { root.open-author(id); }
                        open-recommend-user(id) => { root.open-profile(id); }
                        toggle-bookmark(id) => { root.toggle-bookmark(id); }
                        open-tag(t) => { root.open-tag(t); }
                        refresh => { root.grid-retry(); }
                        retry => { root.grid-retry(); }
                        action => { root.grid-action(); }
                        load-more => { root.load-more(); }
                    }

                    gallery := GalleryPage {
                        width: parent.width;
                        height: parent.height;
                        visible: root.is-gallery-page;
                        columns: root.grid-columns;
                        card-width: root.grid-card-width;
                        state: root.grid-state;
                        title: root.page == Destination.Discovery ? "发现"
                            : root.page == Destination.Ranking ? "排行榜"
                            : root.page == Destination.Search
                                ? (root.search-word == "" ? "搜索" : "搜索：" + root.search-word)
                            : root.page == Destination.Bookmarks ? "收藏"
                            : "浏览历史";
                        subtitle: root.page == Destination.Discovery
                            ? "Pixiv 推荐引擎与推荐画师，与排行榜无关"
                            : root.page == Destination.Ranking ? "Pixiv 官方榜单，可切换统计周期"
                            : root.page == Destination.Search ? "按关键词查找作品，回车提交"
                            : root.page == Destination.Bookmarks ? "你收藏的作品（需要登录）"
                            : "本机记录过的作品";
                        message: root.grid-message;
                        state-title: root.grid-state-title;
                        state-glyph: root.grid-state-glyph;
                        action-label: root.grid-action-label;
                        tags: root.grid-tags;
                        active-tag: root.grid-active-tag;
                        count-label: root.grid-count-label;
                        recent-searches: root.page == Destination.Search ? root.recent-searches : [];
                        recommend-users: root.page == Destination.Discovery ? root.discovery-users : [];
                        recommend-users-state: root.discovery-users-state;
                        recommend-users-message: root.discovery-users-message;
                        open-user(id) => { root.open-profile(id); }
                        filters: root.page == Destination.Ranking ? root.ranking-filters : [];
                        active-filter: root.page == Destination.Ranking ? root.ranking-filter : -1;
                        loading-more: root.grid-loading-more;
                        scroll-y <=> root.grid-scroll-y;
                        measured(w) => { root.grid-measured(w); }
                        open-illust(id) => { root.open-illust(id); }
                        open-author(id) => { root.open-author(id); }
                        toggle-bookmark(id) => { root.toggle-bookmark(id); }
                        open-tag(t) => { root.open-tag(t); }
                        select-filter(i) => { root.select-ranking-filter(i); }
                        retry => { root.grid-retry(); }
                        action => { root.grid-action(); }
                        load-more => { root.load-more(); }
                        pick-search(w) => { root.search-submitted(w); }
                    }

                    ProfilePage {
                        width: parent.width;
                        height: parent.height;
                        visible: root.page == Destination.UserProfile;
                        user-name: root.profile-name;
                        user-account: root.profile-account;
                        user-id: root.profile-uid;
                        user-comment: root.profile-comment;
                        webpage: root.profile-webpage;
                        avatar: root.profile-avatar;
                        avatar-state: root.profile-avatar-state;
                        cover: root.profile-background;
                        premium: root.profile-premium;
                        self: root.profile-self;
                        wide: root.profile-wide;
                        stats: root.profile-stats;
                        followed: root.profile-followed;
                        busy: root.profile-busy;
                        columns: root.grid-columns;
                        card-width: root.grid-card-width;
                        state: root.profile-state;
                        message: root.profile-message;
                        loading-more: root.grid-loading-more;
                        count-label: root.profile-count-label;
                        scroll-y <=> root.grid-scroll-y;
                        measured(w) => { root.grid-measured(w); }
                        back => { root.profile-back(); }
                        refresh => { root.profile-refresh(); }
                        retry => { root.profile-retry(); }
                        toggle-follow => { root.profile-follow(); }
                        open-illust(id) => { root.open-illust(id); }
                        open-author(id) => { root.open-author(id); }
                        toggle-bookmark(id) => { root.toggle-bookmark(id); }
                        open-external => { root.shell-shortcut("open-external"); }
                        load-more => { root.profile-load-more(); }
                    }

                    DetailPage {
                        width: parent.width;
                        height: parent.height;
                        visible: root.page == Destination.Detail;
                        available-width: root.content-width;
                        title: root.detail-title;
                        author: root.detail-author;
                        author-id: root.detail-author-id;
                        author-avatar: root.detail-author-avatar;
                        author-avatar-state: root.detail-author-avatar-state;
                        description: root.detail-description;
                        tags: root.detail-tags;
                        posted: root.detail-posted;
                        kind: root.detail-kind;
                        page-count: root.detail-page-count;
                        views: root.detail-views;
                        bookmarks: root.detail-bookmarks;
                        likes: root.detail-likes;
                        bookmarked: root.detail-bookmarked;
                        authenticated: root.authenticated;
                        following: root.detail-following;
                        busy: root.detail-busy;
                        ugoira-hint: root.detail-ugoira-hint;
                        state: root.detail-state;
                        message: root.detail-message;
                        pages: root.detail-pages;
                        current-page <=> root.detail-page-index;
                        zoom <=> root.detail-zoom;
                        pan-x <=> root.detail-pan-x;
                        pan-y <=> root.detail-pan-y;
                        fit-mode: root.detail-fit-mode;
                        back => { root.detail-back(); }
                        toggle-bookmark => { root.detail-toggle-bookmark(); }
                        open-author => { root.detail-open-author(); }
                        open-tag(t) => { root.detail-open-tag(t); }
                        download-page => { root.detail-download-page(); }
                        download-all => { root.detail-download-all(); }
                        export-ugoira => { root.detail-export-ugoira(); }
                        open-external => { root.detail-open-external(); }
                        follow => { root.detail-follow(); }
                        retry => { root.detail-retry(); }
                        select-page(i) => { root.detail-select-page(i); }
                        request-zoom(px, py, dy, w, h) => { root.detail-request-zoom(px, py, dy, w, h); }
                        request-pan(dx, dy) => { root.detail-request-pan(dx, dy); }
                        request-toggle-zoom(px, py) => { root.detail-request-toggle-zoom(px, py); }
                        reload-image => { root.detail-reload-image(); }
                        set-fit-mode(m) => { root.detail-set-fit-mode(m); }
                        set-zoom(z) => { root.detail-set-zoom(z); }
                        toggle-fullscreen => { root.toggle-fullscreen(); }
                    }

                    DownloadsPage {
                        width: parent.width;
                        height: parent.height;
                        visible: root.page == Destination.Downloads;
                        rows: root.download-rows;
                        active-count: root.downloads-active;
                        done-count: root.downloads-done;
                        failed-count: root.downloads-failed;
                        directory: root.download-directory;
                        template-text: root.download-template;
                        cancel(id) => { root.download-cancel(id); }
                        retry(id) => { root.download-retry(id); }
                        retry-all => { root.download-retry-all(); }
                        clear-finished => { root.download-clear-finished(); }
                        choose-directory => { root.download-choose-directory(); }
                        open-folder => { root.download-open-folder(); }
                        open-task(id) => { root.download-open-task(id); }
                    }

                    SettingsPage {
                        width: parent.width;
                        height: parent.height;
                        visible: root.page == Destination.Settings;

                        authenticated: root.authenticated;
                        busy: root.busy;
                        session-user: root.session-user;
                        cookie-input <=> root.cookie-input;
                        cache-summary: root.cache-summary;
                        memory-mb: root.cache-memory-mb;
                        disk-mb: root.cache-disk-mb;
                        download-directory: root.download-directory;
                        template-input <=> root.template-input;
                        demo-mode: root.demo-mode;
                        app-version: root.app-version;
                        select-theme-mode(m) => { root.select-theme-mode(m); }
                        sign-in-browser => { root.sign-in-browser(); }
                        submit-cookie => { root.submit-cookie(); }
                        sign-out => { root.sign-out(); }
                        clear-cache => { root.clear-cache(); }
                        clear-history => { root.clear-history(); }
                        clear-downloads => { root.clear-downloads(); }
                        choose-directory => { root.choose-directory(); }
                        apply-template(t) => { root.apply-template(t); }
                        toggle-demo(v) => { root.toggle-demo(v); }
                        open-data-folder => { root.open-data-folder(); }
                        open-project => { root.open-project(); }
                    }

                    // ---- floating notification ----
                    // An overlay anchored to the bottom of the content area, not a
                    // row in the shell layout: as a row it pushed the status bar out
                    // of a 480px-tall window. As an overlay it is visible on every
                    // page and steals no layout space.
                    if root.notice != "" : Rectangle {
                        x: Theme.space-4;
                        // Literal height rather than `self.height`: a self-referencing
                        // binding in `y` resolves against height 0 and puts the bar
                        // outside the clip.
                        y: parent.height - 44px - Theme.space-4;
                        width: parent.width - Theme.space-4 * 2;
                        height: 44px;
                        border-radius: Theme.radius-md;
                        background: root.notice-kind == 3 ? Theme.danger-subtle
                            : root.notice-kind == 2 ? Theme.warning-subtle
                            : root.notice-kind == 1 ? Theme.success-subtle
                            : Theme.accent-subtle;
                        border-width: 1px;
                        border-color: root.notice-kind == 3 ? Theme.danger
                            : root.notice-kind == 2 ? Theme.warning
                            : root.notice-kind == 1 ? Theme.success
                            : Theme.border;
                        drop-shadow-blur: 10px;
                        drop-shadow-color: Theme.shadow-2;
                        drop-shadow-offset-y: 2px;

                        HorizontalLayout {
                            padding-left: Theme.space-3;
                            padding-right: Theme.space-2;
                            spacing: Theme.space-2;

                            IconSlot {
                                name: root.notice-kind == 3 ? "warning"
                                    : root.notice-kind == 2 ? "warning"
                                    : root.notice-kind == 1 ? "check"
                                    : "info";
                                slot: Theme.icon-size;
                                tint: root.notice-kind == 3 ? Theme.danger
                                    : root.notice-kind == 2 ? Theme.warning
                                    : root.notice-kind == 1 ? Theme.success
                                    : Theme.accent-ink;
                            }

                            Text {
                                text: root.notice;
                                color: Theme.text;
                                font-size: Theme.font-small;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            IconButton {
                                icon: "dismiss";
                                size: 24px;
                                tip: "关闭";
                                row-height: 44px;
                                clicked => { root.dismiss-notice(); }
                            }
                        }
                    }
                }
            }

            // ================= status bar =================
            // The shell owns connection state; pages supply the one page-specific
            // fact through `status-text`. Anything more is the duplication that used
            // to repeat "演示模式（本地数据）" three times on one screen.
            status-row := Rectangle {
                height: Theme.statusbar-height;
                background: Theme.chrome;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding-left: Theme.space-3;
                    padding-right: Theme.space-3;
                    spacing: Theme.space-2;

                    Text {
                        text: root.status-text;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-caption;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    Rectangle {
                        width: 6px;
                        height: 100%;
                        Rectangle {
                            width: 6px;
                            height: 6px;
                            y: (parent.height - self.height) / 2;
                            border-radius: Theme.radius-pill;
                            background: root.demo-mode ? Theme.warning
                                : (root.authenticated ? Theme.success : Theme.text-tertiary);
                        }
                    }

                    Text {
                        text: root.demo-mode ? "演示模式"
                            : (root.authenticated ? "已登录" : "未登录 · 只读");
                        color: root.demo-mode ? Theme.warning
                            : (root.authenticated ? Theme.text-secondary : Theme.text-tertiary);
                        font-size: Theme.font-caption;
                        vertical-alignment: center;
                    }
                }
            }
        }

    // ================= tooltips =================
    // One bubble for the whole window, declared after the shell so nothing a
    // page paints can cover it and no ancestor `clip` can eat it. Controls
    // publish text plus an anchor to the `Tip` global; this is the only
    // `HoverTip` instance in the app (`uiaudit` fails the build otherwise).
    //
    // It sits before the suggestion panel on purpose: a dropdown the user just
    // opened outranks a 24px hint about the control behind it.
    // `changed` only accepts a bare property of the enclosing element, so the
    // "drop the bubble when the page changes" reset cannot live here; `App::go`
    // clears it on the Rust side, which also covers a control that disappears
    // while it is hovered (a cancelled download row, a reloaded feed).

    tip-host := HoverTip {
        // `debug-tip` is a binding, not a write to the global: the anchor has to
        // come from a real control, and `absolute-position` is only meaningful
        // once layout has run, which a binding survives and an `init` does not.
        show: (Tip.visible && Tip.text != "") || root.debug-tip;
        tip: root.debug-tip ? "后退 (Alt+←)" : Tip.text;
        side: root.debug-tip ? TipSide.Below : Tip.side;
        anchor-x: root.debug-tip
            ? back-button.absolute-position.x + back-button.width / 2
            : Tip.anchor-x;
        anchor-y: root.debug-tip
            ? back-button.absolute-position.y + back-button.height
            : Tip.anchor-y;
        window-width: root.width;
        window-height: root.height;
    }

    // ================= search suggestions =================
    // Declared as a sibling of the whole shell, not inside the command bar:
    // a child of the top bar is painted before the page content, so the page's
    // own background would cover the dropdown. Anchored to the search field's
    // absolute position so it stays under the box at every window size.
    if root.suggest-visible : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: transparent;

        // Click-outside-to-close, declared before the panel so the panel wins
        // the hit test on its own area.
        scrim := TouchArea {
            clicked => { root.suggest-dismissed(); }
        }
    }

    if root.suggest-visible : Rectangle {
        x: search-host.absolute-position.x;
        y: search-host.absolute-position.y + search-host.height - 2px;
        width: max(240px, search-host.width);
        height: min(392px, panel-body.preferred-height + 10px);
        border-radius: Theme.radius-md;
        background: Theme.layer;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 20px;
        drop-shadow-color: Theme.shadow-2;
        drop-shadow-offset-y: 6px;
        clip: true;

        panel-body := VerticalLayout {
            padding-top: 5px;
            padding-bottom: 5px;
            spacing: 0px;

            if root.suggestions.length == 0 : Text {
                height: 40px;
                text: root.suggest-note;
                color: Theme.text-tertiary;
                font-size: Theme.font-small;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }

            for s in root.suggestions : SuggestRow {
                item: s;
                choose => { root.suggest-chosen(s.tag); }
            }

            if root.suggestions.length > 0 && root.suggest-note != "" : Text {
                height: 20px;
                x: Theme.space-3;
                width: max(0px, parent.width - Theme.space-3 * 2);
                text: root.suggest-note;
                color: Theme.text-tertiary;
                font-size: Theme.font-caption;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
    }
}