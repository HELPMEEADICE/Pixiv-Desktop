// Design tokens for Pixiv Desktop.
//
// Visual brief: 70% Windows 11 / WinUI 3 desktop chrome + 30% Pixiv's
// artwork-browsing experience. Concretely:
//   * WinUI 3 supplies the navigation system, control metrics (32px controls,
//     4px control radius / 8px card radius), layered neutral surfaces, 1px
//     low-contrast strokes, the Light/Dark/System theme triad and the type ramp;
//   * Pixiv supplies its blue accent, the artwork-first density and the tag
//     chips — nothing else. It is not a web wrapper with a native frame.
//
// Rules this file exists to enforce:
//   * No page hard-codes a colour, radius, spacing or control size.
//   * Theme is a three-state choice (`ThemeMode`), never a bare boolean, so
//     "follow the system" is a real mode instead of a toggle that does nothing.
//   * Every length that two files must agree on (card width bounds, scrollbar
//     gutter, caption height, nav item height) is defined here *once* and mirrored
//     by the Rust layout model in `src/layout.rs`.

/// Light / dark choice. `System` follows the Windows "app mode" setting.
export enum ThemeMode {
    System,
    Light,
    Dark,
}

export global Theme {
    /// User's explicit choice, persisted to SQLite and pushed in by Rust.
    in-out property <ThemeMode> mode: ThemeMode.System;
    /// The OS's app-mode preference, read from the registry by Rust. Meaningful
    /// only while `mode == System`; kept as an input so the shell stays a pure
    /// function of its properties.
    in-out property <bool> system-dark: false;

    /// Single source of truth for every colour choice in the app.
    out property <bool> dark:
        mode == ThemeMode.Dark || (mode == ThemeMode.System && system-dark);

    // ---- brand ---------------------------------------------------------
    // Pixiv's signature blue, used for *decoration*: glyphs on neutral
    // surfaces, selection indicators, progress fills. Measured contrast is in
    // the doc comment of `accent-fill` below, because using this one as a fill
    // behind text is what made primary buttons unreadable.
    out property <color> accent: dark ? #4cb0f5 : #0096fa;
    // ~10% accent wash for selection, chips and informational banners.
    out property <color> accent-subtle: dark ? #1d3b4f : #e6f4ff;

    // Filled surfaces (primary button, checked toggle) and the ink on them.
    //
    // `accent` cannot be used as a background for white text: #0096fa measures
    // 3.11:1 against white, under the 4.5:1 WCAG AA bar, and the lifted dark
    // variant is worse on the light side (2.38:1). WinUI solves this by keeping
    // the accent as decoration and giving the filled control its own shade, so
    // `accent-fill` is the darker light-mode blue (5.07:1 with white) and, in
    // dark mode, a light blue that carries *dark* ink (8.01:1).
    out property <color> accent-fill: dark ? #4cb0f5 : #0071c2;
    out property <color> accent-fill-hover: dark ? #63bcf7 : #0069b4;
    out property <color> accent-fill-pressed: dark ? #3d96d0 : #005a99;
    out property <color> on-accent: dark ? #101010 : #ffffff;
    // Legible accent for text and glyphs drawn on the accent-subtle wash;
    // `accent` itself only reaches 2.78:1 there and is a decoration colour.
    out property <color> accent-ink: dark ? #a8d8fa : #0a6fb5;

    // ---- surfaces ------------------------------------------------------
    // `canvas` is the page floor (Win11 #f3f3f3 / #202020); `layer` is a card;
    // `chrome` is the top bar / navigation rail; `flyout` floats above all.
    out property <color> canvas: dark ? #202020 : #f3f3f3;
    out property <color> layer: dark ? #2b2b2b : #ffffff;
    out property <color> layer-alt: dark ? #323232 : #f7f8f9;
    out property <color> layer-sunken: dark ? #1a1a1a : #ececee;
    out property <color> chrome: dark ? #272727 : #f3f3f3;
    out property <color> flyout: dark ? #2f2f2f : #fbfbfb;

    // ---- strokes -------------------------------------------------------
    // Fluent leans on 1px strokes instead of heavy borders or drop shadows.
    out property <color> border: dark ? #3d3d3d : #e3e3e3;
    out property <color> border-strong: dark ? #4f4f4f : #cfcfcf;

    // ---- text ----------------------------------------------------------
    out property <color> text: dark ? #ffffff : #1a1a1a;
    out property <color> text-secondary: dark ? #c5c5c5 : #5d5d5d;
    // Hint text. #8a8a8a measured only 3.25:1 on `layer-alt`, so the light value
    // is darker than the WinUI default; the dark value carries more headroom
    // than the light one because dark surfaces compress the usable range.
    out property <color> text-tertiary: dark ? #a8a8a8 : #6e6e6e;
    out property <color> text-disabled: dark ? #5c5c5c : #b3b3b3;

    // ---- semantic state ------------------------------------------------
    out property <color> danger: dark ? #ff99a4 : #c42b1c;
    out property <color> danger-subtle: dark ? #42201f : #fdebe9;
    out property <color> success: dark ? #6ccf8a : #0f7b0f;
    out property <color> success-subtle: dark ? #1b3226 : #e9f6ec;
    out property <color> warning: dark ? #f0b429 : #9d5d00;
    out property <color> warning-subtle: dark ? #3d2f10 : #fff4ce;

    // Transparent overlays for hover/press so nothing ever resizes on hover.
    out property <color> hover: dark ? #ffffff14 : #0000000a;
    out property <color> pressed: dark ? #ffffff1f : #00000014;
    out property <color> focus-ring: dark ? #7ac0f0 : #0a84d8;

    // ---- inverted surfaces ---------------------------------------------
    // A tooltip is deliberately the inverse of the surface under it (WinUI does
    // the same), so it cannot be expressed as a light/dark pair of the normal
    // neutrals: in dark mode the tip is light with dark ink.
    out property <color> tip-surface: dark ? #f0f0f0 : #2b2b2b;
    out property <color> tip-ink: dark ? #1a1a1a : #ffffff;
    out property <color> tip-border: dark ? #3d3d3d : transparent;
    /// Backdrop of the image viewer, behind the artwork on both axes.
    out property <color> viewer-surface: dark ? #101012 : #e8eaed;
    /// Floating control bar over the artwork: translucent so the image reads through.
    out property <color> viewer-chrome: dark ? #1c1c20dd : #ffffffe8;
    // ---- elevation -----------------------------------------------------
    // Slint has no blur, so elevation is emulated with a low-alpha offset
    // rectangle behind flyouts (or `drop-shadow-*`, which blurs on the GPU
    // renderer only). Two steps only: cards stay flat.
    /// Scrim over a profile cover image. Fixed rather than themed: it is drawn
    /// on top of somebody's artwork, where the theme has no opinion.
    out property <color> cover-scrim-top: #00000026;
    out property <color> cover-scrim-bottom: #00000099;
    /// Hover veil, badge scrim and ink drawn directly on top of artwork. Fixed
    /// rather than themed for the same reason as the cover scrims above: the theme
    /// has no opinion about pixels it did not choose, so these cannot follow
    /// light/dark. They were literals in `components.slint` until round ten (U9):
    /// the style contract said the theme is the only place that may name a raw
    /// colour, and nothing enforced it, so six literals had accumulated there.
    out property <color> artwork-hover: #00000012;
    out property <color> artwork-scrim: #000000a6;
    out property <color> artwork-ink: #ffffff;
    /// The bookmark pill's surface, and the unmarked glyph it carries. Fixed for
    /// the same reason: the pill floats on artwork, and a surface that *can* equal
    /// the ink erases it (`Theme.layer` is #2b2b2b in dark mode, 1.00:1).
    out property <color> pill-surface: #ffffffd9;
    out property <color> pill-ink: #2b2b2b;
    /// Ink for the *marked* state of a control whose surface is a fixed near-white
    /// pill (the bookmark toggle). Also fixed, for the same reason the pill is: the
    /// pair floats on artwork. It cannot follow the theme, because `accent-fill` is
    /// #4cb0f5 in dark mode and measures 2.38:1 on that pill - the marked state was
    /// the one state nobody looked at. #0071c2 measures 5.07:1 on #ffffff, in both
    /// themes, and `bookmark_pill_keeps_its_glyph_visible` pins it.
    out property <color> pill-ink-marked: #0071c2;

    out property <color> shadow-2: dark ? #00000073 : #00000024;

    // ---- fixed geometry ------------------------------------------------
    out property <length> topbar-height: 48px;
    out property <length> rail-width: 232px;
    out property <length> rail-width-compact: 52px;
    out property <length> statusbar-height: 26px;
    /// Horizontal page inset. The gallery maths in `src/layout.rs` mirrors this.
    out property <length> page-padding: 20px;

    // ---- artwork grid --------------------------------------------------
    // These four values MUST stay in sync with the constants in `src/layout.rs`.
    // `grid_widths_match_the_layout_model` (uiaudit) reads both languages and fails
    // if the pair drifts; `ArtworkGrid.card-width` clamps to the two bounds, so no
    // page can hand the grid a width outside the band the balancer assumes.
    out property <length> card-min-width: 168px;
    out property <length> card-max-width: 300px;
    out property <length> card-gap: 16px;
    out property <length> card-caption-height: 44px;
    /// Width of a column reserved for the overlay scrollbar, so a card never
    /// sits underneath the thumb.
    out property <length> scrollbar-gutter: 10px;

    // ---- recommended-artist strip --------------------------------------
    // The artist band on 首页 and 发现: one tile 210 wide inside a 132-tall
    // strip that scrolls horizontally. Both numbers were literals in two pages
    // and in `UserCard`; they must stay equal (the tile is as tall as the strip
    // it sits in) so the strip cannot clip its own cards.
    out property <length> artist-card-width: 210px;
    out property <length> artist-strip-height: 132px;

    // ---- type ----------------------------------------------------------
    // WinUI 3's ramp, compressed for a dense browse client: the settings rows
    // and list rows WinUI draws at 14px stay at 14px, captions drop to 11 so a
    // card can carry a title and an author inside 44px.
    //
    // Font family note: the app sets `default-font-family` on the root window, so
    // every `Text` inherits it. "Segoe UI Variable Text" is Win11's UI face;
    // Windows falls back per-glyph for CJK, which keeps Chinese and Japanese
    // metrics correct without bundling a font.
    out property <string> font-family: "Segoe UI Variable Text";
    out property <length> font-caption: 11px;
    out property <length> font-small: 12px;
    out property <length> font-body: 14px;
    out property <length> font-subhead: 14px;
    out property <length> font-title: 16px;
    out property <length> font-page: 20px;
    out property <length> font-display: 24px;

    // Line-height factors, from Slint's `line-height-factor`.
    //
    // It is a multiple of the font's *natural* line height (ascent + descent), not
    // a CSS length, so 1.5 on 14px Segoe UI Variable is ~21px of leading and stays
    // proportional at every DPI. These exist because the app had no leading at all:
    // every wrapped paragraph was set solid at 1.0, which reads as cramped next to
    // WinUI's own body text and made the novel reader's line-spacing setting the
    // only place where line height was even expressible.
    //
    // Only wrapped text reads these. A single-line label keeps the natural factor
    // on purpose: a non-default `line-height-factor` moves a `Text` onto Slint's
    // complex-text path, and the feed draws ~200 single-line labels (card titles,
    // authors, counts) for every paragraph it draws.
    out property <float> line-small: 1.35;
    out property <float> line-body: 1.5;

    // ---- reading (novel reader) -----------------------------------------
    // The reader draws text at a size the *user* chose, so its ramp is separate from
    // the UI ramp above. These are the bounds the settings sliders clamp to and the
    // values the page recomputes from; the preference model in
    // `crates/pixiv-novel/src/prefs.rs` carries the same numbers, and
    // `reader_bounds_match_the_preference_model` (uiaudit) fails if they drift.
    /// The reading body's own default before the user's choice arrives.
    out property <length> reader-font-default: 19px;
    out property <length> reader-font-min: 14px;
    out property <length> reader-font-max: 32px;
    out property <length> reader-measure-min: 420px;
    out property <length> reader-measure-max: 1400px;
    /// Widest the settings panel is allowed to get before it reads as a dialog
    /// instead of a flyout.
    out property <length> reader-panel-width: 340px;
    /// Height of the reader's own toolbar (back, title, Aa, progress).
    out property <length> reader-bar-height: 44px;

    // ---- radii ---------------------------------------------------------
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 6px;
    out property <length> radius-lg: 8px;
    out property <length> radius-pill: 999px;

    // ---- spacing (4px grid) --------------------------------------------
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-5: 20px;
    out property <length> space-6: 24px;
    out property <length> space-8: 32px;

    // ---- controls ------------------------------------------------------
    out property <length> control-height: 32px;
    out property <length> control-height-sm: 26px;
    out property <length> control-height-lg: 36px;
    out property <length> icon-size: 16px;
    out property <length> icon-size-lg: 20px;
    /// NavigationView row metric. WinUI uses 36px for a standard-density pane.
    out property <length> nav-item-height: 36px;

    // ---- round nine (docs/OPTIMIZATION-PLAN-R9.md §4) -------------------
    // Declared here, once, before anything draws with them: the panel, its row
    // delegate, the menu and the accessibility walk all have to agree.
    /// Command palette (Ctrl+P). Windows Terminal's proportions: a 520px panel
    /// 88px below the body's top edge, a 40px query row, 36px result rows.
    out property <length> palette-width: 520px;
    out property <length> palette-min-width: 360px;
    out property <length> palette-offset-y: 88px;
    out property <length> palette-query-height: 40px;
    out property <length> palette-row-height: 36px;
    /// The check WinUI draws in a selected list item, and the ring around the
    /// card it belongs to.
    out property <length> select-check: 22px;
    out property <length> select-ring: 2px;
    /// SplitButton's chevron column, beside a 32px control (Fluent: 24px).
    out property <length> split-chevron: 24px;
    /// MenuFlyout metrics (Fluent: 32px rows, 200px minimum width).
    out property <length> menu-row-height: 32px;
    out property <length> menu-width: 200px;
    /// The menu's check column and the glyph inside it. Both were literals in
    /// `MenuRow` and both are read twice (the column that reserves the space and
    /// the slot that draws in it), so the pair lives here rather than in the row.
    out property <length> menu-metric-check: 14px;
    out property <length> menu-metric-glyph: 12px;

    // ---- round eleven (docs/OPTIMIZATION-PLAN-R11.md §1, §2.1 U30/U35) ----
    /// One suggestion row, and the panel body's padding above it. The panel's
    /// scroll arithmetic (`main.slint`, `became-active`) multiplied the same two
    /// numbers a second time, which is how a row height drifts: the row and the
    /// maths that scrolls to it must read one pair of tokens.
    out property <length> suggest-row-height: 34px;
    out property <length> suggest-row-pad: 5px;
    /// One line of the shell's notice bar. The bar is two lines tall
    /// (`notice-line-height * 2 + space-1 * 2`, i.e. today's 44px) and a long
    /// notice wraps instead of being elided away.
    out property <length> notice-line-height: 18px;
    /// How long a notice stays before the shell dismisses it. A duration, so it
    /// belongs with the motion tokens and is checked by
    /// `every_declared_motion_token_is_referenced_and_no_animate_uses_a_literal_duration`.
    out property <duration> notice-dwell: 6s;
    /// Height of the 3px rule the novel reader draws under a partly-read row
    /// (§4 F4). Declared here because track D binds it: the reader may not invent
    /// the number, and this file is the only place a length may be written.
    out property <length> progress-rule-height: 3px;

    // ---- round twelve (docs/OPTIMIZATION-PLAN-R12.md §2, track A) ----
    /// The floating batch bar's own height. It was a literal in `BatchBar` and in the
    /// three pages that reserve room for it, and the shell's notice bar has to know it
    /// too: with the notice anchored at the bottom of the content area the two boxes
    /// overlapped by 44 px, so a notice raised by a batch download covered the very
    /// buttons that raised it. One token, read by the bar, by the three pages' spacers
    /// and by the notice's own anchor.
    out property <length> batch-bar-height: 48px;
    /// The shell's notice bar sits this far above whatever is under it. It was `space-4`
    /// written at the anchor; naming it is what lets the bar keep its distance from the
    /// batch bar without a second literal.
    out property <length> notice-gap: 16px;
    /// Inset of the selection check inside a card's cover: bottom-left, because the rank
    /// badge owns the top-left, the type badge the top-right and the bookmark pill the
    /// bottom-right.
    out property <length> card-check-inset: 8px;

    // ---- motion --------------------------------------------------------
    // Short and linear-ish: a desktop tool should never feel animated. Every
    // animation in the UI names one of these two, no `animate` carries a
    // duration literal, and no token may be declared without a user;
    // `every_declared_motion_token_is_referenced_and_no_animate_uses_a_literal_duration`
    // holds both halves of that.
    out property <duration> motion-fast: 90ms;
    out property <duration> motion: 150ms;
}

// Convenience aliases so components read cleanly.
export global Type {
    out property <int> regular: 400;
    out property <int> medium: 500;
    out property <int> semibold: 600;
    out property <int> bold: 700;
}

/// Named weight, so a call site says what the text *is* rather than what number to
/// set. `Label` and `BodyText` map it to `Type`; nothing else should need an int.
export enum Emphasis {
    Regular,
    Medium,
    Semibold,
    Bold,
}

/// Named size step, so a page picks a role instead of a pixel value.
///
/// The names match the WinUI ramp as the app uses it, not as WinUI documents it:
/// `Caption` is the 11px metadata step, `Small` the 12px secondary step, `Body`
/// the 14px UI step, `Title` a 16px section heading, `Page` the 20px page title
/// and `Display` the 24px hero line.
export enum TextRole {
    Caption,
    Small,
    Body,
    Subhead,
    Title,
    Page,
    Display,
}
