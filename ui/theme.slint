// Design tokens for Pixiv Desktop.
//
// The visual brief is 70% Pixiv web layout + 30% WinUI 3 / Fluent Design.
// Concretely that means:
//   * Pixiv's blue accent, white canvas, and dense information layout survive;
//   * Fluent contributes layered surfaces, thin borders, 8px radii, tighter
//     control heights and a real light/dark pairing.
//
// Everything is a token here. No page is allowed to hard-code a colour, a radius
// or a spacing value: switching `Theme.dark` must restyle the entire app without
// touching any page file.

export global Theme {
    // Flipped by the app at start-up (system preference) and by the top-bar toggle.
    in-out property <bool> dark: false;

    // ---- brand ---------------------------------------------------------
    // Pixiv's signature blue. Kept exact in light mode; lifted slightly in dark
    // mode so it stays legible against the darker canvas.
    out property <color> accent: dark ? #4aa8e8 : #0096fa;
    out property <color> accent-hover: dark ? #63b7ee : #1ba3fb;
    out property <color> accent-pressed: dark ? #3a90c9 : #0082dc;
    // 10% accent wash for selection and hover backgrounds.
    out property <color> accent-subtle: dark ? #1e3a4d : #e6f4ff;
    out property <color> on-accent: #ffffff;

    // ---- surfaces ------------------------------------------------------
    // `canvas` is the page floor, `layer` a card, `chrome` the title bar and rail.
    out property <color> canvas: dark ? #1a1a1c : #ffffff;
    out property <color> layer: dark ? #212125 : #ffffff;
    out property <color> layer-alt: dark ? #26262b : #f7f8fa;
    out property <color> chrome: dark ? #17171a : #fafbfc;
    out property <color> overlay: dark ? #b3000000 : #66000000;

    // ---- lines ---------------------------------------------------------
    out property <color> border: dark ? #33333a : #e3e6ea;
    out property <color> border-strong: dark ? #45454e : #cdd3da;

    // ---- text ----------------------------------------------------------
    out property <color> text: dark ? #ededef : #1a1a1a;
    out property <color> text-secondary: dark ? #a2a2aa : #6b7280;
    out property <color> text-tertiary: dark ? #74747c : #9aa3ae;

    // ---- state ---------------------------------------------------------
    out property <color> danger: dark ? #ff7b7b : #d13438;
    out property <color> success: dark ? #56d364 : #107c10;
    out property <color> warning: dark ? #f0b429 : #9d5d00;
    // Transparent fills used for hover/press so cards never jump in size.
    out property <color> hover: dark ? #18ffffff : #0a000000;
    out property <color> pressed: dark ? #24ffffff : #14000000;

    // ---- elevation -----------------------------------------------------
    // Fluent leans on 1px borders with a whisper of shadow rather than big blur.
    out property <color> shadow: dark ? #40000000 : #14000000;
    out property <color> focus-ring: dark ? #7ac0f0 : #0096fa;

    // ---- fixed geometry -----------------------------------------------
    out property <length> titlebar-height: 34px;
    out property <length> topbar-height: 52px;
    out property <length> rail-width: 224px;
    out property <length> rail-width-compact: 56px;
    out property <length> page-padding: 20px;

    // ---- type scale ----------------------------------------------------
    // Deliberately small: this is a desktop information tool, not a touch UI.
    out property <length> font-caption: 11px;
    out property <length> font-small: 12px;
    out property <length> font-body: 13px;
    out property <length> font-subhead: 14px;
    out property <length> font-title: 16px;
    out property <length> font-page: 20px;
    out property <length> font-display: 24px;

    // ---- radii ---------------------------------------------------------
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 6px;
    out property <length> radius-lg: 8px;
    out property <length> radius-xl: 12px;
    out property <length> radius-pill: 999px;

    // ---- spacing -------------------------------------------------------
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-5: 20px;
    out property <length> space-6: 24px;
    out property <length> space-8: 32px;

    // ---- control sizes -------------------------------------------------
    out property <length> control-height: 32px;
    out property <length> control-height-lg: 36px;
    out property <length> icon-size: 16px;
    out property <length> icon-size-lg: 20px;
}

// Convenience aliases so components read cleanly.
export global Type {
    out property <int> regular: 400;
    out property <int> medium: 500;
    out property <int> semibold: 600;
    out property <int> bold: 700;
}
