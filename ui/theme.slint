// Design tokens for Pixiv Desktop.
//
// Visual brief: 70% Windows 11 / WinUI 3 desktop chrome + 30% Pixiv's
// artwork-browsing experience. Concretely:
//   * WinUI 3 supplies the navigation system, control metrics (32px controls,
//     4px control radius / 8px card radius), layered neutral surfaces, 1px
//     low-contrast strokes, the Light/Dark/System theme triad and the type ramp;
//   * Pixiv supplies its blue accent, the artwork-first density and the tag
//     chips — nothing else. It is not a web wrapper with a native frame.
//
// Rules this file exists to enforce:
//   * No page hard-codes a colour, radius, spacing or control size.
//   * Theme is a three-state choice (`ThemeMode`), never a bare boolean, so
//     "follow the system" is a real mode instead of a toggle that does nothing.
//   * Every length that two files must agree on (card width bounds, scrollbar
//     gutter, caption height, nav item height) is defined here *once* and mirrored
//     by the Rust layout model in `src/layout.rs`.

/// Light / dark choice. `System` follows the Windows "app mode" setting.
export enum ThemeMode {
    System,
    Light,
    Dark,
}

export global Theme {
    /// User's explicit choice, persisted to SQLite and pushed in by Rust.
    in-out property <ThemeMode> mode: ThemeMode.System;
    /// The OS's app-mode preference, read from the registry by Rust. Meaningful
    /// only while `mode == System`; kept as an input so the shell stays a pure
    /// function of its properties.
    in-out property <bool> system-dark: false;

    /// Single source of truth for every colour choice in the app.
    out property <bool> dark:
        mode == ThemeMode.Dark || (mode == ThemeMode.System && system-dark);

    // ---- brand ---------------------------------------------------------
    // Pixiv's signature blue. Kept exact in light mode; lifted in dark mode so
    // it still clears the 4.5:1 contrast bar against the darker canvas.
    out property <color> accent: dark ? #4cb0f5 : #0096fa;
    out property <color> accent-hover: dark ? #63bcf7 : #12a2ff;
    out property <color> accent-pressed: dark ? #3d96d0 : #0081db;
    // ~10% accent wash for selection, chips and informational banners.
    out property <color> accent-subtle: dark ? #1d3b4f : #e6f4ff;
    out property <color> accent-subtle-hover: dark ? #24475f : #d6ecff;
    out property <color> on-accent: #ffffff;
    // Legible accent for text drawn on the accent-subtle wash.
    out property <color> accent-ink: dark ? #8ecdf7 : #0a6fb5;

    // ---- surfaces ------------------------------------------------------
    // `canvas` is the page floor (Win11 #f3f3f3 / #202020); `layer` is a card;
    // `chrome` is the top bar / navigation rail; `flyout` floats above all.
    out property <color> canvas: dark ? #202020 : #f3f3f3;
    out property <color> layer: dark ? #2b2b2b : #ffffff;
    out property <color> layer-alt: dark ? #323232 : #f7f8f9;
    out property <color> layer-sunken: dark ? #1a1a1a : #ececee;
    out property <color> chrome: dark ? #272727 : #f3f3f3;
    out property <color> flyout: dark ? #2f2f2f : #fbfbfb;
    out property <color> scrim: dark ? #b3050505 : #66000000;

    // ---- strokes -------------------------------------------------------
    // Fluent leans on 1px strokes instead of heavy borders or drop shadows.
    out property <color> border: dark ? #3d3d3d : #e3e3e3;
    out property <color> border-strong: dark ? #4f4f4f : #cfcfcf;
    out property <color> border-subtle: dark ? #303030 : #ededed;

    // ---- text ----------------------------------------------------------
    out property <color> text: dark ? #ffffff : #1a1a1a;
    out property <color> text-secondary: dark ? #c5c5c5 : #5d5d5d;
    out property <color> text-tertiary: dark ? #9a9a9a : #8a8a8a;
    out property <color> text-disabled: dark ? #5c5c5c : #b3b3b3;

    // ---- semantic state ------------------------------------------------
    out property <color> danger: dark ? #ff99a4 : #c42b1c;
    out property <color> danger-subtle: dark ? #42201f : #fdebe9;
    out property <color> success: dark ? #6ccf8a : #0f7b0f;
    out property <color> success-subtle: dark ? #1b3226 : #e9f6ec;
    out property <color> warning: dark ? #f0b429 : #9d5d00;
    out property <color> warning-subtle: dark ? #3d2f10 : #fff4ce;

    // Transparent overlays for hover/press so nothing ever resizes on hover.
    out property <color> hover: dark ? #14ffffff : #0a000000;
    out property <color> pressed: dark ? #1fffffff : #14000000;
    out property <color> focus-ring: dark ? #7ac0f0 : #0a84d8;

    // ---- inverted surfaces ---------------------------------------------
    // A tooltip is deliberately the inverse of the surface under it (WinUI does
    // the same), so it cannot be expressed as a light/dark pair of the normal
    // neutrals: in dark mode the tip is light with dark ink.
    out property <color> tip-surface: dark ? #f0f0f0 : #2b2b2b;
    out property <color> tip-ink: dark ? #1a1a1a : #ffffff;
    out property <color> tip-border: dark ? #3d3d3d : transparent;
    /// Backdrop of the image viewer, behind the artwork on both axes.
    out property <color> viewer-surface: dark ? #101012 : #e8eaed;
    /// Floating control bar over the artwork: translucent so the image reads through.
    out property <color> viewer-chrome: dark ? #dd1c1c20 : #e8ffffff;
    // ---- elevation -----------------------------------------------------
    // Slint has no blur, so elevation is emulated with a low-alpha offset
    // rectangle behind flyouts (or `drop-shadow-*`, which blurs on the GPU
    // renderer only). Two steps only: cards stay flat.
    out property <color> shadow-1: dark ? #4d000000 : #0f000000;
    out property <color> shadow-2: dark ? #73000000 : #24000000;

    // ---- fixed geometry ------------------------------------------------
    out property <length> topbar-height: 48px;
    out property <length> rail-width: 232px;
    out property <length> rail-width-compact: 52px;
    out property <length> statusbar-height: 26px;
    /// Horizontal page inset. The gallery maths in `src/layout.rs` mirrors this.
    out property <length> page-padding: 20px;
    /// Widest a text column is allowed to get before it becomes unreadable.
    out property <length> reading-max: 720px;

    // ---- artwork grid --------------------------------------------------
    // These four values MUST stay in sync with the constants in `src/layout.rs`.
    out property <length> card-min-width: 168px;
    out property <length> card-max-width: 300px;
    out property <length> card-gap: 16px;
    out property <length> card-caption-height: 44px;
    /// Width of a column reserved for the overlay scrollbar, so a card never
    /// sits underneath the thumb.
    out property <length> scrollbar-gutter: 10px;

    // ---- type ----------------------------------------------------------
    // WinUI 3's ramp, compressed for a dense browse client: the settings rows
    // and list rows WinUI draws at 14px stay at 14px, captions drop to 11 so a
    // card can carry a title and an author inside 44px.
    //
    // Font family note: the app sets `default-font-family` on the root window, so
    // every `Text` inherits it. "Segoe UI Variable Text" is Win11's UI face;
    // Windows falls back per-glyph for CJK, which keeps Chinese and Japanese
    // metrics correct without bundling a font.
    out property <string> font-family: "Segoe UI Variable Text";
    out property <length> font-caption: 11px;
    out property <length> font-small: 12px;
    out property <length> font-body: 14px;
    out property <length> font-subhead: 14px;
    out property <length> font-title: 16px;
    out property <length> font-page: 20px;
    out property <length> font-display: 24px;

    // ---- radii ---------------------------------------------------------
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 6px;
    out property <length> radius-lg: 8px;
    out property <length> radius-xl: 12px;
    out property <length> radius-pill: 999px;

    // ---- spacing (4px grid) --------------------------------------------
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-5: 20px;
    out property <length> space-6: 24px;
    out property <length> space-8: 32px;

    // ---- controls ------------------------------------------------------
    out property <length> control-height: 32px;
    out property <length> control-height-sm: 26px;
    out property <length> control-height-lg: 36px;
    out property <length> icon-size: 16px;
    out property <length> icon-size-lg: 20px;
    out property <length> row-height: 56px;
    /// NavigationView row metric. WinUI uses 36px for a standard-density pane.
    out property <length> nav-item-height: 36px;

    // ---- motion --------------------------------------------------------
    // Short and linear-ish: a desktop tool should never feel animated.
    out property <duration> motion-fast: 90ms;
    out property <duration> motion: 150ms;
}

// Convenience aliases so components read cleanly.
export global Type {
    out property <int> regular: 400;
    out property <int> medium: 500;
    out property <int> semibold: 600;
    out property <int> bold: 700;
}
