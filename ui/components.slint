// Fluent 2 / WinUI 3 primitives shared by every page.
//
// Rules encoded here so pages cannot get them wrong:
//   * Hover/press feedback changes `background` only, never geometry. A bookmark
//     toggle must not shift the card underneath it.
//   * Every interactive element has Normal / Hover / Pressed / Focused /
//     Disabled states, a pointer cursor, and a real click target.
//   * Nothing is sized to a magic pixel value that would clip at 150% DPI; the
//     numbers come from `theme.slint` and the 4px spacing grid.
//   * Text that can be long is either elided or wrapped. A bare `Text` in a
//     layout reports its *full* string width as a minimum, which is the root
//     cause of the horizontal-scrollbar/blank-space class of bugs — so every
//     text node here has an explicit width or an overflow policy.

import { Theme, Type, Emphasis, TextRole } from "theme.slint";
import { Tip, TipSide } from "tip.slint";
import { FluentGlyph } from "icons.slint";
import { ScrollView } from "std-widgets.slint";

// ======================================================================
// Type — the two ways the app is allowed to size text
// ======================================================================
//
// Everything else in this file, and every page, draws text through one of these
// two. The reason is not tidiness: before them each call site repeated
// `font-size: Theme.font-small; vertical-alignment: center;` and the copies had
// already drifted - a caption that filled its row, a subtitle that did not, one
// label bold in the rail and regular in the palette. A role names the step; the
// component supplies the metrics that must travel with it.
//
// Two components, not one, because the split is a *rendering* decision in Slint:
//   * `Label` is single-line (elided) and keeps the natural line height. That is
//     what keeps it on Slint's simple-text path, which the feed needs: one
//     masonry column draws ~40 of them.
//   * `BodyText` wraps, and wrapping is the only case where a line-height factor
//     buys anything. It is what a paragraph, an about text and the reader use.

/// One line of UI text, sized and weighted by role.
///
/// `vertical-alignment: center` is not cosmetic and not overridable by accident:
/// a `Text` given a fixed height is placed at the *start* of its box, so a 14px
/// label in a 36px row sits 11px above the row's centre line, and that is the
/// class of defect this whole layer exists to remove. A caller that genuinely
/// wants top alignment asks `BodyText` instead.
export component Label inherits Text {
    in property <TextRole> role: TextRole.Body;
    in property <Emphasis> emphasis: Emphasis.Regular;

    font-size: root.role == TextRole.Caption ? Theme.font-caption
        : root.role == TextRole.Small ? Theme.font-small
        : root.role == TextRole.Body ? Theme.font-body
        : root.role == TextRole.Subhead ? Theme.font-subhead
        : root.role == TextRole.Title ? Theme.font-title
        : root.role == TextRole.Page ? Theme.font-page
        : Theme.font-display;
    font-weight: root.emphasis == Emphasis.Medium ? Type.medium
        : root.emphasis == Emphasis.Semibold ? Type.semibold
        : root.emphasis == Emphasis.Bold ? Type.bold
        : Type.regular;
    vertical-alignment: center;
    overflow: elide;
    wrap: no-wrap;
}

/// Wrapped text: a paragraph, a description, a reader block.
///
/// The role picks the size and the leading together (`Theme.line-body`,
/// `Theme.line-small`) so a wrapped block can never be set solid while its
/// sibling is not. `vertical-alignment: top` because a paragraph grows downward
/// from its first line - centring it would move the first line whenever the last
/// one wrapped.
export component BodyText inherits Text {
    in property <TextRole> role: TextRole.Body;
    in property <Emphasis> emphasis: Emphasis.Regular;

    font-size: root.role == TextRole.Caption ? Theme.font-caption
        : root.role == TextRole.Small ? Theme.font-small
        : root.role == TextRole.Subhead ? Theme.font-subhead
        : root.role == TextRole.Title ? Theme.font-title
        : Theme.font-body;
    font-weight: root.emphasis == Emphasis.Medium ? Type.medium
        : root.emphasis == Emphasis.Semibold ? Type.semibold
        : root.emphasis == Emphasis.Bold ? Type.bold
        : Type.regular;
    line-height-factor: root.role == TextRole.Caption || root.role == TextRole.Small
        ? Theme.line-small : Theme.line-body;
    vertical-alignment: top;
    wrap: word-wrap;
}

// ======================================================================
// Icons — the one place a glyph is positioned
// ======================================================================

// Two measured facts drive the whole icon layer. Neither is guessable from a
// Slint declaration, which is why they are written down here:
//
//  1. `Path` places itself at `x: 0; y: 0`. `FluentIcon` gives it a size but not
//     a position, so a 16px glyph inside a 32px button used to sit in the
//     button's top-left corner — 8px right and 8px down of centre.
//  2. A child of a `HorizontalLayout` with a *fixed* height is aligned to the
//     start of the cross axis, not centred. Measured on the navigation rail: every
//     glyph's centre sat 15.5 physical px (10.3 logical px at 150 % DPI) above the
//     centre line of its row, while the `Text` siblings — which fill the row and
//     centre their own baseline — were within 1px.
//
// So: no call site hands a glyph a bare size again. Either it hands it a box
// (`IconPresenter` centres inside a box the caller owns) or it hands it a row
// (`IconSlot` claims the full cross axis and centres inside that).

/// One Fluent glyph, centred inside its own square box.
///
/// The box may be larger than the glyph (`glyph-size`), which is what makes a
/// 13px heart sit in the middle of a 28px pill without a magic offset.
export component IconPresenter inherits Rectangle {
    in property <string> name: "";
    in property <length> glyph-size: Theme.icon-size;
    in property <color> tint: Theme.text;
    in property <bool> enabled: true;

    width: root.glyph-size;
    height: root.glyph-size;
    background: transparent;

    FluentGlyph {
        name: root.name;
        width: root.glyph-size;
        height: root.glyph-size;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        tint: root.tint;
        opacity: root.enabled ? 1.0 : 0.4;
    }
}

/// A glyph on the centre line of whatever row it is placed in.
///
/// `height: 100%` is load-bearing: it is the only way to make a fixed-size child
/// of a horizontal layout claim the cross axis. `slot` reserves a fixed column so
/// that icon+label rows keep their labels on one shared vertical rule no matter
/// how wide an individual glyph's ink happens to be.
export component IconSlot inherits Rectangle {
    in property <string> name: "";
    in property <length> glyph-size: Theme.icon-size;
    in property <length> slot: Theme.icon-size;
    in property <color> tint: Theme.text;
    in property <bool> enabled: true;

    width: root.slot;
    height: 100%;
    background: transparent;

    FluentGlyph {
        name: root.name;
        width: root.glyph-size;
        height: root.glyph-size;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        tint: root.tint;
        opacity: root.enabled ? 1.0 : 0.4;
    }
}

// ======================================================================
// Small overlays
// ======================================================================

/// Minimal hover hint. Slint's built-in `Tooltip` takes `styled-text`, which
/// cannot be fed a dynamic `string` without markdown wrapping, so the app uses
/// this fully-themeable equivalent instead.
///
/// `placement` matters: the top command bar is only 48px tall and a tip drawn
/// *above* a button there lands outside the window, where it is silently
/// invisible. Chrome near the top of the window therefore passes `below`.
export enum TipPlacement {
    Above,
    Below,
    Right,
}

export component HoverTip inherits Rectangle {
    in property <string> tip: "";
    in property <bool> show: false;
    in property <length> max-tip-width: 300px;
    /// Below/Above: the control's horizontal centre. Right: its right edge.
    in property <length> anchor-x: 0px;
    /// Below: the control's bottom edge. Above: its top edge. Right: its centre.
    in property <length> anchor-y: 0px;
    in property <TipSide> side: TipSide.Below;
    /// The window box the bubble has to stay inside. Chrome sits at the edge of
    /// the window, so a bubble that is not clamped loses its first or last glyph.
    in property <length> window-width: 0px;
    in property <length> window-height: 0px;

    visible: root.show && root.tip != "";
    height: 24px;
    width: Math.min(label.preferred-width + Theme.space-3 * 2, root.max-tip-width);

    // The position is derived from the anchor, never written by the caller: three
    // of the four old call sites placed themselves, and each was wrong for a
    // different reason.
    out property <length> wanted-x: root.side == TipSide.Right
        ? root.anchor-x + Theme.space-1
        : root.anchor-x - self.width / 2;
    out property <length> wanted-y: root.side == TipSide.Below
        ? root.anchor-y + Theme.space-1
        : root.side == TipSide.Above
            ? root.anchor-y - self.height - Theme.space-1
            : root.anchor-y - self.height / 2;
    x: Math.min(Math.max(Theme.space-1, root.wanted-x),
        Math.max(Theme.space-1, root.window-width - self.width - Theme.space-1));
    y: Math.min(Math.max(Theme.space-1, root.wanted-y),
        Math.max(Theme.space-1, root.window-height - self.height - Theme.space-1));
    border-radius: Theme.radius-sm;
    background: Theme.tip-surface;
    border-width: 1px;
    border-color: Theme.tip-border;
    drop-shadow-blur: 8px;
    drop-shadow-color: Theme.shadow-2;
    drop-shadow-offset-y: 2px;

    label := Text {
        x: Theme.space-3;
        y: (root.height - self.height) / 2;
        width: root.width - Theme.space-3 * 2;
        text: root.tip;
        color: Theme.tip-ink;
        font-size: Theme.font-caption;
        vertical-alignment: center;
        overflow: elide;
    }
}

// ======================================================================
// Buttons
// ======================================================================

export enum ButtonKind {
    Primary,
    Secondary,
    Subtle,
    Danger,
}

/// Fluent button: 32px tall, 4px radius, 1px stroke for the secondary variant,
/// accent fill for the primary one. Focusable and operable with Enter/Space.
export component AppButton inherits Rectangle {
    in property <string> label: "";
    in property <ButtonKind> kind: ButtonKind.Secondary;
    /// A FluentGlyph name; empty for no icon.
    in property <string> icon: "";
    in property <bool> compact: false;
    in property <bool> enabled: true;
    /// Visual height. Ignored when `row-height` is set.
    in property <length> visual-height: 0px;
    /// Set to the height of the enclosing bar to let the button claim the whole
    /// cross axis and centre its own pill, instead of being top-aligned by the
    /// surrounding horizontal layout.
    in property <length> row-height: 0px;
    callback clicked();

    // ---- accessibility ----
    // Slint publishes an element to UI Automation only if it has an
    // `accessible-role`, and that role has to be a compile-time constant. The name
    // and the action do not: the label is the same expression the button already
    // draws, so every existing call site gains a named, invokable node without
    // changing a line of its own.
    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }

    out property <length> button-height:
        root.visual-height > 0px ? root.visual-height
            : (root.compact ? Theme.control-height-sm : Theme.control-height);

    height: root.row-height > 0px ? root.row-height : root.button-height;
    // Hug the label, with a floor for icon-only and short labels. Without an
    // explicit width a button is a stretch candidate in any enclosing layout,
    // which is how "换一批" ended up as a 600px white slab across the home hero
    // with its label floating in the middle.
    width: max(root.compact ? 40px : 64px, content.preferred-width);
    background: transparent;

    fill := Rectangle {
        y: (root.height - root.button-height) / 2;
        height: root.button-height;
        border-radius: Theme.radius-sm;
        border-width: (root.kind == ButtonKind.Secondary) ? 1px : 0px;
        border-color: ta.has-hover ? Theme.border-strong : Theme.border;
        background: (root.kind == ButtonKind.Primary)
            ? (ta.pressed ? Theme.accent-fill-pressed
                : (ta.has-hover ? Theme.accent-fill-hover : Theme.accent-fill))
            : (root.kind == ButtonKind.Danger)
                ? (ta.pressed ? Theme.pressed : (ta.has-hover ? Theme.danger-subtle : transparent))
                : (root.kind == ButtonKind.Subtle)
                    ? (ta.pressed ? Theme.pressed : (ta.has-hover ? Theme.hover : transparent))
                    : (ta.pressed ? Theme.layer-sunken : (ta.has-hover ? Theme.layer-alt : Theme.layer));

        content := HorizontalLayout {
            padding-left: root.compact ? Theme.space-2 : Theme.space-3;
            padding-right: root.compact ? Theme.space-2 : Theme.space-3;
            spacing: Theme.space-2;
            alignment: center;

            if root.icon != "" : IconSlot {
                name: root.icon;
                slot: Theme.icon-size;
                tint: (root.kind == ButtonKind.Primary) ? Theme.on-accent
                    : (root.kind == ButtonKind.Danger) ? Theme.danger
                    : Theme.text;
                enabled: root.enabled;
            }

            Label {
                emphasis: Emphasis.Medium;
                text: root.label;
                color: (root.kind == ButtonKind.Primary) ? Theme.on-accent
                    : (root.kind == ButtonKind.Danger) ? Theme.danger
                    : Theme.text;
            }
        }

        // Focus ring as opacity rather than as an `if`: a Tab stop that appears
        // between two frames reads as a glitch on a dark surface. Opacity only -
        // it moves nothing - and it rests at 0 while unfocused, so an unfocused
        // button paints exactly the pixels the old conditional left behind.
        Rectangle {
            border-radius: Theme.radius-sm;
            border-width: 2px;
            border-color: Theme.focus-ring;
            background: transparent;
            opacity: key_focus.has-focus ? 1.0 : 0.0;
            animate opacity { duration: Theme.motion-fast; easing: ease-out; }
        }
    }

    opacity: root.enabled ? 1.0 : 0.42;

    key_focus := FocusScope {
        key-pressed(e) => {
            if (root.enabled && (e.text == "\n" || e.text == " ")) {
                root.clicked();
                return EventResult.accept;
            }
            EventResult.reject
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Square icon-only button, used in the top bar and the image viewer.
///
/// The glyph is centred against `size` (the visual square), not against the
/// element, so passing `row-height` lets the button fill a 48px command bar while
/// its hover wash and its glyph stay a 32px square in the middle of it.
export component IconButton inherits Rectangle {
    in property <string> icon: "";
    in property <string> tip: "";
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <length> size: Theme.control-height;
    in property <length> row-height: 0px;
    in property <color> tint: Theme.text;
    in property <TipPlacement> tip-placement: TipPlacement.Above;
    callback clicked();

    // The tip is the button's name: an icon-only control has no text of its own,
    // and its tooltip is the only wording it has. Falling back to the glyph name
    // keeps a tip-less button from being completely anonymous.
    accessible-role: AccessibleRole.button;
    accessible-label: root.tip != "" ? root.tip : root.icon;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }

    width: root.size;
    height: root.row-height > 0px ? root.row-height : root.size;
    background: transparent;

    wash := Rectangle {
        y: (root.height - root.size) / 2;
        width: root.size;
        height: root.size;
        border-radius: Theme.radius-sm;
        background: ta.pressed ? Theme.pressed
            : ta.has-hover ? Theme.hover
            : (root.active ? Theme.accent-subtle : transparent);
    }

    opacity: root.enabled ? 1.0 : 0.4;

    IconPresenter {
        name: root.icon;
        glyph-size: Theme.icon-size;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        tint: root.active ? Theme.accent-ink : root.tint;
    }

    // Keyboard: same ring, same 2px stroke and same Theme.focus-ring as AppButton,
    // drawn on the button's visual square rather than the element, so a command-bar
    // button that claims a 48px row still shows a 32px square ring.
    // Same ring, same fade as AppButton's: opacity, not an `if`.
    Rectangle {
        y: (root.height - root.size) / 2;
        width: root.size;
        height: root.size;
        border-radius: Theme.radius-sm;
        border-width: 2px;
        border-color: Theme.focus-ring;
        background: transparent;
        opacity: key_focus.has-focus ? 1.0 : 0.0;
        animate opacity { duration: Theme.motion-fast; easing: ease-out; }
    }

    /// Focus entry for a caller that opened something and must hand the keyboard
    /// back to this button (U21: the bookmark menu returns focus to its chevron).
    public function take-focus() { key_focus.focus(); }

    key_focus := FocusScope {
        key-pressed(e) => {
            if (root.enabled && (e.text == "\n" || e.text == " ")) {
                root.clicked();
                return EventResult.accept;
            }
            EventResult.reject
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    // Not a child element: a 48px command bar has nowhere to draw a tip inside
    // itself, and a child cannot paint over the page that follows the bar. The
    // control publishes text and an anchor; the window draws the bubble last.
    // `changed` only watches a property of this element, so the child's hover is
    // mirrored into one. Cheap, one-way, and it is what lets the tip be
    // republished when the pointer enters without the user having to move.
    property <bool> hovering: ta.has-hover;
    changed hovering => {
        if (hovering && root.enabled && root.tip != "") {
            Tip.text = root.tip;
            Tip.side = root.tip-placement == TipPlacement.Below ? TipSide.Below : TipSide.Above;
            Tip.anchor-x = ta.absolute-position.x + root.width / 2;
            Tip.anchor-y = Tip.side == TipSide.Below
                ? ta.absolute-position.y + root.height
                : ta.absolute-position.y;
            Tip.visible = true;
        } else {
            Tip.visible = false;
        }
    }
}

// ======================================================================
// Inputs
// ======================================================================

/// Fluent text field with a leading glyph and a clear affordance.
///
/// Child order is hit-test order in Slint (the last declared element is on top),
/// so the layout here is deliberate: the padding touch target first, the input
/// above it, the clear button last. The previous version put a full-size
/// `TouchArea` *after* the layout, which covered the clear button and made it
/// unclickable — the click only ever re-focused the field.
export component TextField inherits Rectangle {
    in property <string> placeholder: "";
    in property <string> leading-icon: "";
    in-out property <string> text <=> input.text;
    in property <bool> enabled: true;
    callback edited(string);
    callback accepted(string);
    callback cleared();
    /// Up/Down pressed while the field has focus, so the suggestion panel can
    /// move its own cursor. TextInput would otherwise consume the arrows to move
    /// the caret, and the panel would never see them.
    callback navigate-keys(string);

    // The role, the name and the action live on the inner `TextInput`, not here.
    // Two nodes with the same name is one node too many: the wrapper drew an "Edit"
    // the size of the whole field that Tab could never reach (measured by the a11y
    // walk: 1242x48 unreachable next to the real 1182x42 field), and every page paid
    // for it. The element that takes the keystrokes is the element that is published.

    /// Focus the inner input. Slint has no declarative focus hook, so callers
    /// invoke this from a callback (e.g. the Ctrl+F shortcut).
    public function focus-input() { input.focus(); }

    height: Theme.control-height;
    min-width: 96px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent-fill
        : (hover.has-hover ? Theme.border-strong : Theme.border);
    background: input.has-focus ? Theme.layer : Theme.layer-alt;
    opacity: root.enabled ? 1.0 : 0.5;

    out property <length> leading-extent:
        root.leading-icon == "" ? 0px : Theme.icon-size + Theme.space-2;
    out property <length> trailing-extent:
        (root.text != "" && root.enabled) ? 22px + Theme.space-1 * 2 : Theme.space-2;
    out property <length> text-x: Theme.space-2 + root.leading-extent;

    // Fluent accents the focused field with a 2px bottom rule.
    if input.has-focus : Rectangle {
        y: root.height - 2px;
        height: 2px;
        background: Theme.accent-fill;
        border-radius: Theme.radius-sm;
    }

    // Padding hit target, painted *under* everything else.
    hover := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }

    if root.leading-icon != "" : IconPresenter {
        name: root.leading-icon;
        glyph-size: Theme.icon-size;
        x: Theme.space-2;
        y: (root.height - self.height) / 2;
        tint: input.has-focus ? Theme.accent-fill : Theme.text-secondary;
    }

    // The text box is inset 2px top and bottom: the bottom 2px is the focus
    // underline's band and the top 2px is its mirror, so the text's centre line
    // falls on the control's — (root.height - 4px) / 2 + 2px == root.height / 2.
    // At y: 0px it sat at 14 in a 32px field while both icon groups centred at
    // 16, which is the 2px every field's text rode above its own glyphs.
    input := TextInput {
        x: root.text-x;
        y: 2px;
        width: max(0px, root.width - root.text-x - root.trailing-extent);
        height: root.height - 4px;
        enabled: root.enabled;
        // This element is the one that actually takes keyboard focus, so it is the
        // one UI Automation reports as focused, and therefore the one that carries
        // the role and the name: an unnamed Edit reads as anonymous, and a second
        // named Edit on the wrapper is a node Tab can never reach.
        accessible-role: AccessibleRole.text-input;
        accessible-label: root.placeholder;
        accessible-placeholder-text: root.placeholder;
        accessible-value: root.text;
        accessible-enabled: root.enabled;
        accessible-action-default => { root.focus-input(); }
        color: Theme.text;
        font-size: Theme.font-body;
        vertical-alignment: center;
        single-line: true;
        edited => { root.edited(root.text); }
        accepted => { root.accepted(root.text); }
        key-pressed(e) => {
            if (e.text == "\u{F700}" || e.text == "\u{F701}") {
                root.navigate-keys(e.text);
                return EventResult.accept;
            }
            EventResult.reject
        }
    }

    // TextInput has no placeholder of its own, so it is drawn underneath with an
    // explicit width: a bare Text would report the full placeholder width as a
    // minimum for the whole field.
    if root.text == "" : Label {
        x: root.text-x;
        // Same box, same centre line as the TextInput above: the placeholder is
        // drawn *underneath* the real text and the two must not drift apart.
        y: 2px;
        width: max(0px, root.width - root.text-x - root.trailing-extent);
        height: root.height - 4px;
        text: root.placeholder;
        color: Theme.text-tertiary;
    }

    if root.text != "" && root.enabled : IconButton {
        icon: "dismiss";
        // G31: a control created without its name is one a screen reader cannot
        // describe — the field's own clear button included.
        tip: "清除输入";
        tint: Theme.text-secondary;
        size: 22px;
        x: root.width - self.width - Theme.space-1;
        y: (root.height - self.height) / 2;
        clicked => {
            root.text = "";
            root.cleared();
            input.focus();
        }
    }
}

/// WinUI-style toggle switch: 40x20 track, 12px thumb, 90ms slide.
export component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    /// Name for assistive technology; the switch draws no label of its own.
    in property <string> label: "";
    callback toggled(bool);

    accessible-role: AccessibleRole.switch;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    // The switch reports the value the gesture asks for and never assigns itself:
    // `checked:` at the call site is a one-way binding to the model, and a local
    // `root.checked =` here destroyed it after the first click (§2.1 U28).
    accessible-action-default => { root.toggled(!root.checked); }

    width: 40px;
    height: 20px;
    border-radius: Theme.radius-pill;
    border-width: root.checked ? 0px : 1px;
    border-color: ta.has-hover ? Theme.text-secondary : Theme.border-strong;
    background: root.checked
        ? (ta.pressed ? Theme.accent-fill-pressed
            : (ta.has-hover ? Theme.accent-fill-hover : Theme.accent-fill))
        : (ta.has-hover ? Theme.layer-sunken : transparent);
    opacity: root.enabled ? 1.0 : 0.42;

    Rectangle {
        width: 12px;
        height: 12px;
        border-radius: Theme.radius-pill;
        x: root.checked ? parent.width - self.width - 4px : 4px;
        y: (parent.height - self.height) / 2;
        background: root.checked ? Theme.on-accent : Theme.text-secondary;
        animate x { duration: Theme.motion-fast; easing: ease-out; }
    }

    // Keyboard. A rectangle is not a Tab stop — only a `FocusScope` is — so this
    // switch could not be reached without a pointer at all. Space/Enter does what
    // `accessible-action-default` already does. The ring is the same 2 px
    // Theme.focus-ring stroke every other control draws, on the 40x20 track, and
    // it rests at opacity 0 so an unfocused switch paints exactly the pixels it
    // painted before it was focusable.
    Rectangle {
        border-radius: Theme.radius-pill;
        border-width: 2px;
        border-color: Theme.focus-ring;
        background: transparent;
        opacity: key_focus.has-focus ? 1.0 : 0.0;
        animate opacity { duration: Theme.motion-fast; easing: ease-out; }
    }

    key_focus := FocusScope {
        key-pressed(e) => {
            if (root.enabled && (e.text == "\n" || e.text == " ")) {
                root.toggled(!root.checked);
                return EventResult.accept;
            }
            EventResult.reject
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

/// Segmented selector, the WinUI "radio buttons" idiom rendered as a pill group.
///
/// Used for the three-way theme choice (跟随系统 / 浅色 / 深色): a boolean toggle
/// cannot express three states, and a `ComboBox` would hide two of them behind a
/// click. Generic over its labels so the same control serves sort order and
/// ranking period.
export component SegmentedControl inherits Rectangle {
    in property <[string]> items: [];
    in-out property <int> current: 0;
    in property <bool> enabled: true;
    /// Name for assistive technology. The current choice is published as the
    /// group's value, so a screen reader hears "排序方式, 最新" rather than three
    /// anonymous rectangles.
    in property <string> label: "";
    callback selected(int);

    accessible-role: AccessibleRole.radio-group;
    accessible-label: root.label;
    accessible-value: root.items.length > 0 ? root.items[root.current] : "";
    accessible-enabled: root.enabled;

    height: Theme.control-height;
    width: row.preferred-width;
    border-radius: Theme.radius-sm;
    background: Theme.layer-alt;
    border-width: 1px;
    border-color: Theme.border;
    opacity: root.enabled ? 1.0 : 0.45;

    // Keyboard: one Tab stop for the group, then Left/Right walk the segments the
    // way WinUI's radio group does, and Space/Enter re-selects the current one.
    // The arrows are key *character codes*, not names: U+F702 is Left, U+F703 is
    // Right. Declared before the layout, because the segments' touch areas come
    // later and must stay on top of it.
    key_focus := FocusScope {
        key-pressed(e) => {
            if (!root.enabled) {
                return EventResult.reject;
            }
            // Report the *index the gesture picked* and let the owner write it back:
            // `root.current = ...` here killed the call site's one-way binding
            // (`current: Theme.mode == ...` in settings.slint), so after one press the
            // group stopped following the model it is supposed to mirror (§2.1 U28).
            if (e.text == "\u{F702}" && root.items.length > 0) {
                root.selected(root.current <= 0 ? root.items.length - 1 : root.current - 1);
                return EventResult.accept;
            }
            if (e.text == "\u{F703}" && root.items.length > 0) {
                root.selected(root.current >= root.items.length - 1 ? 0 : root.current + 1);
                return EventResult.accept;
            }
            if (e.text == "\n" || e.text == " ") {
                root.selected(root.current);
                return EventResult.accept;
            }
            EventResult.reject
        }
    }

    row := HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        alignment: start;

        for item[i] in root.items : Rectangle {
            border-radius: Theme.radius-sm;
            background: i == root.current
                ? Theme.layer
                : (hit.has-hover ? Theme.hover : transparent);
            border-width: i == root.current ? 1px : 0px;
            border-color: Theme.border-strong;

            HorizontalLayout {
                padding-left: Theme.space-3;
                padding-right: Theme.space-3;
                alignment: center;
                Label {
                    role: TextRole.Small;
                    text: item;
                    color: i == root.current ? Theme.text : Theme.text-secondary;
                    font-weight: i == root.current ? Type.semibold : Type.regular;
                }
            }

            hit := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => { root.selected(i); }
            }
        }
    }

    // Same ring, same fade as AppButton's: opacity, not an `if`. Declared after
    // the layout so it paints over the segments it belongs to.
    Rectangle {
        border-radius: Theme.radius-sm;
        border-width: 2px;
        border-color: Theme.focus-ring;
        background: transparent;
        opacity: key_focus.has-focus ? 1.0 : 0.0;
        animate opacity { duration: Theme.motion-fast; easing: ease-out; }
    }
}

/// Small count/type badge. Declared before the elements that embed it: Slint
/// resolves component names in source order, so a type cannot be used above its
/// own definition.
export component Badge inherits Rectangle {
    in property <string> label: "";
    in property <color> fill: Theme.accent-subtle;
    in property <color> ink: Theme.accent-ink;

    height: 18px;
    // Explicit width rather than the default "fill the parent": a badge is also
    // used absolutely positioned (rail counters, toolbar indicators), where the
    // default width would stretch it across the whole bar.
    width: max(18px, row.preferred-width);
    border-radius: Theme.radius-sm;
    background: root.fill;

    row := HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        alignment: center;
        Label {
            role: TextRole.Caption;
            emphasis: Emphasis.Semibold;
            text: root.label;
            color: root.ink;
        }
    }
}

// ======================================================================
// Navigation
// ======================================================================

/// One entry in the NavigationView pane.
///
/// Selected state = accent wash + a 3px accent bar on the leading edge, exactly
/// as WinUI NavigationView draws it. The internals are positioned absolutely and
/// derived from the item's own height: a horizontal layout here top-aligns every
/// fixed-size child, which is what put the rail's glyphs ~10 logical px above
/// their labels. Absolute geometry makes the centre line exact and DPI-proof, and
/// it is why the glyphs stay put on hover/press/select.
export component NavItem inherits Rectangle {
    in property <string> icon: "";
    in property <string> label: "";
    in property <bool> selected: false;
    in property <bool> compact: false;
    in property <int> badge: 0;
    callback clicked();
    /// Up/Down inside the rail. One item cannot know its neighbours — it is a
    /// shared component instantiated eight times — so it hands the delta back to
    /// the window, which is the only place the order is declared.
    callback move-focus(int);

    /// Move keyboard focus onto this entry. A FocusScope's focus is not
    /// addressable from outside its component any other way, and this is what
    /// lets Up/Down hand off to the neighbouring entry.
    public function take-focus() { key_focus.focus(); }

    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    out property <length> inset: root.compact ? 0px : Theme.space-3;

    height: Theme.nav-item-height;
    border-radius: Theme.radius-sm;
    background: root.selected
        ? Theme.accent-subtle
        : (ta.pressed ? Theme.pressed : (ta.has-hover ? Theme.hover : transparent));

    if root.selected : Rectangle {
        x: 0px;
        y: (root.height - 16px) / 2;
        width: 3px;
        height: 16px;
        border-radius: Theme.radius-pill;
        background: Theme.accent-fill;
    }

    IconPresenter {
        name: root.icon;
        glyph-size: Theme.icon-size;
        x: root.compact ? (root.width - self.width) / 2 : root.inset;
        y: (root.height - self.height) / 2;
        tint: root.selected ? Theme.accent-ink : Theme.text-secondary;
    }

    if !root.compact : Label {
        x: root.inset + Theme.icon-size + Theme.space-3;
        y: 0px;
        width: max(0px, root.width - self.x - (root.badge > 0 ? 44px : Theme.space-2));
        height: root.height;
        text: root.label;
        color: root.selected ? Theme.accent-ink : Theme.text;
        font-weight: root.selected ? Type.semibold : Type.regular;
    }

    if !root.compact && root.badge > 0 : Badge {
        label: root.badge > 99 ? "99+" : root.badge;
        x: root.width - self.width - Theme.space-2;
        y: (root.height - self.height) / 2;
    }

    // Round nine, U28 — the compact rail used to drop the counter entirely: the
    // only badge was gated on `!root.compact`, so a 52 px pane showed no sign that
    // anything was downloading and the count survived only as a tooltip. Compact
    // therefore gets a dot instead of a number — 8 px of `accent-fill`, centred on
    // the glyph box's top-right corner, which is the only free space in a 52 x 36
    // row. `accent-fill`, not `accent`: it is a filled surface, and it is the same
    // pair the expanded badge uses for its own fill.
    if root.compact && root.badge > 0 : Rectangle {
        width: 8px;
        height: 8px;
        border-radius: Theme.radius-pill;
        background: Theme.accent-fill;
        x: (root.width + Theme.icon-size) / 2 - self.width / 2;
        y: (root.height - Theme.icon-size) / 2 - self.height / 2;
    }

    // Same ring, same fade as AppButton's: opacity, not an `if`.
    Rectangle {
        border-radius: Theme.radius-sm;
        border-width: 2px;
        border-color: Theme.focus-ring;
        background: transparent;
        opacity: key_focus.has-focus ? 1.0 : 0.0;
        animate opacity { duration: Theme.motion-fast; easing: ease-out; }
    }

    // Up/Down move along the rail, Enter/Space activate. The arrows are key
    // *character codes*, not names: U+F700 is Up and U+F701 is Down.
    key_focus := FocusScope {
        key-pressed(e) => {
            if (e.text == "\u{F700}") { root.move-focus(-1); return EventResult.accept; }
            if (e.text == "\u{F701}") { root.move-focus(1); return EventResult.accept; }
            if (e.text == "\n" || e.text == " ") {
                root.clicked();
                return EventResult.accept;
            }
            EventResult.reject
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    // `Right`, because that is the only direction with room: the rail clips its
    // children at 52px in compact mode, which is where the label tip used to die.
    property <bool> hovering: ta.has-hover;
    changed hovering => {
        if (hovering && root.compact && root.label != "") {
            // The count is in the tip because the compact dot cannot carry it: a
            // glyph and an 8 px dot are all a 52 px row has room for (U28).
            Tip.text = root.badge > 0
                ? root.label + " · " + root.badge + " 个进行中"
                : root.label;
            Tip.side = TipSide.Right;
            Tip.anchor-x = ta.absolute-position.x + root.width;
            Tip.anchor-y = ta.absolute-position.y + root.height / 2;
            Tip.visible = true;
        } else {
            Tip.visible = false;
        }
    }
}

/// Pill-shaped tag, clickable to run a search.
///
/// Round nine, U7 — roving focus. A chip row used to be *N* Tab stops: every chip
/// carried its own `FocusScope`, so a twelve-tag strip cost twelve presses before
/// the walk left it, and the strip's own scroll position never followed. The row is
/// now one stop: exactly the chip whose `index` equals the row's `cursor` is
/// focusable (`FocusScope.enabled` is the documented way to take a scope out of the
/// walk — the Fluent widgets use it for the same reason), Left/Right report a delta
/// to the row through `move-cursor`, and the chip that becomes the cursor takes the
/// focus itself. `changed cursor` is what makes that last step work without a handle
/// on a sibling inside a `for` loop: every chip sees the same new value and only the
/// match claims focus.
///
/// Defaults (`index` 0, `cursor` 0) leave a *single* chip exactly as it was — one
/// stop that Enter/Space activates — so a call site that does not know about the
/// cursor keeps today's behaviour pixel for pixel.
export component TagChip inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    /// Position of this chip inside its row, and the row's single focus cursor.
    in property <int> index: 0;
    in property <int> cursor: 0;
    callback clicked();
    /// Left/Right pressed on the cursor chip: +1 / -1. The row clamps and stores it;
    /// a chip cannot know its neighbours, exactly as `NavItem.move-focus` does.
    callback move-cursor(int);
    /// This chip took the focus from the Tab walk: the row moves its cursor here so
    /// that Left/Right continue from the chip the user actually landed on.
    callback gained-focus(int);

    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    // A cursor moved by an arrow key focuses the chip that owns it; a focus that
    // arrived from the Tab walk moves the cursor. The two are one loop on purpose:
    // the row has no other way to know which of its chips the keyboard is on.
    property <bool> held: key_focus.has-focus;
    changed held => {
        if (root.held) { root.gained-focus(root.index); }
    }

    changed cursor => {
        if (root.cursor == root.index && !root.held) {
            key_focus.focus();
        }
    }

    height: 26px;
    border-radius: Theme.radius-pill;
    border-width: 1px;
    border-color: root.active ? Theme.accent-fill : Theme.border;
    background: root.active
        ? Theme.accent-subtle
        : (ta.has-hover ? Theme.layer-alt : Theme.layer);

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        alignment: center;
        Label {
            role: TextRole.Small;
            text: root.label;
            color: root.active ? Theme.accent-ink : Theme.text-secondary;
            // A chip must never be squeezed by the strip it sits in: without this
            // the horizontal scroller compressed every chip to fit the viewport and
            // elided the labels ("…"), which also meant the strip had nothing to
            // scroll. Incompressible text gives the row its real width.
            min-width: self.preferred-width;
        }
    }

    // Same ring, same fade as AppButton's: opacity, not an `if`.
    Rectangle {
        border-radius: Theme.radius-sm;
        border-width: 2px;
        border-color: Theme.focus-ring;
        background: transparent;
        opacity: key_focus.has-focus ? 1.0 : 0.0;
        animate opacity { duration: Theme.motion-fast; easing: ease-out; }
    }

    // Every chip stays a Tab stop. Round nine tried the opposite — one stop for the
    // whole row, the rest taken out of the walk with `enabled: false` — and the
    // accessibility gate measured what that costs: seven chips per page reported
    // `IsKeyboardFocusable` but never reached by a Tab walk, because UIA publishes a
    // role-carrying node whose subtree holds a scope as focusable whether or not the
    // scope is enabled. A control the tree calls focusable and the keyboard cannot
    // reach is the worse defect, so the row keeps N stops and the cursor below only
    // decides *where the arrows go from here*.
    //
    // Left/Right are the character codes U+F702 / U+F703, never key names.
    key_focus := FocusScope {
        key-pressed(e) => {
            if (e.text == "\u{F702}") { root.move-cursor(-1); return EventResult.accept; }
            if (e.text == "\u{F703}") { root.move-cursor(1); return EventResult.accept; }
            if (e.text == "\n" || e.text == " ") {
                root.clicked();
                return EventResult.accept;
            }
            EventResult.reject
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

/// Section heading with an optional trailing action.
export component SectionHeader inherits Rectangle {
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <string> action-label: "";
    callback action();

    height: root.subtitle == "" ? 32px : 46px;

    HorizontalLayout {
        spacing: Theme.space-2;

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Label {
                role: TextRole.Title;
                emphasis: Emphasis.Semibold;
                text: root.title;
                color: Theme.text;
            }
            if root.subtitle != "" : Label {
                role: TextRole.Small;
                text: root.subtitle;
                color: Theme.text-tertiary;
            }
        }

        if root.action-label != "" : AppButton {
            label: root.action-label;
            kind: ButtonKind.Subtle;
            icon: "chevron-right";
            clicked => { root.action(); }
        }
    }
}

// ======================================================================
// Feedback
// ======================================================================

export enum InfoKind {
    Info,
    Success,
    Warning,
    Error,
}

/// WinUI InfoBar, in its inline (non-closable unless asked) form.
export component InfoBar inherits Rectangle {
    in property <InfoKind> kind: InfoKind.Info;
    in property <string> title: "";
    in property <string> message: "";
    in property <string> action-label: "";
    callback action();

    visible: root.title != "" || root.message != "";
    // One padding, not two. `body` already declares padding-top/bottom of
    // Theme.space-2, and a layout's preferred-height *includes* its own padding,
    // so the second `Theme.space-2 * 2` made every bar 16 px taller than its
    // content with all of the slack under the last line.
    height: body.preferred-height;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: (root.kind == InfoKind.Error) ? Theme.danger
        : (root.kind == InfoKind.Warning) ? Theme.warning
        : (root.kind == InfoKind.Success) ? Theme.success
        : Theme.border;
    background: (root.kind == InfoKind.Error) ? Theme.danger-subtle
        : (root.kind == InfoKind.Warning) ? Theme.warning-subtle
        : (root.kind == InfoKind.Success) ? Theme.success-subtle
        : Theme.accent-subtle;

    // Entrance, not decoration: the bar fades in when it gains content instead of
    // appearing between two frames. A bar declared inside an `if` is created at
    // its rest value (1.0, nothing to animate), which is exactly what a capture
    // must see - the animation is only ever the transition.
    opacity: (root.title != "" || root.message != "") ? 1.0 : 0.0;
    animate opacity { duration: Theme.motion-fast; easing: ease-out; }

    body := HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-2;
        padding-top: Theme.space-2;
        padding-bottom: Theme.space-2;
        spacing: Theme.space-2;

        // `height: 100%` inside `IconSlot` puts the glyph on the bar's centre
        // line even when the message wraps to two lines.
        IconSlot {
            name: (root.kind == InfoKind.Error) ? "warning"
                : (root.kind == InfoKind.Success) ? "check"
                : (root.kind == InfoKind.Warning) ? "warning"
                : "info";
            slot: Theme.icon-size;
            tint: (root.kind == InfoKind.Error) ? Theme.danger
                : (root.kind == InfoKind.Warning) ? Theme.warning
                : (root.kind == InfoKind.Success) ? Theme.success
                : Theme.accent-ink;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            if root.title != "" : Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.font-small;
                font-weight: Type.semibold;
                wrap: word-wrap;
            }
            if root.message != "" : Text {
                text: root.message;
                color: Theme.text-secondary;
                font-size: Theme.font-caption;
                wrap: word-wrap;
            }
        }

        if root.action-label != "" : AppButton {
            label: root.action-label;
            kind: ButtonKind.Subtle;
            compact: true;
            clicked => { root.action(); }
        }
    }
}

/// Determinate progress bar. `indeterminate` shows a static 30% thumb rather
/// than animating: a perpetually moving element would keep the compositor busy
/// for no information gain, which is the wrong trade for an idle desktop app.
export component ProgressBar inherits Rectangle {
    in property <float> progress: 0.0;
    in property <bool> indeterminate: false;

    height: 3px;
    border-radius: Theme.radius-pill;
    background: Theme.layer-sunken;

    Rectangle {
        x: 0px;
        width: root.indeterminate
            ? parent.width * 0.3
            : parent.width * Math.max(0.0, Math.min(1.0, root.progress));
        height: parent.height;
        border-radius: Theme.radius-pill;
        background: Theme.accent-fill;
        visible: root.indeterminate || root.progress > 0.0;
    }
}

/// One centred "still working" row: an indeterminate bar over a line of text.
///
/// `VerticalLayout { alignment: center }` does not centre a fixed-width child on
/// the cross axis - it only orders children along the main one. That is how four
/// "loading more" footers ended up with the bar hugging the left edge while their
/// label was centred: in a vertical layout a 120px `ProgressBar` sits at the
/// *start* of the row. Paired stretch spacers are the only construction in Slint
/// that actually centres a fixed-size child, so the pattern lives here once
/// instead of being re-derived - incorrectly - per page.
export component LoadingRow inherits Rectangle {
    in property <string> label: "";
    in property <length> bar-width: 120px;
    in property <length> spacing: Theme.space-2;

    height: body.preferred-height;

    body := VerticalLayout {
        alignment: center;
        spacing: root.spacing;

        HorizontalLayout {
            width: 100%;
            Rectangle { horizontal-stretch: 1; }
            ProgressBar { indeterminate: true; width: root.bar-width; }
            Rectangle { horizontal-stretch: 1; }
        }

        if root.label != "" : Label {
            role: TextRole.Caption;
            text: root.label;
            color: Theme.text-tertiary;
            horizontal-alignment: center;
        }
    }
}
export enum StateKind {
    Loading,
    Empty,
    Error,
    Locked,
}

/// The four states every page must be able to show. `Locked` is the "sign in to
/// see this" case, which is distinct from a network error and must never be
/// rendered as an empty result.
export component StateView inherits Rectangle {
    in property <StateKind> kind: StateKind.Empty;
    in property <string> title: "";
    in property <string> description: "";
    in property <string> action-label: "";
    /// Overrides the glyph derived from `kind`. A page must be able to say
    /// "nothing downloaded yet" with a download glyph instead of reusing the
    /// generic "image failed" one, which is what an empty-state here used to show.
    in property <string> glyph: "";
    callback retry();
    callback action();

    VerticalLayout {
        alignment: center;
        spacing: Theme.space-3;
        padding-top: Theme.space-6;
        padding-bottom: Theme.space-6;
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;

        // A layout's `alignment` does not centre a fixed-width child on the cross
        // axis: a glyph stays at the start of the line while its Text siblings
        // centre their own content, which is why the empty-state icon sat alone at
        // the left edge. Two stretch spacers centre it for real.
        HorizontalLayout {
            width: 100%;
            Rectangle { horizontal-stretch: 1; }
            IconPresenter {
                name: root.glyph != "" ? root.glyph
                    : (root.kind == StateKind.Loading) ? "refresh"
                    : (root.kind == StateKind.Error) ? "warning"
                    : (root.kind == StateKind.Locked) ? "key"
                    : "image-off";
                glyph-size: 28px;
                tint: root.kind == StateKind.Error ? Theme.danger : Theme.text-tertiary;
            }
            Rectangle { horizontal-stretch: 1; }
        }

        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.font-subhead;
            font-weight: Type.medium;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        if root.description != "" : Text {
            text: root.description;
            color: Theme.text-secondary;
            font-size: Theme.font-small;
            horizontal-alignment: center;
            wrap: word-wrap;
            max-width: 420px;
        }

        if root.action-label != "" : HorizontalLayout {
            width: 100%;
            Rectangle { horizontal-stretch: 1; }
            AppButton {
                label: root.action-label;
                kind: (root.kind == StateKind.Locked) ? ButtonKind.Primary : ButtonKind.Secondary;
                icon: (root.kind == StateKind.Error) ? "refresh" : ((root.kind == StateKind.Locked) ? "key" : "");
                clicked => {
                    if (root.kind == StateKind.Error) { root.retry(); }
                    else { root.action(); }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

/// Static loading placeholder. Intentionally not animated: a shimmer would wake
/// the compositor every frame for no information gain.
export component Skeleton inherits Rectangle {
    in property <length> radius: Theme.radius-md;
    height: 120px;
    border-radius: root.radius;
    background: Theme.layer-alt;
}

// ======================================================================
// Page scroll container — the fix for the clipping / stray-scrollbar class
// ======================================================================

/// A full-bleed vertical scroll area whose content is *exactly* as wide as the
/// viewport (minus a reserved gutter for the overlay scrollbar).
///
/// Why this component exists: a `ScrollView` whose content derives its width
/// from its children's preferred size inherits the widest child's minimum width.
/// One long, unwrapped `Text` or one `HorizontalLayout` of chips is then enough
/// to make the content wider than the viewport, which produces the two symptoms
/// this app used to show: a horizontal scrollbar at the bottom of the page, and
/// a grid laid out at `card-width` inside an over-wide content box, leaving a
/// large blank strip on the right.
///
/// Binding the body width to `visible-width` (the ScrollView's own width, which
/// does not depend on the content) removes that feedback path entirely.
export component PageScroll inherits Rectangle {
    in property <length> padding-x: Theme.page-padding;
    in property <length> padding-y: Theme.space-4;
    in property <length> spacing: Theme.space-4;
    in property <bool> gutter: true;
    in-out property <length> scroll-y: 0px;
    /// Width available to page content, i.e. the body minus its horizontal
    /// padding. Callers derive column counts from this instead of from the window
    /// width, so padding can never be counted twice.
    out property <length> body-width: max(0px, body.width - root.padding-x * 2);
    out property <length> body-height: body.height;
    out property <length> viewport-height: sv.visible-height;
    callback scrolled(length);
    callback width-changed(length);

    background: Theme.canvas;

    // `content-y` is written *from* the model and back only on a user scroll.
    //
    // It used to be `content-y <=> root.scroll-y`, and a two-way binding on a
    // clamped property is two owners: when the body shrank (a shorter page, a
    // narrower window, a grid that lost a column) the view clamped its own offset
    // and wrote the clamp back into `root.scroll-y`, which is the property Rust
    // reads as "where the user left this page". The stored offset was then the
    // clamp, not the reading position, and Back landed somewhere the user had
    // never been (plan §2.1 U24). One writer now: Rust restores into
    // `root.scroll-y`, the view follows, and only the user's own scroll event
    // writes the position back.
    sv := ScrollView {
        width: 100%;
        height: 100%;
        content-y: root.scroll-y;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
        scrolled => {
            root.scroll-y = sv.content-y;
            root.scrolled(sv.content-y);
        }

        body := VerticalLayout {
            width: max(0px, sv.visible-width - (root.gutter ? Theme.scrollbar-gutter : 0px));
            padding-left: root.padding-x;
            padding-right: root.padding-x;
            padding-top: root.padding-y;
            padding-bottom: root.padding-y;
            spacing: root.spacing;

            @children
        }
    }

    // Report the measured content width so Rust can compute the masonry column
    // count from what the layout actually resolved to, not from a guess at the
    // window size. This is a one-way message: nothing Rust writes back feeds
    // into `body-width`, so there is no binding loop.
    changed body-width => {
        root.width-changed(root.body-width);
    }
}

// ======================================================================
// Identity: a real avatar, always
// ======================================================================

/// A circular avatar backed by a real image.
///
/// The previous account affordance drew the first character of the user's name
/// in a coloured circle, which reads as an avatar but is not one. Every place
/// that shows a Pixiv user now uses this component: it draws the decoded image
/// when it has one, a neutral placeholder while it loads, and the initial only
/// when the image genuinely could not be fetched.
export component Avatar inherits Rectangle {
    in property <image> source;
    /// Used for the fallback initial only. Never rendered as the avatar itself.
    in property <string> fallback: "";
    /// 0 ok, 1 loading, 2 failed or absent.
    in property <int> state: 0;
    in property <length> size: 28px;
    in property <bool> ring: false;

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: Theme.layer-alt;
    border-width: root.ring ? 2px : 1px;
    border-color: root.ring ? Theme.accent-fill : Theme.border;
    clip: true;

    out property <bool> has-image: root.source.width > 0 && root.state == 0;

    Image {
        source: root.source;
        image-fit: cover;
        width: 100%;
        height: 100%;
        visible: root.has-image;
    }

    // Loading: a quiet sweep, not a flash of "已".
    if root.state == 1 && !root.has-image : Rectangle {
        background: Theme.layer-alt;
        IconPresenter {
            name: "artist";
            glyph-size: root.size * 0.5;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            tint: Theme.text-disabled;
        }
    }

    // One glyph, centred - not a word squeezed into a circle.
    //
    // `fallback` carries a whole display name (「はるいりゅ*+」), Slint 1.18 has
    // `character-count` but no `substr`, and centring an elided word rendered two
    // clipped CJK glyphs half outside the circle. The initial is therefore obtained
    // geometrically: a box exactly one character wide, centred, clipped.
    if root.state != 1 && !root.has-image : Text {
        x: (root.width - self.width) / 2;
        y: 0px;
        width: max(9px, root.size * 0.52);
        height: root.height;
        text: root.fallback == "" ? "?" : root.fallback;
        color: Theme.text-tertiary;
        font-size: max(9px, root.size * 0.42);
        font-weight: Type.semibold;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: clip;
    }
}

// ======================================================================
// Artwork card
// ======================================================================

/// Presentation model for one illustration card.
///
/// Ids are `string` because Pixiv ids exceed 32 bits and Slint's `int` is i32;
/// the raw ids would silently overflow if passed as numbers.
export struct IllustItem {
    id: string,
    title: string,
    author: string,
    author-id: string,
    cover: image,
    /// 0 illustration, 1 manga, 2 ugoira.
    kind: int,
    page-count: int,
    bookmarked: bool,
    /// 1-based position in a ranking, 0 when not ranked.
    rank: int,
    /// Intrinsic size, used to derive the card's own aspect ratio.
    width: int,
    height: int,
    /// 0 ok, 1 loading, 2 failed
    state: int,
    /// Round nine (F2): the grid is in selection mode and this card is one of
    /// the chosen ones. Both default to "an ordinary card", so every existing
    /// producer keeps working without knowing about selection.
    selected: bool,
    selectable: bool,
    /// The author's real avatar, loaded from i.pximg.net. `author-avatar-url` is
    /// kept as well so an avatar that arrives later can be matched back to the
    /// rows that want it without re-fetching a profile.
    author-avatar: image,
    author-avatar-url: string,
    /// 0 ok, 1 loading, 2 failed or absent
    author-avatar-state: int,
}

/// The bookmark toggle that floats on the cover's corner.
component BookmarkPill inherits Rectangle {
    in property <bool> marked: false;
    callback clicked();

    // A toggle, so the state travels with the name: the pill's own tooltip
    // already says "取消收藏" when marked, and `checked` carries the rest.
    accessible-role: AccessibleRole.checkbox;
    accessible-label: root.marked ? "取消收藏" : "收藏";
    accessible-checkable: true;
    accessible-checked: root.marked;
    accessible-action-default => { root.clicked(); }

    width: 28px;
    height: 28px;
    border-radius: Theme.radius-pill;
    // The surface is fixed in both themes and does not react to hover. The
    // unmarked glyph is a fixed `Theme.pill-ink` — this pill floats on somebody's
    // artwork, where the theme has no opinion, so neither colour may follow it —
    // and a hover surface that *can* equal that ink erases it: `Theme.layer` is
    // #2b2b2b in dark mode, contrast 1.00:1. Hover is carried by the border,
    // which changes nothing inside the pill and cannot reach the glyph.
    // `bookmark_pill_keeps_its_glyph_visible` in `src/uiaudit.rs` fails if this
    // surface ever becomes hover- or theme-dependent again.
    background: Theme.pill-surface;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.border-strong : transparent;

    IconPresenter {
        name: "follow";
        glyph-size: 14px;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        // Filled-in is impossible with a stroke-only path set, so "marked" is
        // signalled by colour alone: no layout shift, no glyph swap. Both inks are
        // fixed, because the surface under them is: `accent-fill` is #4cb0f5 in dark
        // mode and reaches 2.38:1 on the near-white pill, so the marked state uses
        // `pill-ink-marked` (5.07:1 in both themes).
        tint: root.marked ? Theme.pill-ink-marked : Theme.pill-ink;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    property <bool> hovering: ta.has-hover;
    changed hovering => {
        if (hovering) {
            Tip.text = root.marked ? "取消收藏" : "收藏";
            Tip.side = TipSide.Above;
            Tip.anchor-x = ta.absolute-position.x + root.width / 2;
            Tip.anchor-y = ta.absolute-position.y;
            Tip.visible = true;
        } else {
            Tip.visible = false;
        }
    }
}

/// An artwork card: the cover at its true aspect ratio, then a two-line caption.
///
/// Height is *exactly* `width * clamped-aspect + caption`, which is the same
/// formula `src/layout.rs` uses to balance the masonry columns. Keeping the two
/// in sync is what makes the columns end ragged-but-even instead of jumping.
///
/// Hit-testing note: Slint hit-tests in reverse declaration order, so the card's
/// open-on-click `TouchArea` is declared **first** here. When it was declared last
/// it covered the bookmark pill, and the pill was unclickable — every click on the
/// heart opened the artwork instead.
export component IllustCard inherits Rectangle {
    in property <IllustItem> item;
    in property <bool> show-author: true;
    /// Column width; the card sizes itself from it.
    in property <length> column-width: 220px;
    /// Pinned cover height; `0px` keeps the cover derived from the column width.
    ///
    /// The grid needs the derived form: `src/layout.rs` balances the masonry
    /// columns against `width * clamped-aspect`, so a card in a column must keep
    /// exactly that height. A single-row strip has nothing to balance and may
    /// state the cover instead — Pixiv serves 1.4–1.6 aspects, so at 140 px the
    /// derived cover alone is 196–224 px, taller than the strip's box, and the
    /// caption band (title, author, avatar) began below it and was clipped away.
    in property <length> cover-height-override: 0px;
    callback open();
    callback open-author();
    callback toggle-bookmark();
    /// Round nine (F2), the frozen seam: the grid is in selection mode and this
    /// card is one of the chosen ones. `in-out` because the grid owns the
    /// optimistic set while the round trip runs; `selected` defaults to false, so
    /// every existing producer keeps drawing an ordinary card.
    in-out property <bool> selected: false;
    /// The pointer gesture, modifiers included. Fired on every click; the card only
    /// opens the artwork itself when it is *not* selectable, so a click in selection
    /// mode is a selection report and never a navigation.
    callback clicked-with(bool, bool);
    /// Round nine (U3): this card took the keyboard focus from the Tab walk. Slint
    /// 1.18 has no `scroll-into-view`, so the page reports the event and Rust — the
    /// only owner of the column heights and the viewport — scrolls it into view.
    /// Nothing here scrolls: a card does not know where it sits.
    ///
    /// Round eleven (U-f) added the argument: `root.y` is this card's offset inside
    /// its own column, which is the only part of the content-space position a card
    /// can know. `ArtworkGrid` adds its own `y` and hands the page a number in the
    /// scroll body's coordinates, so the shell can put the focused card on screen
    /// instead of only reporting that it was focused.
    callback gained-focus(length);

    // A card is one list item whose name is the caption it already draws, so a
    // screen reader reads "标题 · 作者" and can open it, instead of walking a
    // dozen unrelated Text nodes with no ordering and no action between them.
    accessible-role: AccessibleRole.list-item;
    accessible-label: root.show-author && root.item.author != ""
        ? root.item.title + " · " + root.item.author
        : root.item.title;
    accessible-action-default => { root.open(); }

    // Clamp to a sane band: a 1:6 banner and a 6:1 panorama both stay usable.
    out property <float> clamped-aspect:
        (root.item.width <= 0 || root.item.height <= 0)
            ? 1.0
            : Math.max(0.55, Math.min(1.6, root.item.height * 1.0 / (root.item.width * 1.0)));

    out property <length> cover-height: root.cover-height-override > 0px
        ? root.cover-height-override
        : Math.max(48px, root.column-width * root.clamped-aspect);
    width: root.column-width;
    height: root.cover-height + Theme.card-caption-height;

    // Keyboard focus lives *under* the click target. Slint hit-tests in reverse
    // declaration order, so a FocusScope declared after a TouchArea is the topmost
    // input element and swallows the first press to take focus — the card then
    // needs two clicks to open. Every other primitive here (AppButton, IconButton,
    // NavItem, TagChip) is already ordered this way; the rule in `uiaudit` keeps
    // it that way.
    key_focus := FocusScope {
        key-pressed(e) => {
            if (e.text == "\n" || e.text == " ") {
                root.open();
                return EventResult.accept;
            }
            // U27: the author link is a pointer target, so it needs a keyboard path
            // too — and it may not cost a second Tab stop per card (a 40-card grid is
            // already 40 stops). The card is the stop; 'a' opens its author. Guarded
            // against the modifiers the shell already uses: Ctrl+A is select-all and
            // must reach the window, not the card.
            if (e.text == "a" && !e.modifiers.control && !e.modifiers.alt
                && !e.modifiers.shift && root.show-author) {
                root.open-author();
                return EventResult.accept;
            }
            EventResult.reject
        }
    }

    // The focus event itself, as a property: `changed` cannot watch a function, and
    // `has-focus` is the only signal Slint exposes for "the walk arrived here".
    property <bool> held: key_focus.has-focus;
    changed held => {
        if (root.held) { root.gained-focus(root.y); }
    }

    // Open-on-click, underneath every interactive child.
    //
    // F2: in selection mode the same gesture is a selection report instead of a
    // navigation — WinUI list items behave exactly like this, and opening thirty
    // works because a modifier never arrived would be the worse failure. `selectable`
    // is false by default, so today's single behaviour is untouched.
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked-with(false, false);
            if (!root.item.selectable) { root.open(); }
        }
        double-clicked => { root.open(); }
    }

    VerticalLayout {
        spacing: 0px;

        cover_box := Rectangle {
            height: root.cover-height;
            border-radius: Theme.radius-lg;
            clip: true;
            background: Theme.layer-alt;

            Image {
                source: root.item.cover;
                image-fit: cover;
                width: 100%;
                height: 100%;
                // Fades in when its decode lands (`state` 1 -> 0) instead of popping
                // into a finished card. Rest is 1.0 for a loaded cover, and the
                // loading/failed overlays paint over it anyway, so the rest pixels are
                // the ones the card already had.
                opacity: root.item.state == 0 ? 1.0 : 0.0;
                animate opacity { duration: Theme.motion; easing: ease-out; }
            }

            // Loading / failure overlays so a card is never an empty hole.
            if root.item.state == 1 : Rectangle {
                background: Theme.layer-alt;
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        width: 100%;
                        Rectangle { horizontal-stretch: 1; }
                        IconPresenter {
                            name: "image-off";
                            glyph-size: Theme.icon-size-lg;
                            tint: Theme.text-disabled;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
            if root.item.state == 2 : Rectangle {
                background: Theme.layer-alt;
                VerticalLayout {
                    alignment: center;
                    spacing: Theme.space-1;
                    HorizontalLayout {
                        width: 100%;
                        Rectangle { horizontal-stretch: 1; }
                        IconPresenter {
                            name: "warning";
                            glyph-size: Theme.icon-size-lg;
                            tint: Theme.text-tertiary;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Label {
                        role: TextRole.Caption;
                        text: "加载失败";
                        color: Theme.text-tertiary;
                        horizontal-alignment: center;
                    }
                }
            }

            // Hover: a soft scrim inside the cover. It cannot reflow anything and
            // it is drawn under the pill and the badges.
            Rectangle {
                background: ta.has-hover ? Theme.artwork-hover : transparent;
                border-radius: Theme.radius-lg;
            }

            // Ranking position, top-left, only where it means something.
            if root.item.rank > 0 : Rectangle {
                x: Theme.space-2;
                y: Theme.space-2;
                width: rank-label.width + 10px;
                height: 20px;
                border-radius: Theme.radius-sm;
                background: root.item.rank <= 3 ? Theme.accent-fill : Theme.artwork-scrim;

                rank-label := Text {
                    x: 5px;
                    y: 0px;
                    height: parent.height;
                    text: "#" + root.item.rank;
                    // `on-accent`, not `#ffffff`: on `accent-fill` the two are not
                    // interchangeable. Dark accent-fill is #4cb0f5, where white
                    // measures 2.38:1 and on-accent (#101010) measures 8.01:1 — the
                    // pair those tokens exist for. The other branch is
                    // `artwork-ink` on `artwork-scrim` — an artwork overlay, which must
                    // not follow the theme.
                    color: root.item.rank <= 3 ? Theme.on-accent : Theme.artwork-ink;
                    font-size: Theme.font-caption;
                    font-weight: Type.semibold;
                    vertical-alignment: center;
                }
            }

            // Type badge, top-right: only for multi-page, manga and ugoira.
            if root.item.page-count > 1 || root.item.kind != 0 : Rectangle {
                x: parent.width - self.width - Theme.space-2;
                y: Theme.space-2;
                width: type-label.width + 10px;
                height: 20px;
                border-radius: Theme.radius-sm;
                background: Theme.artwork-scrim;

                type-label := Text {
                    x: 5px;
                    y: 0px;
                    height: parent.height;
                    text: (root.item.kind == 1) ? "漫画"
                        : (root.item.kind == 2) ? "动图"
                        : ("共" + root.item.page-count + "张");
                    color: Theme.artwork-ink;
                    font-size: Theme.font-caption;
                    font-weight: Type.medium;
                    vertical-alignment: center;
                }
            }

            // Round nine, U28's sibling in F2 — WinUI's list-item selection, not a
            // badge of our own invention: a 22 px check in the tile's top-left. The
            // unchecked form is a solid `layer` chip with a `border-strong` stroke so
            // it reads on any artwork; the checked form is `accent-fill` with the
            // `on-accent` glyph pair, which is the only ink that is legible on it
            // (white on the light-mode fill is 5.07:1, on-accent is the token).
            if root.item.selectable : Rectangle {
                x: Theme.space-2;
                y: Theme.space-2;
                width: Theme.select-check;
                height: Theme.select-check;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: root.selected ? Theme.accent-fill : Theme.border-strong;
                background: root.selected ? Theme.accent-fill : Theme.layer;

                if root.selected : IconPresenter {
                    name: "check";
                    glyph-size: 14px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    tint: Theme.on-accent;
                }
            }

            BookmarkPill {
                x: parent.width - self.width - Theme.space-2;
                y: parent.height - self.height - Theme.space-2;
                marked: root.item.bookmarked;
                clicked => { root.toggle-bookmark(); }
            }
        }

        // Caption band: a fixed 44px, which is exactly what `card_height()` in
        // src/layout.rs assumes when balancing the columns.
        Rectangle {
            height: Theme.card-caption-height;

            Label {
                role: TextRole.Small;
                emphasis: Emphasis.Medium;
                x: 0px;
                y: 4px;
                width: parent.width;
                height: 18px;
                text: root.item.title;
                color: Theme.text;
            }
            if root.show-author : Rectangle {
                x: 0px;
                y: 22px;
                width: parent.width;
                height: 18px;
                // U27: the link is a bare `TouchArea` no more. The role and the name
                // sit on the row — the same shape the account affordance in
                // `main.slint` uses, and for the same reason: UIA publishes the node
                // that carries the role, and the row is the cell that holds the avatar,
                // the handle and the pointer target. Slint 1.18's `AccessibleRole` has
                // no `link` member (checked against i-slint-common 1.18.1; the enum is
                // None…RadioGroup plus landmarks), so the role is `Button` — the only
                // one that means "invokable" — and the name says what it opens.
                accessible-role: AccessibleRole.button;
                accessible-label: root.item.author == ""
                    ? "作者" : "作者：" + root.item.author;
                accessible-action-default => { root.open-author(); }

                Avatar {
                    x: 0px;
                    y: 0px;
                    size: Theme.icon-size;
                    source: root.item.author-avatar;
                    state: root.item.author-avatar-state;
                    fallback: root.item.author;
                    border-width: 0px;
                }
                Label {
                    role: TextRole.Caption;
                    x: 21px;
                    y: 0px;
                    width: max(0px, parent.width - 21px);
                    text: root.item.author;
                    color: Theme.text-tertiary;
                }
                // The author's own hit target, declared last so it wins the
                // hit-test against the card's open-on-click area.
                author-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-author(); }
                }
                property <bool> hovering: author-ta.has-hover;
                changed hovering => {
                    if (hovering && root.item.author != "") {
                        Tip.text = root.item.author;
                        Tip.side = TipSide.Above;
                        Tip.anchor-x = author-ta.absolute-position.x + author-ta.width / 2;
                        Tip.anchor-y = author-ta.absolute-position.y;
                        Tip.visible = true;
                    } else {
                        Tip.visible = false;
                    }
                }
            }
        }
    }

    // The selected state's ring: 2 px of `accent-fill` around the whole item, cover
    // and caption, which is what WinUI draws on a selected ListView item. Declared
    // above the focus ring so that a card which is both selected and focused still
    // shows the focus ring — the keyboard cursor must never be the invisible half.
    // `accent-fill`, never `Theme.accent`: the brand colour is 3.11:1 on a card and
    // `uiaudit` rejects it outside the wordmark.
    Rectangle {
        border-radius: Theme.radius-lg;
        border-width: Theme.select-ring;
        border-color: Theme.accent-fill;
        background: transparent;
        opacity: root.selected ? 1.0 : 0.0;
    }

    // Declared last so the ring is not painted over by the cover: a card that can
    // be opened is a keyboard stop too, and a stop with no ring is invisible.
    // Same ring, same fade as AppButton's: opacity, not an `if`.
    Rectangle {
        border-radius: Theme.radius-sm;
        border-width: 2px;
        border-color: Theme.focus-ring;
        background: transparent;
        opacity: key_focus.has-focus ? 1.0 : 0.0;
        animate opacity { duration: Theme.motion-fast; easing: ease-out; }
    }
}

// ======================================================================
// Settings pieces (shared with the download page's "where do files go" block)
// ======================================================================

/// A titled group of rows, as in the Win11 Settings app.
export component SettingsCard inherits Rectangle {
    in property <string> title: "";
    in property <string> description: "";
    in property <string> icon: "";

    border-radius: Theme.radius-lg;
    background: Theme.layer;
    border-width: 1px;
    border-color: Theme.border;
    // A card is exactly as tall as its rows. Without this the card is the only
    // flexible child of a page body that is stretched to the viewport, so it
    // silently absorbs all the leftover space and two lines of text end up
    // floating in a 280px-tall box.
    height: card-body.preferred-height;

    card-body := VerticalLayout {
        padding-top: Theme.space-3;
        padding-bottom: Theme.space-3;
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        spacing: Theme.space-2;

        HorizontalLayout {
            spacing: Theme.space-3;
            height: max(24px, title-block.preferred-height);

            if root.icon != "" : IconSlot {
                name: root.icon;
                slot: Theme.icon-size-lg;
                glyph-size: Theme.icon-size-lg;
                tint: Theme.accent-fill;
            }

            title-block := VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Label {
                    role: TextRole.Subhead;
                    emphasis: Emphasis.Semibold;
                    text: root.title;
                    color: Theme.text;
                }
                if root.description != "" : Text {
                    text: root.description;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-caption;
                    wrap: word-wrap;
                }
            }
        }

        @children
    }
}

/// Label (and optional hint) on the left, control on the right.
///
/// The control column is capped both absolutely (`control-width`) and relatively
/// (46% of the card), so at 640px the label keeps a usable width and the hint
/// wraps instead of being clipped. That relative cap replaces the fixed 168px
/// column which used to push the whole settings card past the viewport.
export component SettingsRow inherits Rectangle {
    in property <string> label: "";
    in property <string> hint: "";
    in property <length> control-width: 200px;
    in property <length> available-width: 640px;

    out property <length> actual-control-width:
        Math.min(root.control-width, Math.max(76px, root.available-width * 0.46));

    height: max(Theme.control-height, row-layout.preferred-height);

    row-layout := HorizontalLayout {
        spacing: Theme.space-3;
        // No `alignment` here on purpose. Setting it on a horizontal layout makes
        // the row pack its children at their preferred widths, which drops the
        // stretch of the label column and parks the control in the middle of the
        // card instead of at its right edge. Unset, the label column stretches and
        // the control sits where a settings row should.

        VerticalLayout {
            spacing: 2px;
            alignment: start;
            horizontal-stretch: 1;
            // `alignment: center` here would be *cross-axis* centering: each Text
            // would shrink to its own width and float in the middle of the label
            // column, which is what put settings labels ~180px in from the card
            // edge. Labels are left-aligned; only their inline box is centred.
            Label {
                text: root.label;
                color: Theme.text;
            }
            if root.hint != "" : Text {
                text: root.hint;
                color: Theme.text-tertiary;
                font-size: Theme.font-caption;
                wrap: word-wrap;
            }
        }

        Rectangle {
            width: root.actual-control-width;
            height: max(Theme.control-height, control-slot.preferred-height);
            VerticalLayout {
                control-slot := HorizontalLayout {
                    alignment: end;
                    @children
                }
            }
        }
    }
}

/// Presentation model for a tag Pixiv recommends.
export struct RecommendTagItem {
    /// The tag as Pixiv spells it, which is what a search must submit.
    name: string,
    /// What to render: the translation when Pixiv sent one.
    label: string,
    emphasized: bool,
}

/// Presentation model for a user Pixiv recommends.
export struct RecommendUserItem {
    id: string,
    name: string,
    account: string,
    comment: string,
    avatar: image,
    avatar-url: string,
    preview: image,
    followed: bool,
    premium: bool,
    /// 0 ok, 1 loading, 2 failed or absent
    avatar-state: int,
}

/// One row of the search-suggestion panel.
export struct SuggestionItem {
    /// What gets searched when this row is chosen.
    tag: string,
    /// What is rendered: the translation, when there is one.
    label: string,
    /// Formatted work count, empty when Pixiv reported none.
    count: string,
    /// True for a local search-history row. Rendered differently on purpose:
    /// local history must never look like a Pixiv suggestion.
    local: bool,
    /// True for the row the keyboard cursor is on.
    active: bool,
}

/// A labelled figure on the profile header.
export struct ProfileStatItem {
    label: string,
    value: string,
}

/// A rounded tile that shows a recommended artist: real avatar, name, handle,
/// comment and a preview of their work.
export component UserCard inherits Rectangle {
    in property <RecommendUserItem> item;
    in property <length> card-width: 220px;
    callback open();

    accessible-role: AccessibleRole.list-item;
    accessible-label: root.item.account != ""
        ? root.item.name + " · @" + root.item.account
        : root.item.name;
    accessible-action-default => { root.open(); }

    width: root.card-width;
    height: Theme.artist-strip-height;
    border-radius: Theme.radius-lg;
    background: hover.has-hover ? Theme.layer : Theme.layer-alt;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    // Under the click target, for the reason given on IllustCard above.
    key_focus := FocusScope {
        key-pressed(e) => {
            if (e.text == "\n" || e.text == " ") {
                root.open();
                return EventResult.accept;
            }
            EventResult.reject
        }
    }

    // Open-on-click first, so the follow button declared later wins.
    hover := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }
    }

    Rectangle {
        // The preview is the tile's cover. It is always declared and its opacity is
        // the entrance: no `if` that can pop, and the rest value is 0.5 (the tile's
        // own wash) with a preview, 0 without one - the same pixels the old
        // conditional left behind.
        x: parent.width - 96px;
        y: 0px;
        width: 96px;
        height: 100%;
        opacity: root.item.preview.width > 0 ? 0.5 : 0.0;
        animate opacity { duration: Theme.motion; easing: ease-out; }
        clip: true;
        Image {
            source: root.item.preview;
            image-fit: cover;
            width: 100%;
            height: 100%;
        }
    }

    VerticalLayout {
        padding: Theme.space-3;
        // The 96 px preview is placed at `parent.width - 96px` and nothing used to
        // reserve it, so at the default 210 px tile the text column spanned 12-198
        // over a preview at 114-210: 84 px of every name, handle and comment was
        // painted on the artwork at half opacity. Reserving the preview plus one
        // gutter keeps the two columns apart without changing the tile's width or
        // Theme.artist-strip-height.
        padding-right: Theme.space-3 + 96px;
        spacing: Theme.space-2;

        HorizontalLayout {
            spacing: Theme.space-2;
            Avatar {
                size: 36px;
                source: root.item.avatar;
                state: root.item.avatar-state;
                fallback: root.item.name;
            }
            VerticalLayout {
                spacing: 0px;
                horizontal-stretch: 1;
                Label {
                    role: TextRole.Small;
                    emphasis: Emphasis.Semibold;
                    text: root.item.name;
                    color: Theme.text;
                }
                Label {
                    role: TextRole.Caption;
                    text: root.item.account == "" ? "" : "@" + root.item.account;
                    color: Theme.text-tertiary;
                }
            }
        }

        Text {
            text: root.item.comment;
            color: Theme.text-secondary;
            font-size: Theme.font-caption;
            wrap: word-wrap;
            max-height: 32px;
            overflow: elide;
        }

        // Round nine, U11 — `RecommendUserItem.followed` and `.premium` existed and
        // nothing read them: a tile looked identical whether you already followed the
        // artist or they had a paid account. Both markers are drawn in one 18 px row
        // under the bio, because the tile is 132 px tall and the text column is 90 px
        // wide (210 - 12 - 12 - 96 reserved for the preview): an 18 px chip for
        // 「已关注」fits that column, and `Premium` as a word does not, so the paid
        // marker is the 18 x 18 sparkle tile the rest of the shell uses for
        // 「推荐」. Both are conditional, so a tile whose fields are false is byte for
        // byte the tile it was before — this row does not exist for it.
        if root.item.followed || root.item.premium : HorizontalLayout {
            spacing: Theme.space-1;
            alignment: start;

            if root.item.followed : Badge {
                label: "已关注";
                fill: Theme.accent-subtle;
                ink: Theme.accent-ink;
            }

            if root.item.premium : Rectangle {
                width: 18px;
                height: 18px;
                border-radius: Theme.radius-sm;
                background: Theme.warning-subtle;

                IconPresenter {
                    name: "sparkle";
                    glyph-size: 12px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    tint: Theme.warning;
                }
            }
        }
    }

    // Same ring, same fade as AppButton's: opacity, not an `if`.
    Rectangle {
        border-radius: Theme.radius-sm;
        border-width: 2px;
        border-color: Theme.focus-ring;
        background: transparent;
        opacity: key_focus.has-focus ? 1.0 : 0.0;
        animate opacity { duration: Theme.motion-fast; easing: ease-out; }
    }
}
// ======================================================================
// Round nine: multi-select bar (F2), SplitButton menu (F4)
// ======================================================================

/// The floating batch-action bar a selection mode shows along the bottom of a
/// grid page (F2). Fluent's ListView puts the count and the verbs in one 48 px
/// bar over the content; the surface is `layer` with `shadow-2`, because a bar
/// that floats over artwork may not be translucent (a scrim would read as a
/// disabled control) and the theme has no acrylic token.
///
/// Nothing here is wired to Rust by the UI: `count` and the four callbacks are the
/// page's, and every one of them defaults to "no selection", which is why an
/// unwired bar is never drawn at all (`selection-mode` is false by default).
export component BatchBar inherits Rectangle {
    in property <int> count: 0;
    in property <bool> busy: false;
    callback select-all();
    callback clear-selection();
    callback batch-download();
    callback batch-bookmark();
    /// Leave selection mode. Not in the frozen contract because it needs no Rust:
    /// the page owns `selection-mode`, exactly as it owns the header toggle the
    /// plan names as the fallback when modifiers do not arrive.
    callback close();

    height: 48px;
    border-radius: Theme.radius-md;
    background: Theme.layer;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 16px;
    drop-shadow-color: Theme.shadow-2;
    drop-shadow-offset-y: 2px;

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-2;
        spacing: Theme.space-2;
        alignment: start;

        Label {
            role: TextRole.Small;
            emphasis: Emphasis.Semibold;
            // The count is the only thing in the bar that may shrink: every button
            // keeps its own width, so a narrow page never elides a verb.
            text: "已选择 " + root.count + " 项";
            color: Theme.text;
            min-width: 64px;
        }

        Rectangle { horizontal-stretch: 1; }

        AppButton {
            label: "全选";
            icon: "check";
            kind: ButtonKind.Subtle;
            compact: true;
            row-height: 48px;
            enabled: !root.busy;
            clicked => { root.select-all(); }
        }
        AppButton {
            label: "下载";
            icon: "downloads";
            kind: ButtonKind.Primary;
            compact: true;
            row-height: 48px;
            enabled: root.count > 0 && !root.busy;
            clicked => { root.batch-download(); }
        }
        AppButton {
            label: "收藏";
            icon: "follow";
            compact: true;
            row-height: 48px;
            enabled: root.count > 0 && !root.busy;
            clicked => { root.batch-bookmark(); }
        }
        AppButton {
            label: "取消选择";
            icon: "dismiss";
            kind: ButtonKind.Subtle;
            compact: true;
            row-height: 48px;
            enabled: root.count > 0 && !root.busy;
            clicked => { root.clear-selection(); }
        }
        AppButton {
            label: "完成";
            icon: "close";
            kind: ButtonKind.Subtle;
            compact: true;
            row-height: 48px;
            clicked => { root.close(); }
        }
    }
}

/// One row of a `BookmarkMenu`. `menu-row-height` (32 px) and `menu-width` (200 px)
/// are the Fluent MenuFlyout metrics, declared once in the theme.
component MenuRow inherits Rectangle {
    in property <string> label: "";
    in property <bool> checked: false;
    in property <bool> cursor-on: false;
    in property <bool> destructive: false;
    callback activated();

    // A menu row is one action. The flyout owns the single FocusScope and the
    // cursor (see `BookmarkMenu`), so this row is a named, invokable node with no
    // Tab stop of its own — the same shape the rail's entries have under the
    // window's Up/Down hand-off.
    // `accessible-role` has to be a compile-time constant (Slint rejects a ternary
    // here), so the role is `button` for every row and the restriction rows carry
    // their state through the checkable/checked pair instead.
    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-checkable: root.checked;
    accessible-checked: root.checked;
    accessible-action-default => { root.activated(); }

    height: Theme.menu-row-height;
    background: root.cursor-on ? Theme.accent-subtle : (ta.has-hover ? Theme.layer-alt : transparent);

    HorizontalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;
        spacing: Theme.space-2;
        alignment: start;

        // A fixed 14 px column, drawn or not: a check column that appears and
        // disappears would re-align every label depending on which restriction is
        // in force.
        Rectangle {
            width: Theme.menu-metric-check;
            height: 100%;
            IconSlot {
                name: "check";
                slot: Theme.menu-metric-check;
                glyph-size: Theme.menu-metric-glyph;
                tint: Theme.accent-ink;
                opacity: root.checked ? 1.0 : 0.0;
            }
        }

        Label {
            role: TextRole.Small;
            text: root.label;
            color: root.destructive ? Theme.danger : (root.checked ? Theme.accent-ink : Theme.text);
            horizontal-stretch: 1;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}

/// The bookmark control's MenuFlyout (F4): the two restrictions `set_bookmark`
/// already accepts, plus removal when the work is bookmarked.
///
/// Two rows are always present and a third only when `bookmarked`, so Up/Down needs
/// a clamp against `rows` — and one FocusScope, because a menu that put a Tab stop
/// on every row would turn a three-row flyout into three presses. Escape closes it,
/// as the plan's state machine says.
export component BookmarkMenu inherits Rectangle {
    /// 0 public / 1 private, from the reply — never from the click.
    in property <int> restrict: 0;
    in property <bool> bookmarked: false;
    callback pick(int);
    callback remove();
    callback closed();

    out property <int> rows: root.bookmarked ? 3 : 2;
    in-out property <int> active: 0;

    public function take-focus() { menu-focus.focus(); }
    /// Move the cursor over the rows that exist.
    public function step(delta: int) {
        root.active = Math.max(0, Math.min(root.rows - 1, root.active + delta));
    }
    public function activate() {
        if (root.active == 0) { root.pick(0); }
        else if (root.active == 1) { root.pick(1); }
        else { root.remove(); }
    }

    width: Theme.menu-width;
    height: menu-body.preferred-height + Theme.space-1 * 2;
    border-radius: Theme.radius-lg;
    background: Theme.flyout;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: 16px;
    drop-shadow-color: Theme.shadow-2;
    drop-shadow-offset-y: 4px;

    menu-body := VerticalLayout {
        padding-top: Theme.space-1;
        padding-bottom: Theme.space-1;
        spacing: 0px;

        MenuRow {
            label: "公开收藏";
            checked: root.restrict == 0;
            cursor-on: root.active == 0;
            activated => { root.pick(0); }
        }
        MenuRow {
            label: "仅自己可见";
            checked: root.restrict == 1;
            cursor-on: root.active == 1;
            activated => { root.pick(1); }
        }
        if root.bookmarked : Divider { }
        if root.bookmarked : MenuRow {
            label: "取消收藏";
            cursor-on: root.active == 2;
            destructive: true;
            activated => { root.remove(); }
        }
    }

    // Up/Down/Escape/Enter. Character codes, never key names: U+001B is Escape,
    // U+F700 Up, U+F701 Down. The scope is declared after the rows and there is no
    // TouchArea in this component, so the hit-test order rule does not apply here.
    // U21: `take-focus` had no caller, so the scope below never held the focus the
    // Up/Down/Escape/Enter handler it owns was written for — the flyout was
    // pointer-only and the shell's Escape had nothing of its own to close. The menu
    // is created when it opens (`if root.restrict-open`), so `init` is the moment
    // it becomes real: one line, in the component that owns the scope.
    init => { root.take-focus(); }

    menu-focus := FocusScope {
        key-pressed(e) => {
            if (e.text == "\u{F700}") { root.step(-1); return EventResult.accept; }
            if (e.text == "\u{F701}") { root.step(1); return EventResult.accept; }
            if (e.text == "\u{001b}") { root.closed(); return EventResult.accept; }
            if (e.text == "\n" || e.text == " ") { root.activate(); return EventResult.accept; }
            EventResult.reject
        }
    }
}

