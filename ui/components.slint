// Fluent 2 / WinUI 3 primitives shared by every page.
//
// Rules encoded here so pages cannot get them wrong:
//   * Hover/press feedback changes `background` only, never geometry. A bookmark
//     toggle must not shift the card underneath it.
//   * Every interactive element has Normal / Hover / Pressed / Focused /
//     Disabled states, a pointer cursor, and a real click target.
//   * Nothing is sized to a magic pixel value that would clip at 150% DPI; the
//     numbers come from `theme.slint` and the 4px spacing grid.
//   * Text that can be long is either elided or wrapped. A bare `Text` in a
//     layout reports its *full* string width as a minimum, which is the root
//     cause of the horizontal-scrollbar/blank-space class of bugs — so every
//     text node here has an explicit width or an overflow policy.

import { Theme, Type } from "theme.slint";
import { FluentGlyph } from "icons.slint";
import { ScrollView } from "std-widgets.slint";

// ======================================================================
// Icons — the one place a glyph is positioned
// ======================================================================

// Two measured facts drive the whole icon layer. Neither is guessable from a
// Slint declaration, which is why they are written down here:
//
//  1. `Path` places itself at `x: 0; y: 0`. `FluentIcon` gives it a size but not
//     a position, so a 16px glyph inside a 32px button used to sit in the
//     button's top-left corner — 8px right and 8px down of centre.
//  2. A child of a `HorizontalLayout` with a *fixed* height is aligned to the
//     start of the cross axis, not centred. Measured on the navigation rail: every
//     glyph's centre sat 15.5 physical px (10.3 logical px at 150 % DPI) above the
//     centre line of its row, while the `Text` siblings — which fill the row and
//     centre their own baseline — were within 1px.
//
// So: no call site hands a glyph a bare size again. Either it hands it a box
// (`IconPresenter` centres inside a box the caller owns) or it hands it a row
// (`IconSlot` claims the full cross axis and centres inside that).

/// One Fluent glyph, centred inside its own square box.
///
/// The box may be larger than the glyph (`glyph-size`), which is what makes a
/// 13px heart sit in the middle of a 28px pill without a magic offset.
export component IconPresenter inherits Rectangle {
    in property <string> name: "";
    in property <length> glyph-size: Theme.icon-size;
    in property <color> tint: Theme.text;
    in property <bool> enabled: true;

    width: root.glyph-size;
    height: root.glyph-size;
    background: transparent;

    FluentGlyph {
        name: root.name;
        width: root.glyph-size;
        height: root.glyph-size;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        tint: root.tint;
        opacity: root.enabled ? 1.0 : 0.4;
    }
}

/// A glyph on the centre line of whatever row it is placed in.
///
/// `height: 100%` is load-bearing: it is the only way to make a fixed-size child
/// of a horizontal layout claim the cross axis. `slot` reserves a fixed column so
/// that icon+label rows keep their labels on one shared vertical rule no matter
/// how wide an individual glyph's ink happens to be.
export component IconSlot inherits Rectangle {
    in property <string> name: "";
    in property <length> glyph-size: Theme.icon-size;
    in property <length> slot: Theme.icon-size;
    in property <color> tint: Theme.text;
    in property <bool> enabled: true;

    width: root.slot;
    height: 100%;
    background: transparent;

    FluentGlyph {
        name: root.name;
        width: root.glyph-size;
        height: root.glyph-size;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        tint: root.tint;
        opacity: root.enabled ? 1.0 : 0.4;
    }
}

// ======================================================================
// Small overlays
// ======================================================================

/// Minimal hover hint. Slint's built-in `Tooltip` takes `styled-text`, which
/// cannot be fed a dynamic `string` without markdown wrapping, so the app uses
/// this fully-themeable equivalent instead.
///
/// `placement` matters: the top command bar is only 48px tall and a tip drawn
/// *above* a button there lands outside the window, where it is silently
/// invisible. Chrome near the top of the window therefore passes `below`.
export enum TipPlacement {
    Above,
    Below,
    Right,
}

export component HoverTip inherits Rectangle {
    in property <string> tip: "";
    in property <bool> show: false;
    in property <length> max-tip-width: 300px;
    in property <TipPlacement> placement: TipPlacement.Above;

    visible: root.show && root.tip != "";
    height: 24px;
    width: Math.min(label.preferred-width + Theme.space-3 * 2, root.max-tip-width);
    border-radius: Theme.radius-sm;
    background: Theme.tip-surface;
    border-width: 1px;
    border-color: Theme.tip-border;
    drop-shadow-blur: 8px;
    drop-shadow-color: Theme.shadow-2;
    drop-shadow-offset-y: 2px;

    label := Text {
        x: Theme.space-3;
        y: (root.height - self.height) / 2;
        width: root.width - Theme.space-3 * 2;
        text: root.tip;
        color: Theme.tip-ink;
        font-size: Theme.font-caption;
        vertical-alignment: center;
        overflow: elide;
    }
}

// ======================================================================
// Buttons
// ======================================================================

export enum ButtonKind {
    Primary,
    Secondary,
    Subtle,
    Danger,
}

/// Fluent button: 32px tall, 4px radius, 1px stroke for the secondary variant,
/// accent fill for the primary one. Focusable and operable with Enter/Space.
export component AppButton inherits Rectangle {
    in property <string> label: "";
    in property <ButtonKind> kind: ButtonKind.Secondary;
    /// A FluentGlyph name; empty for no icon.
    in property <string> icon: "";
    in property <bool> compact: false;
    in property <bool> enabled: true;
    /// Visual height. Ignored when `row-height` is set.
    in property <length> visual-height: 0px;
    /// Set to the height of the enclosing bar to let the button claim the whole
    /// cross axis and centre its own pill, instead of being top-aligned by the
    /// surrounding horizontal layout.
    in property <length> row-height: 0px;
    callback clicked();

    out property <length> button-height:
        root.visual-height > 0px ? root.visual-height
            : (root.compact ? Theme.control-height-sm : Theme.control-height);

    height: root.row-height > 0px ? root.row-height : root.button-height;
    // Hug the label, with a floor for icon-only and short labels. Without an
    // explicit width a button is a stretch candidate in any enclosing layout,
    // which is how "换一批" ended up as a 600px white slab across the home hero
    // with its label floating in the middle.
    width: max(root.compact ? 40px : 64px, content.preferred-width);
    background: transparent;

    fill := Rectangle {
        y: (root.height - root.button-height) / 2;
        height: root.button-height;
        border-radius: Theme.radius-sm;
        border-width: (root.kind == ButtonKind.Secondary) ? 1px : 0px;
        border-color: ta.has-hover ? Theme.border-strong : Theme.border;
        background: (root.kind == ButtonKind.Primary)
            ? (ta.pressed ? Theme.accent-pressed : (ta.has-hover ? Theme.accent-hover : Theme.accent))
            : (root.kind == ButtonKind.Danger)
                ? (ta.pressed ? Theme.pressed : (ta.has-hover ? Theme.danger-subtle : transparent))
                : (root.kind == ButtonKind.Subtle)
                    ? (ta.pressed ? Theme.pressed : (ta.has-hover ? Theme.hover : transparent))
                    : (ta.pressed ? Theme.layer-sunken : (ta.has-hover ? Theme.layer-alt : Theme.layer));

        content := HorizontalLayout {
            padding-left: root.compact ? Theme.space-2 : Theme.space-3;
            padding-right: root.compact ? Theme.space-2 : Theme.space-3;
            spacing: Theme.space-2;
            alignment: center;

            if root.icon != "" : IconSlot {
                name: root.icon;
                slot: Theme.icon-size;
                tint: (root.kind == ButtonKind.Primary) ? Theme.on-accent
                    : (root.kind == ButtonKind.Danger) ? Theme.danger
                    : Theme.text;
                enabled: root.enabled;
            }

            Text {
                text: root.label;
                color: (root.kind == ButtonKind.Primary) ? Theme.on-accent
                    : (root.kind == ButtonKind.Danger) ? Theme.danger
                    : Theme.text;
                font-size: Theme.font-body;
                font-weight: Type.medium;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if key_focus.has-focus : Rectangle {
            border-radius: Theme.radius-sm;
            border-width: 2px;
            border-color: Theme.focus-ring;
            background: transparent;
        }
    }

    opacity: root.enabled ? 1.0 : 0.42;

    key_focus := FocusScope {
        key-pressed(e) => {
            if (root.enabled && (e.text == "\n" || e.text == " ")) {
                root.clicked();
                return EventResult.accept;
            }
            EventResult.reject
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Square icon-only button, used in the top bar and the image viewer.
///
/// The glyph is centred against `size` (the visual square), not against the
/// element, so passing `row-height` lets the button fill a 48px command bar while
/// its hover wash and its glyph stay a 32px square in the middle of it.
export component IconButton inherits Rectangle {
    in property <string> icon: "";
    in property <string> tip: "";
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <length> size: Theme.control-height;
    in property <length> row-height: 0px;
    in property <color> tint: Theme.text;
    in property <TipPlacement> tip-placement: TipPlacement.Above;
    callback clicked();

    width: root.size;
    height: root.row-height > 0px ? root.row-height : root.size;
    background: transparent;

    wash := Rectangle {
        y: (root.height - root.size) / 2;
        width: root.size;
        height: root.size;
        border-radius: Theme.radius-sm;
        background: ta.pressed ? Theme.pressed
            : ta.has-hover ? Theme.hover
            : (root.active ? Theme.accent-subtle : transparent);
    }

    opacity: root.enabled ? 1.0 : 0.4;

    IconPresenter {
        name: root.icon;
        glyph-size: Theme.icon-size;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        tint: root.active ? Theme.accent : root.tint;
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HoverTip {
        show: ta.has-hover && root.tip != "";
        tip: root.tip;
        placement: root.tip-placement;
        x: (root.width - self.width) / 2;
        y: root.tip-placement == TipPlacement.Below
            ? root.height + 6px
            : -self.height - 6px;
    }
}

// ======================================================================
// Inputs
// ======================================================================

/// Fluent text field with a leading glyph and a clear affordance.
///
/// Child order is hit-test order in Slint (the last declared element is on top),
/// so the layout here is deliberate: the padding touch target first, the input
/// above it, the clear button last. The previous version put a full-size
/// `TouchArea` *after* the layout, which covered the clear button and made it
/// unclickable — the click only ever re-focused the field.
export component TextField inherits Rectangle {
    in property <string> placeholder: "";
    in property <string> leading-icon: "";
    in-out property <string> text <=> input.text;
    in property <bool> enabled: true;
    callback edited(string);
    callback accepted(string);
    callback cleared();

    /// Focus the inner input. Slint has no declarative focus hook, so callers
    /// invoke this from a callback (e.g. the Ctrl+F shortcut).
    public function focus-input() { input.focus(); }

    height: Theme.control-height;
    min-width: 96px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent
        : (hover.has-hover ? Theme.border-strong : Theme.border);
    background: input.has-focus ? Theme.layer : Theme.layer-alt;
    opacity: root.enabled ? 1.0 : 0.5;

    out property <length> leading-extent:
        root.leading-icon == "" ? 0px : Theme.icon-size + Theme.space-2;
    out property <length> trailing-extent:
        (root.text != "" && root.enabled) ? 22px + Theme.space-1 * 2 : Theme.space-2;
    out property <length> text-x: Theme.space-2 + root.leading-extent;

    // Fluent accents the focused field with a 2px bottom rule.
    if input.has-focus : Rectangle {
        y: root.height - 2px;
        height: 2px;
        background: Theme.accent;
        border-radius: Theme.radius-sm;
    }

    // Padding hit target, painted *under* everything else.
    hover := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }

    if root.leading-icon != "" : IconPresenter {
        name: root.leading-icon;
        glyph-size: Theme.icon-size;
        x: Theme.space-2;
        y: (root.height - self.height) / 2;
        tint: input.has-focus ? Theme.accent : Theme.text-secondary;
    }

    input := TextInput {
        x: root.text-x;
        y: 0px;
        width: max(0px, root.width - root.text-x - root.trailing-extent);
        height: root.height - 4px;
        enabled: root.enabled;
        color: Theme.text;
        font-size: Theme.font-body;
        vertical-alignment: center;
        single-line: true;
        edited => { root.edited(root.text); }
        accepted => { root.accepted(root.text); }
    }

    // TextInput has no placeholder of its own, so it is drawn underneath with an
    // explicit width: a bare Text would report the full placeholder width as a
    // minimum for the whole field.
    if root.text == "" : Text {
        x: root.text-x;
        y: 0px;
        width: max(0px, root.width - root.text-x - root.trailing-extent);
        height: root.height - 4px;
        overflow: elide;
        text: root.placeholder;
        color: Theme.text-tertiary;
        font-size: Theme.font-body;
        vertical-alignment: center;
    }

    if root.text != "" && root.enabled : IconButton {
        icon: "dismiss";
        tint: Theme.text-secondary;
        size: 22px;
        x: root.width - self.width - Theme.space-1;
        y: (root.height - self.height) / 2;
        clicked => {
            root.text = "";
            root.cleared();
            input.focus();
        }
    }
}

/// WinUI-style toggle switch: 40x20 track, 12px thumb, 90ms slide.
export component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);

    width: 40px;
    height: 20px;
    border-radius: Theme.radius-pill;
    border-width: root.checked ? 0px : 1px;
    border-color: ta.has-hover ? Theme.text-secondary : Theme.border-strong;
    background: root.checked
        ? (ta.pressed ? Theme.accent-pressed : (ta.has-hover ? Theme.accent-hover : Theme.accent))
        : (ta.has-hover ? Theme.layer-sunken : transparent);
    opacity: root.enabled ? 1.0 : 0.42;

    Rectangle {
        width: 12px;
        height: 12px;
        border-radius: Theme.radius-pill;
        x: root.checked ? parent.width - self.width - 4px : 4px;
        y: (parent.height - self.height) / 2;
        background: root.checked ? Theme.on-accent : Theme.text-secondary;
        animate x { duration: Theme.motion-fast; easing: ease-out; }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

/// Segmented selector, the WinUI "radio buttons" idiom rendered as a pill group.
///
/// Used for the three-way theme choice (跟随系统 / 浅色 / 深色): a boolean toggle
/// cannot express three states, and a `ComboBox` would hide two of them behind a
/// click. Generic over its labels so the same control serves sort order and
/// ranking period.
export component SegmentedControl inherits Rectangle {
    in property <[string]> items: [];
    in-out property <int> current: 0;
    in property <bool> enabled: true;
    callback selected(int);

    height: Theme.control-height;
    width: row.preferred-width;
    border-radius: Theme.radius-sm;
    background: Theme.layer-alt;
    border-width: 1px;
    border-color: Theme.border;
    opacity: root.enabled ? 1.0 : 0.45;

    row := HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        alignment: start;

        for item[i] in root.items : Rectangle {
            border-radius: Theme.radius-sm;
            background: i == root.current
                ? Theme.layer
                : (hit.has-hover ? Theme.hover : transparent);
            border-width: i == root.current ? 1px : 0px;
            border-color: Theme.border-strong;

            HorizontalLayout {
                padding-left: Theme.space-3;
                padding-right: Theme.space-3;
                alignment: center;
                Text {
                    text: item;
                    color: i == root.current ? Theme.text : Theme.text-secondary;
                    font-size: Theme.font-small;
                    font-weight: i == root.current ? Type.semibold : Type.regular;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            hit := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => {
                    root.current = i;
                    root.selected(i);
                }
            }
        }
    }
}

/// Small count/type badge. Declared before the elements that embed it: Slint
/// resolves component names in source order, so a type cannot be used above its
/// own definition.
export component Badge inherits Rectangle {
    in property <string> label: "";
    in property <color> fill: Theme.accent-subtle;
    in property <color> ink: Theme.accent;

    height: 18px;
    // Explicit width rather than the default "fill the parent": a badge is also
    // used absolutely positioned (rail counters, toolbar indicators), where the
    // default width would stretch it across the whole bar.
    width: max(18px, row.preferred-width);
    border-radius: Theme.radius-sm;
    background: root.fill;

    row := HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        alignment: center;
        Text {
            text: root.label;
            color: root.ink;
            font-size: Theme.font-caption;
            font-weight: Type.semibold;
            vertical-alignment: center;
        }
    }
}

// ======================================================================
// Navigation
// ======================================================================

/// One entry in the NavigationView pane.
///
/// Selected state = accent wash + a 3px accent bar on the leading edge, exactly
/// as WinUI NavigationView draws it. The internals are positioned absolutely and
/// derived from the item's own height: a horizontal layout here top-aligns every
/// fixed-size child, which is what put the rail's glyphs ~10 logical px above
/// their labels. Absolute geometry makes the centre line exact and DPI-proof, and
/// it is why the glyphs stay put on hover/press/select.
export component NavItem inherits Rectangle {
    in property <string> icon: "";
    in property <string> label: "";
    in property <bool> selected: false;
    in property <bool> compact: false;
    in property <int> badge: 0;
    callback clicked();

    out property <length> inset: root.compact ? 0px : Theme.space-3;

    height: Theme.nav-item-height;
    border-radius: Theme.radius-sm;
    background: root.selected
        ? Theme.accent-subtle
        : (ta.pressed ? Theme.pressed : (ta.has-hover ? Theme.hover : transparent));

    if root.selected : Rectangle {
        x: 0px;
        y: (root.height - 16px) / 2;
        width: 3px;
        height: 16px;
        border-radius: Theme.radius-pill;
        background: Theme.accent;
    }

    IconPresenter {
        name: root.icon;
        glyph-size: Theme.icon-size;
        x: root.compact ? (root.width - self.width) / 2 : root.inset;
        y: (root.height - self.height) / 2;
        tint: root.selected ? Theme.accent : Theme.text-secondary;
    }

    if !root.compact : Text {
        x: root.inset + Theme.icon-size + Theme.space-3;
        y: 0px;
        width: max(0px, root.width - self.x - (root.badge > 0 ? 44px : Theme.space-2));
        height: root.height;
        text: root.label;
        color: root.selected ? Theme.accent : Theme.text;
        font-size: Theme.font-body;
        font-weight: root.selected ? Type.semibold : Type.regular;
        vertical-alignment: center;
        overflow: elide;
    }

    if !root.compact && root.badge > 0 : Badge {
        label: root.badge > 99 ? "99+" : root.badge;
        x: root.width - self.width - Theme.space-2;
        y: (root.height - self.height) / 2;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HoverTip {
        show: root.compact && ta.has-hover && root.label != "";
        tip: root.label;
        x: root.width + Theme.space-2;
        y: (root.height - self.height) / 2;
    }
}

/// Pill-shaped tag, clickable to run a search.
export component TagChip inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    callback clicked();

    height: 26px;
    border-radius: Theme.radius-pill;
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.border;
    background: root.active
        ? Theme.accent-subtle
        : (ta.has-hover ? Theme.layer-alt : Theme.layer);

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        alignment: center;
        Text {
            text: root.label;
            color: root.active ? Theme.accent : Theme.text-secondary;
            font-size: Theme.font-small;
            vertical-alignment: center;
            overflow: elide;
            // A chip must never be squeezed by the strip it sits in: without this
            // the horizontal scroller compressed every chip to fit the viewport and
            // elided the labels ("…"), which also meant the strip had nothing to
            // scroll. Incompressible text gives the row its real width.
            min-width: self.preferred-width;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

/// Section heading with an optional trailing action.
export component SectionHeader inherits Rectangle {
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <string> action-label: "";
    callback action();

    height: root.subtitle == "" ? 32px : 46px;

    HorizontalLayout {
        spacing: Theme.space-2;

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.font-title;
                font-weight: Type.semibold;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.subtitle != "" : Text {
                text: root.subtitle;
                color: Theme.text-tertiary;
                font-size: Theme.font-small;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if root.action-label != "" : AppButton {
            label: root.action-label;
            kind: ButtonKind.Subtle;
            icon: "chevron-right";
            clicked => { root.action(); }
        }
    }
}

// ======================================================================
// Feedback
// ======================================================================

export enum InfoKind {
    Info,
    Success,
    Warning,
    Error,
}

/// WinUI InfoBar, in its inline (non-closable unless asked) form.
export component InfoBar inherits Rectangle {
    in property <InfoKind> kind: InfoKind.Info;
    in property <string> title: "";
    in property <string> message: "";
    in property <string> action-label: "";
    in property <bool> dismissible: false;
    callback action();
    callback dismissed();

    visible: root.title != "" || root.message != "";
    height: body.preferred-height + Theme.space-2 * 2;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: (root.kind == InfoKind.Error) ? Theme.danger
        : (root.kind == InfoKind.Warning) ? Theme.warning
        : (root.kind == InfoKind.Success) ? Theme.success
        : Theme.border;
    background: (root.kind == InfoKind.Error) ? Theme.danger-subtle
        : (root.kind == InfoKind.Warning) ? Theme.warning-subtle
        : (root.kind == InfoKind.Success) ? Theme.success-subtle
        : Theme.accent-subtle;

    body := HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-2;
        padding-top: Theme.space-2;
        padding-bottom: Theme.space-2;
        spacing: Theme.space-2;

        // `height: 100%` inside `IconSlot` puts the glyph on the bar's centre
        // line even when the message wraps to two lines.
        IconSlot {
            name: (root.kind == InfoKind.Error) ? "warning"
                : (root.kind == InfoKind.Success) ? "check"
                : (root.kind == InfoKind.Warning) ? "warning"
                : "info";
            slot: Theme.icon-size;
            tint: (root.kind == InfoKind.Error) ? Theme.danger
                : (root.kind == InfoKind.Warning) ? Theme.warning
                : (root.kind == InfoKind.Success) ? Theme.success
                : Theme.accent;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            if root.title != "" : Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.font-small;
                font-weight: Type.semibold;
                wrap: word-wrap;
            }
            if root.message != "" : Text {
                text: root.message;
                color: Theme.text-secondary;
                font-size: Theme.font-caption;
                wrap: word-wrap;
            }
        }

        if root.action-label != "" : AppButton {
            label: root.action-label;
            kind: ButtonKind.Subtle;
            compact: true;
            clicked => { root.action(); }
        }
        if root.dismissible : IconButton {
            icon: "dismiss";
            size: 22px;
            tint: Theme.text-secondary;
            clicked => { root.dismissed(); }
        }
    }
}

/// Determinate progress bar. `indeterminate` shows a static 30% thumb rather
/// than animating: a perpetually moving element would keep the compositor busy
/// for no information gain, which is the wrong trade for an idle desktop app.
export component ProgressBar inherits Rectangle {
    in property <float> progress: 0.0;
    in property <bool> indeterminate: false;

    height: 3px;
    border-radius: Theme.radius-pill;
    background: Theme.layer-sunken;

    Rectangle {
        x: 0px;
        width: root.indeterminate
            ? parent.width * 0.3
            : parent.width * Math.max(0.0, Math.min(1.0, root.progress));
        height: parent.height;
        border-radius: Theme.radius-pill;
        background: Theme.accent;
        visible: root.indeterminate || root.progress > 0.0;
    }
}

export enum StateKind {
    Loading,
    Empty,
    Error,
    Locked,
}

/// The four states every page must be able to show. `Locked` is the "sign in to
/// see this" case, which is distinct from a network error and must never be
/// rendered as an empty result.
export component StateView inherits Rectangle {
    in property <StateKind> kind: StateKind.Empty;
    in property <string> title: "";
    in property <string> description: "";
    in property <string> action-label: "";
    /// Overrides the glyph derived from `kind`. A page must be able to say
    /// "nothing downloaded yet" with a download glyph instead of reusing the
    /// generic "image failed" one, which is what an empty-state here used to show.
    in property <string> glyph: "";
    callback retry();
    callback action();

    VerticalLayout {
        alignment: center;
        spacing: Theme.space-3;
        padding-top: Theme.space-6;
        padding-bottom: Theme.space-6;
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;

        // A layout's `alignment` does not centre a fixed-width child on the cross
        // axis: a glyph stays at the start of the line while its Text siblings
        // centre their own content, which is why the empty-state icon sat alone at
        // the left edge. Two stretch spacers centre it for real.
        HorizontalLayout {
            width: 100%;
            Rectangle { horizontal-stretch: 1; }
            IconPresenter {
                name: root.glyph != "" ? root.glyph
                    : (root.kind == StateKind.Loading) ? "refresh"
                    : (root.kind == StateKind.Error) ? "warning"
                    : (root.kind == StateKind.Locked) ? "key"
                    : "image-off";
                glyph-size: 28px;
                tint: root.kind == StateKind.Error ? Theme.danger : Theme.text-tertiary;
            }
            Rectangle { horizontal-stretch: 1; }
        }

        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.font-subhead;
            font-weight: Type.medium;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        if root.description != "" : Text {
            text: root.description;
            color: Theme.text-secondary;
            font-size: Theme.font-small;
            horizontal-alignment: center;
            wrap: word-wrap;
            max-width: 420px;
        }

        if root.action-label != "" : HorizontalLayout {
            width: 100%;
            Rectangle { horizontal-stretch: 1; }
            AppButton {
                label: root.action-label;
                kind: (root.kind == StateKind.Locked) ? ButtonKind.Primary : ButtonKind.Secondary;
                icon: (root.kind == StateKind.Error) ? "refresh" : ((root.kind == StateKind.Locked) ? "key" : "");
                clicked => {
                    if (root.kind == StateKind.Error) { root.retry(); }
                    else { root.action(); }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

/// Static loading placeholder. Intentionally not animated: a shimmer would wake
/// the compositor every frame for no information gain.
export component Skeleton inherits Rectangle {
    in property <length> radius: Theme.radius-md;
    height: 120px;
    border-radius: root.radius;
    background: Theme.layer-alt;
}

// ======================================================================
// Page scroll container — the fix for the clipping / stray-scrollbar class
// ======================================================================

/// A full-bleed vertical scroll area whose content is *exactly* as wide as the
/// viewport (minus a reserved gutter for the overlay scrollbar).
///
/// Why this component exists: a `ScrollView` whose content derives its width
/// from its children's preferred size inherits the widest child's minimum width.
/// One long, unwrapped `Text` or one `HorizontalLayout` of chips is then enough
/// to make the content wider than the viewport, which produces the two symptoms
/// this app used to show: a horizontal scrollbar at the bottom of the page, and
/// a grid laid out at `card-width` inside an over-wide content box, leaving a
/// large blank strip on the right.
///
/// Binding the body width to `visible-width` (the ScrollView's own width, which
/// does not depend on the content) removes that feedback path entirely.
export component PageScroll inherits Rectangle {
    in property <length> padding-x: Theme.page-padding;
    in property <length> padding-y: Theme.space-4;
    in property <length> spacing: Theme.space-4;
    in property <bool> gutter: true;
    in-out property <length> scroll-y: 0px;
    /// Width available to page content, i.e. the body minus its horizontal
    /// padding. Callers derive column counts from this instead of from the window
    /// width, so padding can never be counted twice.
    out property <length> body-width: max(0px, body.width - root.padding-x * 2);
    out property <length> body-height: body.height;
    out property <length> viewport-height: sv.visible-height;
    callback scrolled(length);
    callback width-changed(length);

    background: Theme.canvas;

    sv := ScrollView {
        width: 100%;
        height: 100%;
        content-y <=> root.scroll-y;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
        scrolled => { root.scrolled(root.scroll-y); }

        body := VerticalLayout {
            width: max(0px, sv.visible-width - (root.gutter ? Theme.scrollbar-gutter : 0px));
            padding-left: root.padding-x;
            padding-right: root.padding-x;
            padding-top: root.padding-y;
            padding-bottom: root.padding-y;
            spacing: root.spacing;

            @children
        }
    }

    // Report the measured content width so Rust can compute the masonry column
    // count from what the layout actually resolved to, not from a guess at the
    // window size. This is a one-way message: nothing Rust writes back feeds
    // into `body-width`, so there is no binding loop.
    changed body-width => {
        root.width-changed(root.body-width);
    }
}

// ======================================================================
// Artwork card
// ======================================================================

/// Presentation model for one illustration card.
///
/// Ids are `string` because Pixiv ids exceed 32 bits and Slint's `int` is i32;
/// the raw ids would silently overflow if passed as numbers.
export struct IllustItem {
    id: string,
    title: string,
    author: string,
    author-id: string,
    cover: image,
    /// 0 illustration, 1 manga, 2 ugoira.
    kind: int,
    page-count: int,
    bookmarked: bool,
    /// 1-based position in a ranking, 0 when not ranked.
    rank: int,
    /// Intrinsic size, used to derive the card's own aspect ratio.
    width: int,
    height: int,
    /// 0 ok, 1 loading, 2 failed
    state: int,
}

/// The bookmark toggle that floats on the cover's corner.
component BookmarkPill inherits Rectangle {
    in property <bool> marked: false;
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: Theme.radius-pill;
    background: ta.has-hover ? Theme.layer : #d9ffffff;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.border-strong : transparent;

    IconPresenter {
        name: "follow";
        glyph-size: 14px;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        // Filled-in is impossible with a stroke-only path set, so "marked" is
        // signalled by colour alone: no layout shift, no glyph swap.
        tint: root.marked ? Theme.accent : #2b2b2b;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HoverTip {
        show: ta.has-hover;
        tip: root.marked ? "取消收藏" : "收藏";
        x: (root.width - self.width) / 2;
        y: -self.height - 6px;
    }
}

/// An artwork card: the cover at its true aspect ratio, then a two-line caption.
///
/// Height is *exactly* `width * clamped-aspect + caption`, which is the same
/// formula `src/layout.rs` uses to balance the masonry columns. Keeping the two
/// in sync is what makes the columns end ragged-but-even instead of jumping.
///
/// Hit-testing note: Slint hit-tests in reverse declaration order, so the card's
/// open-on-click `TouchArea` is declared **first** here. When it was declared last
/// it covered the bookmark pill, and the pill was unclickable — every click on the
/// heart opened the artwork instead.
export component IllustCard inherits Rectangle {
    in property <IllustItem> item;
    in property <bool> show-author: true;
    /// Column width; the card sizes itself from it.
    in property <length> column-width: 220px;
    callback open();
    callback open-author();
    callback toggle-bookmark();

    // Clamp to a sane band: a 1:6 banner and a 6:1 panorama both stay usable.
    out property <float> clamped-aspect:
        (root.item.width <= 0 || root.item.height <= 0)
            ? 1.0
            : Math.max(0.55, Math.min(1.6, root.item.height * 1.0 / (root.item.width * 1.0)));

    out property <length> cover-height: Math.max(48px, root.column-width * root.clamped-aspect);
    width: root.column-width;
    height: root.cover-height + Theme.card-caption-height;

    // Open-on-click, underneath every interactive child.
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }
        double-clicked => { root.open(); }
    }

    VerticalLayout {
        spacing: 0px;

        cover_box := Rectangle {
            height: root.cover-height;
            border-radius: Theme.radius-lg;
            clip: true;
            background: Theme.layer-alt;

            Image {
                source: root.item.cover;
                image-fit: cover;
                width: 100%;
                height: 100%;
            }

            // Loading / failure overlays so a card is never an empty hole.
            if root.item.state == 1 : Rectangle {
                background: Theme.layer-alt;
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        width: 100%;
                        Rectangle { horizontal-stretch: 1; }
                        IconPresenter {
                            name: "image-off";
                            glyph-size: Theme.icon-size-lg;
                            tint: Theme.text-disabled;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
            if root.item.state == 2 : Rectangle {
                background: Theme.layer-alt;
                VerticalLayout {
                    alignment: center;
                    spacing: Theme.space-1;
                    HorizontalLayout {
                        width: 100%;
                        Rectangle { horizontal-stretch: 1; }
                        IconPresenter {
                            name: "warning";
                            glyph-size: Theme.icon-size-lg;
                            tint: Theme.text-tertiary;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Text {
                        text: "加载失败";
                        color: Theme.text-tertiary;
                        font-size: Theme.font-caption;
                        horizontal-alignment: center;
                    }
                }
            }

            // Hover: a soft scrim inside the cover. It cannot reflow anything and
            // it is drawn under the pill and the badges.
            Rectangle {
                background: ta.has-hover ? #12000000 : transparent;
                border-radius: Theme.radius-lg;
            }

            // Ranking position, top-left, only where it means something.
            if root.item.rank > 0 : Rectangle {
                x: Theme.space-2;
                y: Theme.space-2;
                width: rank-label.width + 10px;
                height: 20px;
                border-radius: Theme.radius-sm;
                background: root.item.rank <= 3 ? Theme.accent : #a6000000;

                rank-label := Text {
                    x: 5px;
                    y: 0px;
                    height: parent.height;
                    text: "#" + root.item.rank;
                    color: #ffffff;
                    font-size: Theme.font-caption;
                    font-weight: Type.semibold;
                    vertical-alignment: center;
                }
            }

            // Type badge, top-right: only for multi-page, manga and ugoira.
            if root.item.page-count > 1 || root.item.kind != 0 : Rectangle {
                x: parent.width - self.width - Theme.space-2;
                y: Theme.space-2;
                width: type-label.width + 10px;
                height: 20px;
                border-radius: Theme.radius-sm;
                background: #a6000000;

                type-label := Text {
                    x: 5px;
                    y: 0px;
                    height: parent.height;
                    text: (root.item.kind == 1) ? "漫画"
                        : (root.item.kind == 2) ? "动图"
                        : ("共" + root.item.page-count + "张");
                    color: #ffffff;
                    font-size: Theme.font-caption;
                    font-weight: Type.medium;
                    vertical-alignment: center;
                }
            }

            BookmarkPill {
                x: parent.width - self.width - Theme.space-2;
                y: parent.height - self.height - Theme.space-2;
                marked: root.item.bookmarked;
                clicked => { root.toggle-bookmark(); }
            }
        }

        // Caption band: a fixed 44px, which is exactly what `card_height()` in
        // src/layout.rs assumes when balancing the columns.
        Rectangle {
            height: Theme.card-caption-height;

            Text {
                x: 0px;
                y: 4px;
                width: parent.width;
                height: 18px;
                text: root.item.title;
                color: Theme.text;
                font-size: Theme.font-small;
                font-weight: Type.medium;
                overflow: elide;
                vertical-alignment: center;
            }
            if root.show-author : Text {
                x: 0px;
                y: 22px;
                width: parent.width;
                height: 16px;
                text: root.item.author;
                color: Theme.text-tertiary;
                font-size: Theme.font-caption;
                overflow: elide;
                vertical-alignment: center;
            }
        }
    }
}

// ======================================================================
// Settings pieces (shared with the download page's "where do files go" block)
// ======================================================================

/// A titled group of rows, as in the Win11 Settings app.
export component SettingsCard inherits Rectangle {
    in property <string> title: "";
    in property <string> description: "";
    in property <string> icon: "";

    border-radius: Theme.radius-lg;
    background: Theme.layer;
    border-width: 1px;
    border-color: Theme.border;
    // A card is exactly as tall as its rows. Without this the card is the only
    // flexible child of a page body that is stretched to the viewport, so it
    // silently absorbs all the leftover space and two lines of text end up
    // floating in a 280px-tall box.
    height: card-body.preferred-height;

    card-body := VerticalLayout {
        padding-top: Theme.space-3;
        padding-bottom: Theme.space-3;
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        spacing: Theme.space-2;

        HorizontalLayout {
            spacing: Theme.space-3;
            height: max(24px, title-block.preferred-height);

            if root.icon != "" : IconSlot {
                name: root.icon;
                slot: Theme.icon-size-lg;
                glyph-size: Theme.icon-size-lg;
                tint: Theme.accent;
            }

            title-block := VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: Theme.font-subhead;
                    font-weight: Type.semibold;
                    overflow: elide;
                }
                if root.description != "" : Text {
                    text: root.description;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-caption;
                    wrap: word-wrap;
                }
            }
        }

        @children
    }
}

/// Label (and optional hint) on the left, control on the right.
///
/// The control column is capped both absolutely (`control-width`) and relatively
/// (46% of the card), so at 640px the label keeps a usable width and the hint
/// wraps instead of being clipped. That relative cap replaces the fixed 168px
/// column which used to push the whole settings card past the viewport.
export component SettingsRow inherits Rectangle {
    in property <string> label: "";
    in property <string> hint: "";
    in property <length> control-width: 200px;
    in property <length> available-width: 640px;

    out property <length> actual-control-width:
        Math.min(root.control-width, Math.max(76px, root.available-width * 0.46));

    height: max(Theme.control-height, row-layout.preferred-height);

    row-layout := HorizontalLayout {
        spacing: Theme.space-3;
        // No `alignment` here on purpose. Setting it on a horizontal layout makes
        // the row pack its children at their preferred widths, which drops the
        // stretch of the label column and parks the control in the middle of the
        // card instead of at its right edge. Unset, the label column stretches and
        // the control sits where a settings row should.

        VerticalLayout {
            spacing: 2px;
            alignment: start;
            horizontal-stretch: 1;
            // `alignment: center` here would be *cross-axis* centering: each Text
            // would shrink to its own width and float in the middle of the label
            // column, which is what put settings labels ~180px in from the card
            // edge. Labels are left-aligned; only their inline box is centred.
            Text {
                text: root.label;
                color: Theme.text;
                font-size: Theme.font-body;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.hint != "" : Text {
                text: root.hint;
                color: Theme.text-tertiary;
                font-size: Theme.font-caption;
                wrap: word-wrap;
            }
        }

        Rectangle {
            width: root.actual-control-width;
            height: max(Theme.control-height, control-slot.preferred-height);
            VerticalLayout {
                control-slot := HorizontalLayout {
                    alignment: end;
                    @children
                }
            }
        }
    }
}
