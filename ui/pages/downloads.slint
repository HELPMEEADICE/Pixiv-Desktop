// Download manager.
//
// A WinUI ListView-style queue rather than tiles: each task is one row with a
// state glyph, a title, a state badge, a determinate progress bar and the actions
// that make sense for its state. Every row action maps to real manager state
// (cancel, retry, reveal file); nothing here is decorative.
//
// Alignment note: `TaskRow` is 76px tall and every child is a fixed-size control,
// which a Slint horizontal layout would top-align. The row therefore hands each
// control the row height (`IconButton.row-height`) or wraps it in a full-height
// cell, so the badge, the buttons and the state glyph all share one centre line.

import { Theme, Type, Emphasis, TextRole } from "../theme.slint";
import { AppButton, IconButton, ButtonKind, Divider, StateView, StateKind, Badge, InfoBar, InfoKind, PageScroll, ProgressBar, SettingsCard, SectionHeader, IconPresenter, IconSlot, Label, BodyText } from "../components.slint";

export struct DownloadRow {
    id: int,
    title: string,
    author: string,
    /// e.g. "第 2 / 5 页"
    subtitle: string,
    /// 0..100, -1 when indeterminate
    progress: int,
    /// 0 queued, 1 running, 2 done, 3 failed, 4 cancelled, 5 skipped,
    /// 6 paused (round nine, F5: `TaskState::Paused`). Six is the *UI-side* number:
    /// it is the one place this page has to agree with `src/app/downloads.rs`, and
    /// it is stated here rather than in a magic `if` ten lines down.
    state: int,
    message: string,
    path: string,
}

/// One row of the local record band (F1): a file this app already wrote, read
/// back from SQLite rather than from the live queue.
///
/// `id` is the store's own row id, which is what 忘记 addresses; the three
/// string actions carry `path`, because the file is the one thing a re-open,
/// a reveal and a re-queue all have to resolve and it is the field the record
/// was written with. `state` is 0 while the file is still on disk and 1 once the
/// record outlives it - a record is not deleted because somebody moved a file,
/// and a row that lied about that would be the silent failure the band exists to
/// prevent.
export struct LocalRow {
    id: int,
    title: string,
    author: string,
    path: string,
    /// "2026-11-16 21:04" - formatted once by Rust.
    when: string,
    /// 0 the file is there, 1 the file is gone.
    state: int,
}

/// One local record. Same row grammar as `TaskRow` above - a fixed-height row,
/// one caption line, icon actions on the right - because these rows sit on the
/// same page and a second row style would be a second thing to keep aligned.
component LocalRecordRow inherits Rectangle {
    in property <LocalRow> entry;

    callback open(string);
    callback reveal(string);
    callback redownload(string);
    callback forget(int);

    out property <bool> present: root.entry.state == 0;

    height: Theme.nav-item-height * 2;
    border-radius: Theme.radius-md;
    background: ta.has-hover ? Theme.layer-alt : transparent;

    accessible-role: AccessibleRole.list-item;
    accessible-label: root.entry.title + " · " + root.entry.when;

    // A1: the row's hover surface is declared *first*, not last.
    //
    // Slint hit-tests in reverse declaration order, and a TouchArea takes the mouse on
    // `MouseEvent::Pressed` whether or not it has a handler. Declared last, this bare
    // surface sat on top of the row's four IconButtons and ate every press aimed at
    // them: open / reveal / re-download / forget were pointer-dead while Tab still
    // reached them, which is why no reviewer saw it. Declared first it stays under the
    // controls, and `ta.has-hover` still paints the row wash — the one thing given up is
    // that hovering an icon lights the icon's own wash instead of the whole row, which is
    // what an icon button's hover is for. uiaudit's
    // `a_hover_surface_declared_after_a_pointer_target_loses_the_press` keeps it here.
    ta := TouchArea { }

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-2;
        spacing: Theme.space-3;

        Rectangle {
            width: Theme.control-height;
            height: 100%;

            IconPresenter {
                name: root.present ? "folder" : "warning";
                glyph-size: Theme.icon-size;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                tint: root.present ? Theme.accent-ink : Theme.warning;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Label {
                text: root.entry.title;
                color: Theme.text;
            }
            Label {
                role: TextRole.Caption;
                text: root.entry.author + " · " + root.entry.when;
                color: Theme.text-secondary;
            }
            Label {
                role: TextRole.Caption;
                text: root.present ? root.entry.path : root.entry.path + "（文件已不在）";
                color: root.present ? Theme.text-tertiary : Theme.warning;
            }
        }

        // A file that is gone cannot be opened or revealed, so the two controls
        // say so by being disabled rather than by doing nothing when pressed.
        IconButton {
            icon: "open";
            tip: root.present ? "打开文件" : "文件已不在，无法打开";
            size: Theme.control-height-sm;
            row-height: Theme.nav-item-height * 2;
            enabled: root.present;
            clicked => { root.open(root.entry.path); }
        }
        IconButton {
            icon: "folder";
            tip: root.present ? "在资源管理器中显示" : "文件已不在，无法定位";
            size: Theme.control-height-sm;
            row-height: Theme.nav-item-height * 2;
            enabled: root.present;
            clicked => { root.reveal(root.entry.path); }
        }
        IconButton {
            icon: "refresh";
            tip: "重新下载这个作品";
            size: Theme.control-height-sm;
            row-height: Theme.nav-item-height * 2;
            clicked => { root.redownload(root.entry.path); }
        }
        IconButton {
            icon: "dismiss";
            tip: "忘记这条记录（文件保留）";
            size: Theme.control-height-sm;
            row-height: Theme.nav-item-height * 2;
            clicked => { root.forget(root.entry.id); }
        }
    }
}

/// Row metric, mirrored by the state-colour logic below.
component TaskRow inherits Rectangle {
    in property <DownloadRow> entry;

    callback cancel();
    callback retry();
    callback reveal();
    /// Round nine (F5): pause/resume this task. `pause` reuses `Cancel` inside the
    /// manager so a running task gives its permit back instead of holding it until
    /// the body arrives; the row does not know that, and only reports the intent.
    callback pause();
    callback resume();

    out property <bool> finished: root.entry.state == 2 || root.entry.state == 5;
    out property <bool> running: root.entry.state == 0 || root.entry.state == 1;
    out property <bool> paused: root.entry.state == 6;

    height: 76px;
    border-radius: Theme.radius-md;
    background: Theme.layer;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-2;
        spacing: Theme.space-3;

        // State glyph in a tinted tile, so the row can be scanned without
        // reading any text.
        Rectangle {
            width: 32px;
            height: 100%;
            Rectangle {
                width: 32px;
                height: 32px;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-md;
                background: root.entry.state == 3 ? Theme.danger-subtle
                    : root.entry.state == 2 ? Theme.success-subtle
                    : root.entry.state == 4 ? Theme.layer-sunken
                    : root.paused ? Theme.layer-sunken
                    : Theme.accent-subtle;

                IconPresenter {
                    name: root.entry.state == 2 ? "check"
                        : root.entry.state == 3 ? "warning"
                        : root.entry.state == 4 ? "close"
                        : root.entry.state == 5 ? "copy"
                        : root.paused ? "pause"
                        : "downloads";
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    tint: root.entry.state == 3 ? Theme.danger
                        : root.entry.state == 2 ? Theme.success
                        : root.entry.state == 4 ? Theme.text-tertiary
                        : root.paused ? Theme.text-secondary
                        : Theme.accent-ink;
                }
            }
        }

        VerticalLayout {
            spacing: 3px;
            horizontal-stretch: 1;
            // Left-aligned like every other list row: `alignment: center` would
            // centre each line in the column instead of aligning it to the edge.
            alignment: center;

            Label {
                text: root.entry.title;
                color: Theme.text;
            }
            Label {
                role: TextRole.Caption;
                text: root.entry.author + " · " + root.entry.subtitle;
                color: Theme.text-tertiary;
            }

            // The meter stays while a task is paused: U13 was "the progress bar has
            // no frozen width", and a paused row that hid its own progress would hide
            // the one number a resumed download continues from.
            if root.running || root.paused : ProgressBar {
                progress: root.entry.progress < 0 ? 0.0 : root.entry.progress * 1.0 / 100.0;
                indeterminate: root.entry.progress < 0 && !root.paused;
                width: 100%;
            }
            if root.entry.state == 3 && root.entry.message != "" : Label {
                role: TextRole.Caption;
                text: root.entry.message;
                color: Theme.danger;
            }
        }

        Rectangle {
            width: status-badge.width;
            height: 100%;

            status-badge := Badge {
                y: (parent.height - self.height) / 2;
                label: root.entry.state == 0 ? "等待中"
                    : root.entry.state == 1 ? (root.entry.progress < 0 ? "下载中" : (root.entry.progress + "%"))
                    : root.entry.state == 2 ? "已完成"
                    : root.entry.state == 3 ? "失败"
                    : root.entry.state == 5 ? "已存在"
                    : root.paused ? "已暂停"
                    : "已取消";
                // F5: the paused chip is the one badge in this page that carries ink on
                // `accent-fill`, so it takes the `on-accent` pair — the exact pair U23
                // measured (`#ffffff` on dark `accent-fill` is 2.38:1, `on-accent` is
                // 8.01:1). Every other badge here is ink on a *subtle* wash and keeps
                // `accent-ink`.
                fill: root.entry.state == 3 ? Theme.danger-subtle
                    : root.entry.state == 2 ? Theme.success-subtle
                    : root.entry.state == 4 ? Theme.layer-sunken
                    : root.paused ? Theme.accent-fill
                    : Theme.accent-subtle;
                // State 4 is the cancelled task, and its ink was text-tertiary on
                // layer-sunken: #6e6e6e on #ececee measures 4.32:1 in light mode,
                // under the 4.5:1 AA floor for an 11 px label (dark measures
                // 7.32:1, so this was light-only). text-secondary on the same
                // surface measures 5.58:1. Measured, not eyeballed.
                ink: root.entry.state == 3 ? Theme.danger
                    : root.entry.state == 2 ? Theme.success
                    : root.entry.state == 4 ? Theme.text-secondary
                    : root.paused ? Theme.on-accent
                    : Theme.accent-ink;
            }
        }

        // Row actions. Reveal only means something once a file exists; retry only
        // where the task can actually be re-run.
        IconButton {
            icon: "folder";
            tip: root.finished ? "在资源管理器中显示" : "完成后可在此打开";
            size: Theme.control-height-sm;
            row-height: 76px;
            enabled: root.finished;
            clicked => { root.reveal(); }
        }
        IconButton {
            icon: "refresh";
            tip: "重试";
            size: Theme.control-height-sm;
            row-height: 76px;
            visible: root.entry.state == 3 || root.entry.state == 4;
            clicked => { root.retry(); }
        }
        // F5: pause/resume sits where the state is, one control per row. A paused row
        // offers resume, a queued or running one offers pause. `resume` returns the row
        // to Queued; HTTP Range resume is out of scope this round, which is why the
        // paused row keeps its own progress rather than pretending to restart at 0.
        IconButton {
            icon: root.paused ? "play" : "pause";
            tip: root.paused ? "继续下载" : "暂停下载";
            size: Theme.control-height-sm;
            row-height: 76px;
            visible: root.running || root.paused;
            clicked => {
                if (root.paused) { root.resume(); } else { root.pause(); }
            }
        }
        IconButton {
            icon: "dismiss";
            tip: "取消";
            size: Theme.control-height-sm;
            row-height: 76px;
            visible: root.running || root.paused;
            clicked => { root.cancel(); }
        }
    }
}

export component DownloadsPage inherits Rectangle {
    in property <[DownloadRow]> rows: [];
    in property <int> active-count: 0;
    in property <int> done-count: 0;
    in property <int> failed-count: 0;
    in property <string> directory: "";
    in property <string> template-text: "";

    // ---- round nine: queue control (F5) ----
    // The frozen seam. Every one of these defaults to "an ordinary queue":
    // `queue-paused` false, `queue-done`/`queue-total` 0 and `throughput` empty,
    // which draws the header exactly as it was before this round.
    in property <bool> queue-paused: false;
    in property <int> queue-done: 0;
    in property <int> queue-total: 0;
    /// Pre-formatted ("1.8 MB/s"), empty while unknown. A page is not the place to
    /// decide units: the three-second sliding window lives in `pixiv-download`,
    /// which is also the only place that knows what a byte is.
    in property <string> throughput: "";

    callback cancel(int);
    callback retry(int);
    callback clear-finished();
    callback choose-directory();
    callback open-folder();
    callback open-task(int);
    callback retry-all();
    callback pause-task(int);
    callback resume-task(int);
    callback toggle-pause-all();

    // ---- round eleven (F1): the local record ----
    // The frozen seam (§1). `local-rows` is empty until an owner fills it, and an
    // empty band draws nothing: the page is exactly what it was before this round
    // for anybody who never downloaded anything.
    in property <[LocalRow]> local-rows: [];
    /// The sentence under the band's heading, empty when every recorded file is
    /// still on disk. Produced by Rust: the rows know which file is missing, and a
    /// second opinion here would be free to disagree with them.
    in property <string> local-missing: "";
    /// Open the recorded file.
    callback local-open(string);
    /// Show it in Explorer.
    callback local-reveal(string);
    /// Put the work back in the download queue.
    callback local-redownload(string);
    /// Drop the record; the file is not touched.
    callback local-forget(int);

    /// `done` out of `total`, clamped: a total of 0 is "nothing queued", not a divide
    /// by zero and not a full bar.
    out property <float> queue-progress: root.queue-total > 0
        ? Math.max(0.0, Math.min(1.0, root.queue-done * 1.0 / root.queue-total))
        : 0.0;

    background: Theme.canvas;

    page := PageScroll {
        width: 100%;
        height: 100%;
        spacing: Theme.space-3;

        // ---- header ----
        header-block := VerticalLayout {
            spacing: Theme.space-1;
            padding-top: Theme.space-1;

            HorizontalLayout {
                spacing: Theme.space-3;
                alignment: space-between;

                Label {
                    role: TextRole.Page;
                    emphasis: Emphasis.Semibold;
                    text: "下载管理";
                    color: Theme.text;
                }

                Label {
                    role: TextRole.Small;
                    text: "进行中 " + root.active-count + " · 已完成 " + root.done-count + " 项"
                        + " · 失败 " + root.failed-count;
                    color: Theme.text-tertiary;
                }
            }

            // ---- F5: total progress, throughput, pause-all ----
            // One 32 px row under the heading. The bar is wrapped in a full-height cell
            // because `ProgressBar` is 3 px and a fixed-size child of a horizontal layout
            // is aligned to the *start* of the cross axis — the defect this file already
            // records twice at the top and the reason every control here states a
            // `row-height`.
            HorizontalLayout {
                spacing: Theme.space-2;
                alignment: start;
                height: Theme.control-height;

                Rectangle {
                    width: 120px;
                    height: 100%;
                    ProgressBar {
                        width: 120px;
                        y: (parent.height - self.height) / 2;
                        progress: root.queue-progress;
                    }
                }

                Label {
                    role: TextRole.Small;
                    // "页", because the row counter three lines up counts rows: two
                    // numbers labelled the same thing on one screen is a defect even
                    // when both are true.
                    text: root.queue-total > 0
                        ? ("已下载 " + root.queue-done + " / " + root.queue-total + " 页")
                        : "队列为空";
                    color: Theme.text-secondary;
                }

                // Empty while unknown: a throughput line that reads "0 B/s" when the
                // window has no samples yet is a lie about a stalled queue.
                if root.throughput != "" : Label {
                    role: TextRole.Small;
                    text: root.throughput;
                    color: Theme.text-tertiary;
                }

                // The paused chip takes the `on-accent` pair: it is the only label in
                // this page drawn on `accent-fill`, and U23 is the record of what
                // white-on-accent costs in dark mode.
                if root.queue-paused : Rectangle {
                    width: paused-badge.width;
                    height: 100%;

                    paused-badge := Badge {
                        y: (parent.height - self.height) / 2;
                        label: "已暂停";
                        fill: Theme.accent-fill;
                        ink: Theme.on-accent;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                AppButton {
                    label: root.queue-paused ? "全部继续" : "全部暂停";
                    icon: root.queue-paused ? "play" : "pause";
                    kind: root.queue-paused ? ButtonKind.Primary : ButtonKind.Secondary;
                    compact: true;
                    row-height: Theme.control-height;
                    enabled: root.active-count > 0 || root.queue-paused;
                    clicked => { root.toggle-pause-all(); }
                }
            }
        }

        // ---- command bar ----
        // `row-height` on each button keeps the whole strip on one centre line
        // even though the buttons are 32px and the strip is taller.
        command-bar := HorizontalLayout {
            spacing: Theme.space-2;
            alignment: start;
            height: Theme.control-height;

            AppButton {
                label: "选择文件夹";
                icon: "folder";
                kind: ButtonKind.Primary;
                clicked => { root.choose-directory(); }
            }
            AppButton {
                label: "打开文件夹";
                icon: "open";
                clicked => { root.open-folder(); }
            }
            AppButton {
                label: "重试全部失败";
                icon: "refresh";
                enabled: root.failed-count > 0;
                clicked => { root.retry-all(); }
            }
            AppButton {
                label: "清空已完成";
                icon: "delete";
                kind: ButtonKind.Subtle;
                enabled: root.done-count > 0;
                clicked => { root.clear-finished(); }
            }
        }

        // ---- destination ----
        destination-card := SettingsCard {
            title: "保存位置";
            icon: "downloads";
            description: "仅用于个人离线浏览你在账号内已经可以查看的作品。";

            VerticalLayout {
                spacing: Theme.space-1;
                Text {
                    text: root.directory;
                    color: Theme.text-secondary;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                }
                Text {
                    text: "文件名模板：" + root.template-text;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-caption;
                    wrap: word-wrap;
                }
            }
        }

        // The empty state absorbs whatever the blocks above it did not use. It is
        // derived from their *measured* heights rather than a guessed constant, so
        // it stays centred at every window size and when a block changes height.
        if root.rows.length == 0 : Rectangle {
            height: max(
                200px,
                page.viewport-height
                    - header-block.preferred-height
                    - command-bar.preferred-height
                    - destination-card.preferred-height
                    - page.spacing * 3
                    - page.padding-y * 2
            );

            StateView {
                width: parent.width;
                height: parent.height;
                kind: StateKind.Empty;
                // A download queue that is empty has nothing to do with a failed
                // image; the state carries its own glyph.
                glyph: "downloads";
                title: "还没有下载任务";
                description: "打开任意作品，点击「下载」或「下载全部」即可加入队列。";
            }
        }

        if root.rows.length > 0 : VerticalLayout {
            spacing: Theme.space-2;

            for row in root.rows : TaskRow {
                entry: row;
                cancel => { root.cancel(row.id); }
                retry => { root.retry(row.id); }
                reveal => { root.open-task(row.id); }
                pause => { root.pause-task(row.id); }
                resume => { root.resume-task(row.id); }
            }
        }

        // ---- F1: 已完成（本地记录） ----
        // What the queue did in previous sessions, read back from SQLite. It sits
        // under the queue on purpose: the queue is what is happening, this is what
        // happened, and a reader scanning the page wants them in that order.
        if root.local-rows.length > 0 : Rectangle {
            height: local-card.preferred-height;
            border-radius: Theme.radius-lg;
            background: Theme.layer;
            border-width: 1px;
            border-color: Theme.border;

            local-card := VerticalLayout {
                padding-top: Theme.space-2;
                padding-bottom: Theme.space-2;
                padding-left: Theme.space-3;
                padding-right: Theme.space-3;
                spacing: Theme.space-1;

                SectionHeader {
                    title: "已完成（本地记录）";
                    subtitle: root.local-rows.length + " 个文件已写入磁盘，记录保存在本机";
                }

                // A record that outlived its file says so in a bar rather than
                // failing silently when a row is pressed: the row is still the place
                // to re-download or forget from, so the bar explains, it does not block.
                if root.local-missing != "" : InfoBar {
                    kind: InfoKind.Warning;
                    title: "有记录找不到文件";
                    message: root.local-missing;
                }

                for row[i] in root.local-rows : LocalRecordRow {
                    entry: row;
                    open(path) => { root.local-open(path); }
                    reveal(path) => { root.local-reveal(path); }
                    redownload(path) => { root.local-redownload(path); }
                    forget(id) => { root.local-forget(id); }
                }
            }
        }
    }
}
