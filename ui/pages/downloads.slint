// Download manager.
//
// A WinUI ListView-style queue rather than tiles: each task is one row with a
// state glyph, a title, a state badge, a determinate progress bar and the actions
// that make sense for its state. Every row action maps to real manager state
// (cancel, retry, reveal file); nothing here is decorative.
//
// Alignment note: `TaskRow` is 76px tall and every child is a fixed-size control,
// which a Slint horizontal layout would top-align. The row therefore hands each
// control the row height (`IconButton.row-height`) or wraps it in a full-height
// cell, so the badge, the buttons and the state glyph all share one centre line.

import { Theme, Type } from "../theme.slint";
import {
    AppButton, IconButton, ButtonKind, Divider, StateView, StateKind, Badge, InfoBar,
    InfoKind, PageScroll, ProgressBar, SettingsCard, IconPresenter, IconSlot,
} from "../components.slint";

export struct DownloadRow {
    id: int,
    title: string,
    author: string,
    /// e.g. "第 2 / 5 页"
    subtitle: string,
    /// 0..100, -1 when indeterminate
    progress: int,
    /// 0 queued, 1 running, 2 done, 3 failed, 4 cancelled, 5 skipped
    state: int,
    message: string,
    path: string,
}

/// Row metric, mirrored by the state-colour logic below.
component TaskRow inherits Rectangle {
    in property <DownloadRow> entry;

    callback cancel();
    callback retry();
    callback reveal();

    out property <bool> finished: root.entry.state == 2 || root.entry.state == 5;
    out property <bool> running: root.entry.state == 0 || root.entry.state == 1;

    height: 76px;
    border-radius: Theme.radius-md;
    background: Theme.layer;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-2;
        spacing: Theme.space-3;

        // State glyph in a tinted tile, so the row can be scanned without
        // reading any text.
        Rectangle {
            width: 32px;
            height: 100%;
            Rectangle {
                width: 32px;
                height: 32px;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-md;
                background: root.entry.state == 3 ? Theme.danger-subtle
                    : root.entry.state == 2 ? Theme.success-subtle
                    : root.entry.state == 4 ? Theme.layer-sunken
                    : Theme.accent-subtle;

                IconPresenter {
                    name: root.entry.state == 2 ? "check"
                        : root.entry.state == 3 ? "warning"
                        : root.entry.state == 4 ? "close"
                        : root.entry.state == 5 ? "copy"
                        : "downloads";
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    tint: root.entry.state == 3 ? Theme.danger
                        : root.entry.state == 2 ? Theme.success
                        : root.entry.state == 4 ? Theme.text-tertiary
                        : Theme.accent;
                }
            }
        }

        VerticalLayout {
            spacing: 3px;
            horizontal-stretch: 1;
            // Left-aligned like every other list row: `alignment: center` would
            // centre each line in the column instead of aligning it to the edge.
            alignment: center;

            Text {
                text: root.entry.title;
                color: Theme.text;
                font-size: Theme.font-body;
                overflow: elide;
                vertical-alignment: center;
            }
            Text {
                text: root.entry.author + " · " + root.entry.subtitle;
                color: Theme.text-tertiary;
                font-size: Theme.font-caption;
                overflow: elide;
            }

            if root.running : ProgressBar {
                progress: root.entry.progress < 0 ? 0.0 : root.entry.progress * 1.0 / 100.0;
                indeterminate: root.entry.progress < 0;
                width: 100%;
            }
            if root.entry.state == 3 && root.entry.message != "" : Text {
                text: root.entry.message;
                color: Theme.danger;
                font-size: Theme.font-caption;
                overflow: elide;
            }
        }

        Rectangle {
            width: status-badge.width;
            height: 100%;

            status-badge := Badge {
                y: (parent.height - self.height) / 2;
                label: root.entry.state == 0 ? "等待中"
                    : root.entry.state == 1 ? (root.entry.progress < 0 ? "下载中" : (root.entry.progress + "%"))
                    : root.entry.state == 2 ? "已完成"
                    : root.entry.state == 3 ? "失败"
                    : root.entry.state == 5 ? "已存在"
                    : "已取消";
                fill: root.entry.state == 3 ? Theme.danger-subtle
                    : root.entry.state == 2 ? Theme.success-subtle
                    : root.entry.state == 4 ? Theme.layer-sunken
                    : Theme.accent-subtle;
                ink: root.entry.state == 3 ? Theme.danger
                    : root.entry.state == 2 ? Theme.success
                    : root.entry.state == 4 ? Theme.text-tertiary
                    : Theme.accent;
            }
        }

        // Row actions. Reveal only means something once a file exists; retry only
        // where the task can actually be re-run.
        IconButton {
            icon: "folder";
            tip: root.finished ? "在资源管理器中显示" : "完成后可在此打开";
            size: Theme.control-height-sm;
            row-height: 76px;
            enabled: root.finished;
            clicked => { root.reveal(); }
        }
        IconButton {
            icon: "refresh";
            tip: "重试";
            size: Theme.control-height-sm;
            row-height: 76px;
            visible: root.entry.state == 3 || root.entry.state == 4;
            clicked => { root.retry(); }
        }
        IconButton {
            icon: "dismiss";
            tip: "取消";
            size: Theme.control-height-sm;
            row-height: 76px;
            visible: root.running;
            clicked => { root.cancel(); }
        }
    }
}

export component DownloadsPage inherits Rectangle {
    in property <[DownloadRow]> rows: [];
    in property <int> active-count: 0;
    in property <int> done-count: 0;
    in property <int> failed-count: 0;
    in property <string> directory: "";
    in property <string> template-text: "";

    callback cancel(int);
    callback retry(int);
    callback clear-finished();
    callback choose-directory();
    callback open-folder();
    callback open-task(int);
    callback retry-all();

    background: Theme.canvas;

    page := PageScroll {
        width: 100%;
        height: 100%;
        spacing: Theme.space-3;

        // ---- header ----
        header-block := VerticalLayout {
            spacing: Theme.space-1;
            padding-top: Theme.space-1;

            HorizontalLayout {
                spacing: Theme.space-3;
                alignment: space-between;

                Text {
                    text: "下载管理";
                    color: Theme.text;
                    font-size: Theme.font-page;
                    font-weight: Type.semibold;
                    vertical-alignment: center;
                }

                Text {
                    text: "进行中 " + root.active-count + " · 已完成 " + root.done-count
                        + " · 失败 " + root.failed-count;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }
            }
        }

        // ---- command bar ----
        // `row-height` on each button keeps the whole strip on one centre line
        // even though the buttons are 32px and the strip is taller.
        command-bar := HorizontalLayout {
            spacing: Theme.space-2;
            alignment: start;
            height: Theme.control-height;

            AppButton {
                label: "选择文件夹";
                icon: "folder";
                kind: ButtonKind.Primary;
                clicked => { root.choose-directory(); }
            }
            AppButton {
                label: "打开文件夹";
                icon: "open";
                clicked => { root.open-folder(); }
            }
            AppButton {
                label: "重试全部失败";
                icon: "refresh";
                enabled: root.failed-count > 0;
                clicked => { root.retry-all(); }
            }
            AppButton {
                label: "清空已完成";
                icon: "delete";
                kind: ButtonKind.Subtle;
                enabled: root.done-count > 0;
                clicked => { root.clear-finished(); }
            }
        }

        // ---- destination ----
        destination-card := SettingsCard {
            title: "保存位置";
            icon: "downloads";
            description: "仅用于个人离线浏览你在账号内已经可以查看的作品。";

            VerticalLayout {
                spacing: Theme.space-1;
                Text {
                    text: root.directory;
                    color: Theme.text-secondary;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                }
                Text {
                    text: "文件名模板：" + root.template-text;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-caption;
                    wrap: word-wrap;
                }
            }
        }

        // The empty state absorbs whatever the blocks above it did not use. It is
        // derived from their *measured* heights rather than a guessed constant, so
        // it stays centred at every window size and when a block changes height.
        if root.rows.length == 0 : Rectangle {
            height: max(
                200px,
                page.viewport-height
                    - header-block.preferred-height
                    - command-bar.preferred-height
                    - destination-card.preferred-height
                    - page.spacing * 3
                    - page.padding-y * 2
            );

            StateView {
                width: parent.width;
                height: parent.height;
                kind: StateKind.Empty;
                // A download queue that is empty has nothing to do with a failed
                // image; the state carries its own glyph.
                glyph: "downloads";
                title: "还没有下载任务";
                description: "打开任意作品，点击「下载」或「下载全部」即可加入队列。";
            }
        }

        if root.rows.length > 0 : VerticalLayout {
            spacing: Theme.space-2;

            for row in root.rows : TaskRow {
                entry: row;
                cancel => { root.cancel(row.id); }
                retry => { root.retry(row.id); }
                reveal => { root.open-task(row.id); }
            }
        }
    }
}
