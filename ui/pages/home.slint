// Home: Pixiv's own front page, rendered natively.
//
// Every band below has its own source and its own state, because they come from
// four different endpoints and any one of them can fail without making the page
// useless:
//
//   为你推荐      /ajax/street/for_you          personalised works
//   推荐标签      /ajax/street/recommend_tags   tags for this account
//   最新作品      /ajax/street/latest           the newest works, not personalised
//   推荐画师      /ajax/street/sub              artists, with real avatars
//
// The daily ranking is deliberately absent: it lives on its own page. Falling
// back to it here is what made "为你推荐" show the same 50 works as 排行榜.

import { ScrollView } from "std-widgets.slint";
import { Theme, Type, Emphasis, TextRole } from "../theme.slint";
import { AppButton, ButtonKind, IconSlot, TagChip, PageScroll, StateView, StateKind, Skeleton, ProgressBar, LoadingRow, IllustItem, IllustCard, RecommendTagItem, RecommendUserItem, UserCard, BatchBar, Label, BodyText } from "../components.slint";
import { ArtworkGrid } from "gallery.slint";

/// A band header: title, one line of provenance, and an optional action.
component BandHeader inherits Rectangle {
    in property <string> title: "";
    in property <string> note: "";
    in property <string> glyph: "sparkle";
    in property <bool> show-retry: false;
    callback retry();

    height: 26px;

    HorizontalLayout {
        spacing: Theme.space-2;
        alignment: start;

        IconSlot {
            name: root.glyph;
            slot: Theme.icon-size;
            tint: Theme.accent-fill;
        }
        Label {
            role: TextRole.Small;
            emphasis: Emphasis.Semibold;
            text: root.title;
            color: Theme.text;
        }
        Label {
            role: TextRole.Caption;
            text: root.note;
            color: Theme.text-tertiary;
            horizontal-stretch: 1;
        }
        // U34: a 32 px pill in a 26 px row painted 3 px outside the band on each
        // side. `compact` is what makes the button 26 px tall — the same pair
        // `gallery.slint` already uses on its own band retry (plan §2.1 U34).
        if root.show-retry : AppButton {
            label: "重试";
            icon: "refresh";
            kind: ButtonKind.Secondary;
            compact: true;
            row-height: Theme.control-height-sm;
            clicked => { root.retry(); }
        }
    }
}

export component HomePage inherits Rectangle {
    in property <[[IllustItem]]> columns: [];
    in property <length> card-width: 220px;
    in property <string> count-label: "";
    in property <bool> demo-mode: false;
    in property <bool> loading-more: false;
    in-out property <length> scroll-y: 0px;

    /// 0 content, 1 loading, 2 empty, 3 error
    in property <int> feed-state: 1;
    in property <string> feed-message: "";
    in property <string> source-note: "";

    in property <[RecommendTagItem]> recommend-tags: [];
    in property <int> tags-state: 1;
    in property <string> tags-message: "";

    in property <[IllustItem]> latest: [];
    in property <string> latest-title: "";
    in property <int> latest-state: 1;
    in property <string> latest-message: "";
    /// Cover height of the 最新作品 strip, stated once and read by both the card
    /// and the box it sits in.
    ///
    /// The grid derives a card's cover from its column width
    /// (`column-width * clamped-aspect`), which is what `src/layout.rs` balances.
    /// This strip is one row, so there is nothing to balance: without a stated
    /// cover, the 1.4–1.6 aspects Pixiv serves make a 140 px card 196–224 px of
    /// cover alone, and the 194 px box clipped the title, the author and the
    /// avatar away entirely.
    property <length> latest-cover: 150px;

    in property <[RecommendUserItem]> artists: [];
    in property <int> artists-state: 1;
    in property <string> artists-message: "";

    callback measured(length);
    callback open-illust(string);
    callback open-author(string);
    callback open-recommend-user(string);
    callback toggle-bookmark(string);
    callback open-tag(string);
    callback refresh();
    callback load-more();
    callback action();
    callback retry();

    // ---- round nine: multi-select (F2) ----
    // The frozen seam, identical to the gallery page's: the mode is in-out because
    // the hero toggle and Rust both own intent, and `selected-count` is Rust's.
    in-out property <bool> selection-mode: false;
    in property <int> selected-count: 0;
    callback select-all();
    callback clear-selection();
    callback batch-download();
    callback batch-bookmark();
    /// Enter/leave the mode from the page's own toggle. The page does not assign
    /// `selection-mode` itself: the mode is one decision for the whole window (the
    /// same `Selection::active` Rust owns), so the page reports the gesture and the
    /// shell writes the property the page is bound to.
    callback toggle-selection-mode();
    /// Leave the mode outright — the batch bar's 「完成」.
    callback exit-selection();
    /// The keyboard path into select-all. A callback cannot be invoked from outside
    /// the component that declares it, so the shell's Ctrl+A calls this function,
    /// which fires the page's own `select-all` and lets the shell forward it to Rust
    /// like every other gesture.
    public function request-select-all() { root.select-all(); }
    callback card-clicked(string, bool, bool);
    /// U3/U-f: which card the Tab walk arrived on, by work id, and where it sits in
    /// the scroll body (see `ArtworkGrid`).
    callback card-focused(string, length);
    /// Roving focus cursor for the recommended-tag strip (U7).
    in-out property <int> tag-cursor: 0;

    /// How many placeholder columns to draw.
    ///
    /// A literal four was drawn here, and at the 720 px minimum window the pane
    /// is already compact: the body is 618 px wide and `card-width` resolves to
    /// 195.33 px, so 4 x 195.33 + 3 x 16 = 829 px went into a 618 px box whose
    /// stream has `horizontal-scrollbar-policy: always-off` — a clip, not a
    /// scroll, so the fourth placeholder was sliced off and unreachable. The
    /// resolved grid answers whenever there is one (it is the only thing that
    /// knows); while the first page is still in flight there is no grid, so the
    /// count falls back to the arithmetic `layout::column_count` uses —
    /// (usable + gap) / (card + gap), floored, at least one — instead of a
    /// constant that is only right at one window size.
    property <float> skeleton-columns: root.columns.length > 0
        ? root.columns.length
        : Math.max(1.0, Math.floor(
            (page.body-width + Theme.card-gap)
                / Math.max(1px, root.card-width + Theme.card-gap)));

    /// Width of one card in the 最新作品 strip, placeholder *and* real.
    ///
    /// A11: the skeleton said 130 px and `IllustCard` was handed 140 px, so the strip
    /// jumped 10 px sideways when the first payload landed — and 44 px down, because the
    /// placeholder was 150 px tall against a card that is cover plus caption band. One
    /// property for the width, one height expression for the two states.
    property <length> latest-card-width: 140px;

    /// How many placeholders each strip draws (U26).
    ///
    /// Both bands used to write a literal count — five in 最新作品 and four in 推荐画师 —
    /// which is 714 px and 888 px of skeleton inside a 618 px body at the 720 px
    /// minimum window: the same clip-not-scroll the grid skeleton above was fixed for,
    /// one row over. The arithmetic is `layout::column_count`'s: what fits, floored,
    /// at least one.
    property <float> latest-placeholders: Math.max(1.0, Math.floor(
        (page.body-width + Theme.card-gap)
            / Math.max(1px, root.latest-card-width + Theme.card-gap)));
    property <float> artist-placeholders: Math.max(1.0, Math.floor(
        (page.body-width + Theme.card-gap)
            / Math.max(1px, Theme.artist-card-width + Theme.card-gap)));

    background: Theme.canvas;

    page := PageScroll {
        width: 100%;
        height: 100%;
        scroll-y <=> root.scroll-y;
        spacing: Theme.space-4;
        width-changed(w) => { root.measured(w); }
        scrolled(y) => {
            if (root.feed-state == 0 && !root.loading-more) {
                if (y + page.viewport-height + 600px >= page.body-height) {
                    root.load-more();
                }
            }
        }

        // ---------------- hero ----------------
        Rectangle {
            height: 68px;
            background: transparent;

            HorizontalLayout {
                spacing: Theme.space-4;

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;

                    HorizontalLayout {
                        spacing: Theme.space-2;
                        alignment: start;
                        IconSlot {
                            name: "sparkle";
                            slot: Theme.icon-size-lg;
                            tint: Theme.accent-fill;
                        }
                        Label {
                            role: TextRole.Page;
                            emphasis: Emphasis.Semibold;
                            text: "为你推荐";
                            color: Theme.text;
                        }
                        if root.count-label != "" : Label {
                            role: TextRole.Small;
                            text: root.count-label;
                            color: Theme.text-tertiary;
                        }
                    }

                    Text {
                        text: root.source-note;
                        color: Theme.text-secondary;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }
                }

                AppButton {
                    label: "换一批";
                    icon: "refresh";
                    kind: ButtonKind.Secondary;
                    row-height: 68px;
                    clicked => { root.refresh(); }
                }

                // The pointer way into selection mode — the plan's documented fallback
                // when Ctrl/Shift never arrive in a pointer event. Same shape and same
                // wording as the gallery page's toggle, so the two pages cannot drift.
                AppButton {
                    label: root.selection-mode ? "退出多选" : "多选";
                    icon: root.selection-mode ? "close" : "check";
                    kind: root.selection-mode ? ButtonKind.Primary : ButtonKind.Subtle;
                    compact: true;
                    row-height: 68px;
                    clicked => { root.toggle-selection-mode(); }
                }
            }
        }

        // ---------------- recommended tags ----------------
        if root.tags-state != 2 : VerticalLayout {
            spacing: Theme.space-2;

            BandHeader {
                title: "推荐标签";
                note: root.tags-state == 3 ? root.tags-message : "点击标签直接搜索";
                glyph: "tag";
                show-retry: root.tags-state == 3;
                retry => { root.refresh(); }
            }

            if root.tags-state == 1 : HorizontalLayout {
                spacing: Theme.space-2;
                alignment: start;
                height: 32px;
                for n in [0, 1, 2, 3, 4, 5] : Skeleton {
                    width: 72px;
                    height: 30px;
                    // G27: 30 in a 32 row, centred — it used to sit 2px high.
                    y: (parent.height - self.height) / 2;
                    border-radius: Theme.radius-pill;
                }
            }

            // Two bands: 26px of chip and, below it, the 14px horizontal
            // scrollbar the ScrollView draws. 34px was one band for both: the
            // chips ended at y=208 and the scrollbar thumb started at y=209, so
            // the bar sat on the chip baseline (measured on the 720px window,
            // where twelve demo tags overflow the viewport and the bar is
            // actually drawn). 44px keeps the chip row where it was and gives the
            // bar its own band with 8px of clearance at hover height.
            if root.tags-state == 0 : Rectangle {
                height: 44px;
                clip: true;

                ScrollView {
                    width: 100%;
                    height: 100%;
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;

                    HorizontalLayout {
                        spacing: Theme.space-2;
                        alignment: start;
                        // U7: one Tab stop for the strip; Left/Right walk it.
                        for t[i] in root.recommend-tags : TagChip {
                            label: t.label;
                            active: t.emphasized;
                            index: i;
                            cursor: root.tag-cursor;
                            gained-focus(idx) => { root.tag-cursor = idx; }

                            move-cursor(d) => {
                                root.tag-cursor = Math.max(0, Math.min(
                                    root.recommend-tags.length - 1, root.tag-cursor + d));
                            }
                            clicked => { root.open-tag(t.name); }
                        }
                    }
                }
            }
        }

        // ---------------- for you ----------------
        BandHeader {
            title: "为你推荐的作品";
            note: "Pixiv 按你的收藏与浏览生成，与排行榜无关";
            glyph: "home";
        }

        if root.feed-state == 0 : ArtworkGrid {
            columns: root.columns;
            card-width: root.card-width;
            open-illust(id) => { root.open-illust(id); }
            open-author(id) => { root.open-author(id); }
            toggle-bookmark(id) => { root.toggle-bookmark(id); }
            card-clicked(id, ctrl, shift) => { root.card-clicked(id, ctrl, shift); }
            card-focused(id, y) => { root.card-focused(id, y); }
        }

        if root.feed-state == 1 : HorizontalLayout {
            spacing: Theme.card-gap;
            alignment: start;
            height: 380px;
            for n in root.skeleton-columns : VerticalLayout {
                spacing: Theme.card-gap;
                width: root.card-width;
                alignment: start;
                Skeleton { height: root.card-width * 1.25; }
                Skeleton { height: 44px; }
            }
        }

        if root.feed-state > 1 : Rectangle {
            height: 200px;
            StateView {
                width: parent.width;
                height: parent.height;
                kind: (root.feed-state == 3) ? StateKind.Error : StateKind.Empty;
                title: (root.feed-state == 3) ? "推荐内容载入失败" : "暂时没有推荐作品";
                description: root.feed-message;
                action-label: (root.feed-state == 3) ? "重试" : "";
                retry => { root.retry(); }
                action => { root.action(); }
            }
        }

        if root.feed-state == 0 && root.loading-more : Rectangle {
            height: 40px;
            LoadingRow {
                y: (parent.height - self.height) / 2;
            }
        }

        // ---------------- latest ----------------
        VerticalLayout {
            spacing: Theme.space-2;

            BandHeader {
                title: root.latest-title == "" ? "最新作品" : root.latest-title;
                note: root.latest-state == 3 ? root.latest-message : "全站最新投稿，与推荐无关";
                glyph: "clock";
                show-retry: root.latest-state == 3;
                retry => { root.refresh(); }
            }

            // Both states of the band state the same height, so the page does not
            // jump by a caption band when the strip's first payload lands.
            if root.latest-state == 1 : HorizontalLayout {
                spacing: Theme.card-gap;
                alignment: start;
                height: root.latest-cover + Theme.card-caption-height + Theme.scrollbar-gutter;
                for n in root.latest-placeholders : Skeleton {
                    // The whole card, caption band included: the band is part of the box
                    // that resolves, so a skeleton without it pulls everything below up
                    // when the payload lands.
                    width: root.latest-card-width;
                    height: root.latest-cover + Theme.card-caption-height;
                    // G27: the strip's cards are top-aligned on purpose; say so.
                    y: 0px;
                    border-radius: Theme.radius-md;
                }
            }

            if root.latest-state == 0 : Rectangle {
                // The card's real height — the same cover the card below is told to
                // use, plus its caption band — and then one overlay-scrollbar band:
                // the bar is 14 px and paints over the bottom of the ScrollView,
                // and the caption's own ink (the author row) ends 4 px above its
                // band, so the 10 px gutter keeps every glyph clear of it.
                height: root.latest-cover + Theme.card-caption-height + Theme.scrollbar-gutter;
                clip: true;

                ScrollView {
                    width: 100%;
                    height: 100%;
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;

                    HorizontalLayout {
                        spacing: Theme.card-gap;
                        alignment: start;
                        for it in root.latest : IllustCard {
                            item: it;
                            column-width: root.latest-card-width;
                            cover-height-override: root.latest-cover;
                            show-author: true;
                            open => { root.open-illust(it.id); }
                            open-author => { root.open-author(it.author-id); }
                            toggle-bookmark => { root.toggle-bookmark(it.id); }
                        }
                    }
                }
            }

            // Two states the band used to answer with silence: `2` is BAND_EMPTY
            // (what demo mode sets, src/app/feed/home.rs:411, and what an empty
            // payload resolves to, :505) and `3` is BAND_ERROR, which only ever
            // reached the header note. Both follow the artists band twelve lines
            // below: one 40 px line carrying the band's own message, so the band
            // does not collapse to a bare heading.
            if root.latest-state == 2 : Label {
                role: TextRole.Small;
                height: 40px;
                text: root.latest-message;
                color: Theme.text-tertiary;
            }

            // The error line carries its own retry inside the band. BandHeader's
            // `show-retry` button calls the same root.refresh(), so the two
            // affordances cannot disagree about what "retry" means.
            if root.latest-state == 3 : HorizontalLayout {
                height: 40px;
                spacing: Theme.space-2;
                alignment: start;

                Label {
                    role: TextRole.Small;
                    text: root.latest-message;
                    color: Theme.text-secondary;
                    horizontal-stretch: 1;
                }
                AppButton {
                    label: "重试";
                    icon: "refresh";
                    kind: ButtonKind.Subtle;
                    compact: true;
                    row-height: 40px;
                    clicked => { root.refresh(); }
                }
            }
        }

        // ---------------- recommended artists ----------------
        VerticalLayout {
            spacing: Theme.space-2;

            BandHeader {
                title: "推荐画师";
                note: root.artists-state == 3 ? root.artists-message : "头像与近作来自 Pixiv，点击进入作者主页";
                glyph: "artist";
                show-retry: root.artists-state == 3;
                retry => { root.refresh(); }
            }

            if root.artists-state == 1 : HorizontalLayout {
                spacing: Theme.card-gap;
                alignment: start;
                height: Theme.artist-strip-height;
                for n in root.artist-placeholders : Skeleton {
                    width: Theme.artist-card-width;
                    height: Theme.artist-strip-height;
                    border-radius: Theme.radius-lg;
                }
            }

            if root.artists-state == 0 : Rectangle {
                height: Theme.artist-strip-height;
                clip: true;

                ScrollView {
                    width: 100%;
                    height: 100%;
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;

                    HorizontalLayout {
                        spacing: Theme.card-gap;
                        alignment: start;
                        for u in root.artists : UserCard {
                            item: u;
                            card-width: Theme.artist-card-width;
                            open => { root.open-recommend-user(u.id); }
                        }
                    }
                }
            }

            if root.artists-state == 2 : Label {
                role: TextRole.Small;
                height: 40px;
                text: root.artists-message;
                color: Theme.text-tertiary;
            }
        }

        // Room for the floating batch bar (F2), only while it exists.
        if root.selection-mode : Rectangle {
            height: Theme.batch-bar-height + Theme.space-3;
        }
    }

    // ---- floating batch bar (F2) ----
    if root.selection-mode : BatchBar {
        x: Theme.space-3;
        width: max(0px, root.width - Theme.space-3 * 2);
        y: root.height - self.height - Theme.space-3;
        count: root.selected-count;
        select-all => { root.select-all(); }
        clear-selection => { root.clear-selection(); }
        batch-download => { root.batch-download(); }
        batch-bookmark => { root.batch-bookmark(); }
        close => { root.exit-selection(); }
    }
}
