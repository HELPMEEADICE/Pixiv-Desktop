// Reusable artwork-browsing page.
//
// Home, Discovery, Ranking, Search, Bookmarks, History and Artist all render
// artwork the same way, so the page skeleton and the masonry column renderer are
// implemented exactly once. The *column maths* lives in Rust (`src/layout.rs`)
// because the distribution must be height-balanced rather than round-robin, and
// because it needs to survive `load-more` without reshuffling what is already on
// screen.
//
// Scroll model: one `PageScroll` per page. The header, the tag strip, the column
// grid and the load-more footer all live inside that single scroll body, so the
// vertical scrollbar is at the right edge of the viewport and the body is
// exactly as wide as the viewport (see `PageScroll` in components.slint).

import { ScrollView } from "std-widgets.slint";
import { Theme, Type } from "../theme.slint";
import {
    IllustCard, IllustItem, StateView, StateKind, Skeleton, TagChip, AppButton,
    ButtonKind, PageScroll, ProgressBar, Divider,
} from "../components.slint";

/// The masonry columns themselves. No scroll view, no header: callers embed this
/// inside their own scroll body so the grid can sit under page-specific content.
export component ArtworkGrid inherits Rectangle {
    in property <[[IllustItem]]> columns: [];
    in property <length> card-width: 220px;
    in property <bool> show-author: true;

    callback open-illust(string);
    callback open-author(string);
    callback toggle-bookmark(string);

    height: cols.preferred-height;
    width: cols.preferred-width;

    cols := HorizontalLayout {
        alignment: start;
        spacing: Theme.card-gap;

        for col in root.columns : VerticalLayout {
            spacing: Theme.card-gap;
            width: root.card-width;
            alignment: start;

            for it in col : IllustCard {
                item: it;
                column-width: root.card-width;
                show-author: root.show-author;
                open => { root.open-illust(it.id); }
                open-author => { root.open-author(it.author-id); }
                toggle-bookmark => { root.toggle-bookmark(it.id); }
            }
        }
    }
}

/// Full artwork page: header, optional filter row, optional tag strip, grid, and
/// the loading / empty / error / locked states.
export component GalleryPage inherits Rectangle {
    in property <[[IllustItem]]> columns: [];
    in property <length> card-width: 220px;
    /// 0 content, 1 loading, 2 empty, 3 error, 4 locked (needs sign-in).
    in property <int> state: 0;
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <string> message: "";
    in property <string> action-label: "";
    in property <[string]> tags: [];
    in property <string> active-tag: "";
    /// Ranking period / search sort chips.
    in property <[string]> filters: [];
    in property <int> active-filter: -1;
    in property <string> count-label: "";
    in property <bool> loading-more: false;
    in property <bool> show-header: true;
    /// Preserved across page switches so navigation does not lose scroll position.
    in-out property <length> scroll-y: 0px;
    /// Measured content width, forwarded to Rust so the column count comes from
    /// the real layout rather than from a guess at the window size.
    callback measured(length);

    callback open-illust(string);
    callback open-author(string);
    callback toggle-bookmark(string);
    callback open-tag(string);
    callback select-filter(int);
    callback retry();
    callback action();
    callback load-more();

    background: Theme.canvas;

    page := PageScroll {
        width: 100%;
        height: 100%;
        scroll-y <=> root.scroll-y;
        spacing: Theme.space-3;
        width-changed(w) => { root.measured(w); }
        // Near-bottom detection: ask for the next page well before the user hits
        // the floor, so the feed never stalls at an empty edge.
        scrolled(y) => {
            if (root.state == 0 && !root.loading-more) {
                if (y + page.viewport-height + 600px >= page.body-height) {
                    root.load-more();
                }
            }
        }

        // ---------------- header ----------------
        if root.show-header : VerticalLayout {
            spacing: Theme.space-1;
            padding-top: Theme.space-1;

            HorizontalLayout {
                spacing: Theme.space-3;
                alignment: end;

                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: Theme.font-page;
                    font-weight: Type.semibold;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                if root.count-label != "" : Text {
                    text: root.count-label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }
            }

            if root.subtitle != "" : Text {
                text: root.subtitle;
                color: Theme.text-secondary;
                font-size: Theme.font-small;
                overflow: elide;
            }
        }

        // ---------------- filters ----------------
        if root.filters.length > 0 : HorizontalLayout {
            spacing: Theme.space-2;
            alignment: start;

            for f[i] in root.filters : AppButton {
                label: f;
                kind: (i == root.active-filter) ? ButtonKind.Primary : ButtonKind.Secondary;
                compact: true;
                clicked => { root.select-filter(i); }
            }
        }

        // ---------------- tag strip ----------------
        // A dedicated horizontal scroller: chips must never be clipped by the
        // body width, and a wrapping row is not expressible in Slint's layout
        // model without a Rust-side line breaker.
        if root.tags.length > 0 : Rectangle {
            height: 40px;
            clip: true;

            ScrollView {
                width: 100%;
                height: 100%;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;

                HorizontalLayout {
                    padding-top: Theme.space-1;
                    spacing: Theme.space-2;
                    alignment: start;

                    for t in root.tags : TagChip {
                        label: t;
                        active: t == root.active-tag;
                        clicked => { root.open-tag(t); }
                    }
                }
            }
        }

        Divider { }

        // ---------------- loading skeleton ----------------
        if root.state == 1 : HorizontalLayout {
            spacing: Theme.card-gap;
            alignment: start;
            height: 420px;

            for n in [0, 1, 2, 3] : VerticalLayout {
                spacing: Theme.card-gap;
                width: root.card-width;
                alignment: start;
                Skeleton { height: root.card-width * 1.25; }
                Skeleton { height: root.card-width * 0.7; }
            }
        }

        // ---------------- content ----------------
        if root.state == 0 : ArtworkGrid {
            columns: root.columns;
            card-width: root.card-width;
            open-illust(id) => { root.open-illust(id); }
            open-author(id) => { root.open-author(id); }
            toggle-bookmark(id) => { root.toggle-bookmark(id); }
        }

        // ---------------- empty / error / locked ----------------
        if root.state > 1 : Rectangle {
            height: max(240px, page.viewport-height - 180px);

            StateView {
                width: parent.width;
                height: parent.height;
                kind: (root.state == 3) ? StateKind.Error
                    : (root.state == 4) ? StateKind.Locked
                    : StateKind.Empty;
                title: root.title;
                description: root.message;
                action-label: root.action-label;
                retry => { root.retry(); }
                action => { root.action(); }
            }
        }

        // ---------------- infinite-scroll footer ----------------
        if root.state == 0 && root.loading-more : Rectangle {
            height: 48px;

            VerticalLayout {
                alignment: center;
                spacing: Theme.space-2;

                ProgressBar { indeterminate: true; width: 120px; }
                Text {
                    text: "正在加载更多…";
                    color: Theme.text-tertiary;
                    font-size: Theme.font-caption;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
