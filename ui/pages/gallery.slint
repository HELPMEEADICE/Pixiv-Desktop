// Reusable artwork-browsing page.
//
// Home, Discovery, Ranking, Search, Bookmarks, History and Artist all render
// artwork the same way, so the page skeleton and the masonry column renderer are
// implemented exactly once. The *column maths* lives in Rust (`src/layout.rs`)
// because the distribution must be height-balanced rather than round-robin, and
// because it needs to survive `load-more` without reshuffling what is already on
// screen.
//
// Scroll model: one `PageScroll` per page. The header, the tag strip, the column
// grid and the load-more footer all live inside that single scroll body, so the
// vertical scrollbar is at the right edge of the viewport and the body is
// exactly as wide as the viewport (see `PageScroll` in components.slint).

import { ScrollView } from "std-widgets.slint";
import { Theme, Type, Emphasis, TextRole } from "../theme.slint";
import { IllustCard, IllustItem, StateView, StateKind, Skeleton, TagChip, AppButton, ButtonKind, PageScroll, ProgressBar, LoadingRow, Divider, RecommendUserItem, UserCard, BatchBar, SegmentedControl, Label, BodyText, ToggleSwitch } from "../components.slint";

/// The masonry columns themselves. No scroll view, no header: callers embed this
/// inside their own scroll body so the grid can sit under page-specific content.
export component ArtworkGrid inherits Rectangle {
    in property <[[IllustItem]]> columns: [];
    /// Column width, clamped to the band `src/layout.rs` balances against. The two
    /// bounds were the theme's only unread tokens (U32); reading them here is what
    /// makes the constant pair a contract instead of a comment.
    in property <length> card-width: Math.max(
        Theme.card-min-width, Math.min(Theme.card-max-width, 220px));
    in property <bool> show-author: true;

    callback open-illust(string);
    callback open-author(string);
    callback toggle-bookmark(string);
    /// Round nine (F2): a card reported a click. The modifiers are forwarded as
    /// they arrived — `false` for both when the platform did not deliver them, which
    /// is why the page also carries an explicit selection-mode toggle instead of
    /// betting the feature on Ctrl/Shift reaching `TouchArea.pointer-event`.
    callback card-clicked(string, bool, bool);
    /// U3: a card took the keyboard focus. The argument is the work id, not a
    /// position: `columns` is a height-balanced reshuffle of `items`, so no element
    /// of this layout can name a card's index in the feed. Rust owns `items` and
    /// resolves the id to the index the scroll offset needs.
    callback card-focused(string, length);

    /// Columns are summed into one content-space offset below: a card reports its
    /// `y` inside its own column, and this is the `y` of the whole grid inside the
    /// page body, so `card y + grid y` is the position the shell scrolls to (U-f).
    property <length> grid-y: root.y;

    height: cols.preferred-height;
    width: cols.preferred-width;

    cols := HorizontalLayout {
        alignment: start;
        spacing: Theme.card-gap;

        for col in root.columns : VerticalLayout {
            spacing: Theme.card-gap;
            width: root.card-width;
            alignment: start;

            for it in col : IllustCard {
                item: it;
                column-width: root.card-width;
                show-author: root.show-author;
                // The frozen F2 seam: `selected` is the item's, `selectable` decides
                // whether the 22 px check is drawn at all. Both default from the item,
                // so a producer that never sets them gets exactly today's card.
                selected: it.selected;
                open => { root.open-illust(it.id); }
                open-author => { root.open-author(it.author-id); }
                toggle-bookmark => { root.toggle-bookmark(it.id); }
                clicked-with(ctrl, shift) => { root.card-clicked(it.id, ctrl, shift); }
                gained-focus(y) => { root.card-focused(it.id, y + root.grid-y); }
            }
        }
    }
}

/// Full artwork page: header, optional filter row, optional tag strip, grid, and
/// the loading / empty / error / locked states.
export component GalleryPage inherits Rectangle {
    in property <[[IllustItem]]> columns: [];
    in property <length> card-width: 220px;
    /// 0 content, 1 loading, 2 empty, 3 error, 4 locked (needs sign-in).
    in property <int> state: 0;
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <string> message: "";
    in property <string> action-label: "";
    in property <[string]> tags: [];
    in property <string> active-tag: "";
    /// Ranking period / search sort chips.
    in property <[string]> filters: [];
    in property <int> active-filter: -1;
    in property <string> count-label: "";
    in property <bool> loading-more: false;
    in property <bool> show-header: true;
    /// Previous search terms, newest first, from the local store. Rendered as
    /// chips on the empty search state so the history the app already records is
    /// actually usable instead of being write-only.
    in property <[string]> recent-searches: [];
    /// Copy for the empty/error/locked block. A page's *title* is not a state
    /// title: the search page's heading and its "nothing here" headline used to be
    /// the same string, which read as a bug.
    in property <string> state-title: "";
    /// Glyph for that block; empty means "derive from the state kind". The search
    /// prompt must not be illustrated with a picture-unavailable icon.
    in property <string> state-glyph: "";
    /// Preserved across page switches so navigation does not lose scroll position.
    in-out property <length> scroll-y: 0px;
    /// Measured content width, forwarded to Rust so the column count comes from
    /// the real layout rather than from a guess at the window size.
    callback measured(length);

    callback open-illust(string);
    callback open-author(string);
    callback toggle-bookmark(string);
    callback open-tag(string);
    callback select-filter(int);
    callback retry();
    callback action();
    callback load-more();
    callback pick-search(string);
    /// Recommended artists, shown only on the discovery page. Empty elsewhere,
    /// which is what keeps one page component serving five destinations without
    /// pretending they all have the same sources.
    in property <[RecommendUserItem]> recommend-users: [];
    in property <int> recommend-users-state: 2;
    in property <string> recommend-users-message: "";
    callback open-user(string);

    // ---- round nine: multi-select (F2) ----
    // The frozen seam. `selection-mode` is in-out because the mode is entered from
    // two places that both own intent: the header toggle below (the plan's fallback
    // when Ctrl/Shift never reach a pointer event) and Rust, which may enter it on a
    // Ctrl+click. `selected-count` is Rust's, from `Selection::ids`.
    in-out property <bool> selection-mode: false;
    in property <int> selected-count: 0;
    callback select-all();
    callback clear-selection();
    callback batch-download();
    callback batch-bookmark();
    /// Enter/leave the mode from the page's own toggle. The page does not assign
    /// `selection-mode` itself: the mode is one decision for the whole window (the
    /// same `Selection::active` Rust owns), so the page reports the gesture and the
    /// shell writes the property the page is bound to.
    callback toggle-selection-mode();
    /// Leave the mode outright — the batch bar's 「完成」.
    callback exit-selection();
    /// The keyboard path into select-all. A callback cannot be invoked from outside
    /// the component that declares it, so the shell's Ctrl+A calls this function,
    /// which fires the page's own `select-all` and lets the shell forward it to Rust
    /// like every other gesture.
    public function request-select-all() { root.select-all(); }
    /// A card was clicked with the keys that were (or were not) delivered.
    callback card-clicked(string, bool, bool);
    /// U3/U-f: which card the Tab walk arrived on, by work id, and where it sits in
    /// the scroll body (see `ArtworkGrid`).
    callback card-focused(string, length);

    // ---- round eleven (docs/OPTIMIZATION-PLAN-R11.md §1): frozen seams ----
    // Track D fills these; every default is empty or zero, so a page that never
    // fills them draws exactly what it drew before this round — no empty group and
    // no empty chip row.
    in property <[string]> sort-labels: [];
    in-out property <int> sort-index: 0;
    in-out property <int> mode-index: 0;
    callback sort-chosen(int);
    callback mode-chosen(int);
    in property <[string]> related-tags: [];
    callback related-tag-chosen(string);
    /// The sort group's name for assistive technology, from the owner that fills
    /// `sort-labels`: the control may not invent a label (§3, G31).
    in property <string> sort-label: "";
    /// The match-mode group's labels and name. Neither is in the plan's table, and
    /// that is what lets the second group honour "draw nothing today": the sort
    /// labels arrive with the seam, these do not, so the mode control has no items
    /// until the owner of `mode-index` also fills them (U28's rule, one surface
    /// over: the page reports, the model writes).
    in property <[string]> mode-labels: [];
    in property <string> mode-label: "";
    /// Roving focus cursor for the related-tag row: the strip is one Tab stop and
    /// Left/Right walk it, exactly as the tag strip above does (U7).
    in-out property <int> related-cursor: 0;
    /// F4: 「排除 AI」. The page reports the gesture and never writes the value: the
    /// flag is one fact of the search request, so Rust owns it (`FeedControls`), and
    /// it is read when the *next* request is issued.
    in property <bool> exclude-ai: false;
    callback exclude-ai-toggled(bool);

    /// Roving focus cursors for the two chip rows on this page (U7). A strip is one
    /// Tab stop: Left/Right move this index and the chip that owns it takes focus.
    in-out property <int> tag-cursor: 0;
    in-out property <int> recent-cursor: 0;

    /// How many placeholder columns to draw.
    ///
    /// A literal four was drawn here, and at the 720 px minimum window the body is
    /// 618 px wide with `card-width` resolved to 195.33 px: 4 x 195.33 + 3 x 16 =
    /// 829 px in a stream whose `horizontal-scrollbar-policy` is `always-off`
    /// (components.slint:1190) - a clip, not a scroll, so the fourth placeholder
    /// was sliced off and unreachable. The resolved grid answers whenever it
    /// exists; while the first page is in flight there is no grid, so the count
    /// falls back to the arithmetic `layout::column_count` uses -
    /// (usable + gap) / (card + gap), floored, at least one.
    property <float> skeleton-columns: root.columns.length > 0
        ? root.columns.length
        : Math.max(1.0, Math.floor(
            (page.body-width + Theme.card-gap)
                / Math.max(1px, root.card-width + Theme.card-gap)));

    background: Theme.canvas;

    page := PageScroll {
        width: 100%;
        height: 100%;
        scroll-y <=> root.scroll-y;
        spacing: Theme.space-3;
        width-changed(w) => { root.measured(w); }
        // Near-bottom detection: ask for the next page well before the user hits
        // the floor, so the feed never stalls at an empty edge.
        scrolled(y) => {
            if (root.state == 0 && !root.loading-more) {
                if (y + page.viewport-height + 600px >= page.body-height) {
                    root.load-more();
                }
            }
        }

        // ---------------- header ----------------
        if root.show-header : VerticalLayout {
            spacing: Theme.space-1;
            padding-top: Theme.space-1;

            HorizontalLayout {
                spacing: Theme.space-3;
                // space-between and *not* end: with end, the title shrank to its
                // preferred width and the whole header drifted to the right edge.
                alignment: space-between;

                Label {
                    role: TextRole.Page;
                    emphasis: Emphasis.Semibold;
                    text: root.title;
                    color: Theme.text;
                }

                // The pointer-only way into selection mode, and the reason F2 does not
                // depend on modifiers surviving `TouchArea.pointer-event`: one control
                // that flips the mode the bar and the cards already understand. `kind`
                // swaps so the button reads as a toggle, as WinUI's does.
                //
                // It is `compact` (26 px) and carries no `row-height`, and it shares one
                // cell with the count label instead of becoming a third child of this
                // `space-between` row: a 32 px control made the *row* 32 px tall (the
                // 20 px title is 27), so every pixel below — the whole masonry — moved
                // down with it. Measured by the visual gate: discovery 20.87 % over,
                // rows 107..1112, which is a shifted page, not a new control.
                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: end;

                    if root.count-label != "" : Label {
                        role: TextRole.Small;
                        text: root.count-label;
                        color: Theme.text-tertiary;
                    }

                    // A12: the button states its own 26 px height and sits in the row like
                    // any other child.
                    //
                    // It used to be wrapped in a `height: 0px` cell and lifted with
                    // `y: -one step`, on the theory that a 32 px control in a 27 px row moved
                    // the masonry down (measured then: discovery 20.87 % over, rows 107..1112).
                    // The wrapper did hold the row at 23.3 px, and it also made the button's
                    // hit area overflow the header: 4 px up over the subtitle and the rest of
                    // its box below the row, so the end of the subtitle pressed 多选.
                    // `compact` is 26 px — under the 27 px of the title row — so the row does
                    // not grow and nothing overflows.
                    select-toggle := AppButton {
                        label: root.selection-mode ? "退出多选" : "多选";
                        icon: root.selection-mode ? "close" : "check";
                        kind: root.selection-mode ? ButtonKind.Primary : ButtonKind.Subtle;
                        compact: true;
                        height: Theme.control-height-sm;
                        clicked => { root.toggle-selection-mode(); }
                    }
                }
            }

            if root.subtitle != "" : Label {
                role: TextRole.Small;
                text: root.subtitle;
                color: Theme.text-secondary;
            }
        }

        // ---------------- filters ----------------
        if root.filters.length > 0 : HorizontalLayout {
            spacing: Theme.space-2;
            alignment: start;

            for f[i] in root.filters : AppButton {
                label: f;
                kind: (i == root.active-filter) ? ButtonKind.Primary : ButtonKind.Secondary;
                compact: true;
                clicked => { root.select-filter(i); }
            }
        }

        // ---------------- round eleven: sort and match mode ----------------
        // Two groups, both composed from the shared `SegmentedControl`. They report
        // the index the gesture picked and never assign `sort-index`/`mode-index`:
        // those belong to the model that owns the query (§2.1 U28).
        if root.sort-labels.length > 0 : HorizontalLayout {
            spacing: Theme.space-2;
            alignment: start;
            height: Theme.control-height;

            SegmentedControl {
                label: root.sort-label == "" ? "排序方式" : root.sort-label;
                items: root.sort-labels;
                current: root.sort-index;
                selected(i) => { root.sort-chosen(i); }
            }

            if root.mode-labels.length > 0 : SegmentedControl {
                label: root.mode-label == "" ? "匹配方式" : root.mode-label;
                items: root.mode-labels;
                current: root.mode-index;
                selected(i) => { root.mode-chosen(i); }
            }

            // F4: the AI filter, in the same 32 px control row so the group, the mode
            // and the filter read as one line of settings. The caption names what the
            // switch does; the switch itself carries the accessible name.
            HorizontalLayout {
                spacing: Theme.space-2;
                alignment: end;

                Label {
                    role: TextRole.Caption;
                    text: "AI 作品";
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }

                ToggleSwitch {
                    y: (parent.height - self.height) / 2;
                    label: "排除 AI 生成的作品";
                    checked: root.exclude-ai;
                    toggled(on) => { root.exclude-ai-toggled(on); }
                }
            }
        }

        // ---------------- round eleven: related tags ----------------
        // The same two-band strip the tag row above uses (chip band, then the
        // scrollbar's own band), drawn only when the owner has tags to offer.
        if root.related-tags.length > 0 : Rectangle {
            height: 48px;
            clip: true;

            ScrollView {
                width: 100%;
                height: 100%;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;

                HorizontalLayout {
                    padding-top: Theme.space-1;
                    spacing: Theme.space-2;
                    alignment: start;

                    for t[i] in root.related-tags : TagChip {
                        label: t;
                        index: i;
                        cursor: root.related-cursor;
                        gained-focus(idx) => { root.related-cursor = idx; }
                        move-cursor(d) => {
                            root.related-cursor = Math.max(0, Math.min(
                                root.related-tags.length - 1, root.related-cursor + d));
                        }
                        clicked => { root.related-tag-chosen(t); }
                    }
                }
            }
        }

        // ---------------- tag strip ----------------
        // A dedicated horizontal scroller: chips must never be clipped by the
        // body width, and a wrapping row is not expressible in Slint's layout
        // model without a Rust-side line breaker.
        //
        // The strip is two bands, not one: 4px + 26px of chip along the top and
        // the 14px horizontal scrollbar the ScrollView draws along the bottom. At
        // 40px the bar's band started at y=26 of the strip, i.e. inside the chip
        // row, and its thumb sat on the chip baseline. 48px puts the bar in a band
        // of its own — chips 4..30, bar 34..48, thumb top at 42 — so it can
        // neither be painted over the chips nor be pressed through them. The
        // identical strip on the home page carries the same fix and was measured
        // there (see `home.slint`): chip bottom 208, thumb top 219 after, 209
        // before. The bar keeps its `as-needed` policy: it is the only way to
        // reach the chips past the viewport, so it must not be turned off.
        if root.tags.length > 0 : Rectangle {
            height: 48px;
            clip: true;

            ScrollView {
                width: 100%;
                height: 100%;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;

                HorizontalLayout {
                    padding-top: Theme.space-1;
                    spacing: Theme.space-2;
                    alignment: start;

                    // U7: one stop for the whole strip. `index`/`cursor` make exactly
                    // one chip focusable, Left/Right walk the row, Enter/Space search it.
                    for t[i] in root.tags : TagChip {
                        label: t;
                        active: t == root.active-tag;
                        index: i;
                        cursor: root.tag-cursor;
                        gained-focus(idx) => { root.tag-cursor = idx; }

                        move-cursor(d) => {
                            root.tag-cursor = Math.max(0, Math.min(root.tags.length - 1, root.tag-cursor + d));
                        }
                        clicked => { root.open-tag(t); }
                    }
                }
            }
        }

        // ---------------- recommended artists (discovery only) ----------------
        if root.recommend-users-state == 0 && root.recommend-users.length > 0 : VerticalLayout {
            spacing: Theme.space-2;

            HorizontalLayout {
                spacing: Theme.space-2;
                alignment: start;
                Label {
                    role: TextRole.Small;
                    emphasis: Emphasis.Semibold;
                    text: "推荐画师";
                    color: Theme.text;
                }
                Label {
                    role: TextRole.Caption;
                    text: "来自 /ajax/discovery/users，点击进入作者主页";
                    color: Theme.text-tertiary;
                    horizontal-stretch: 1;
                }
            }

            Rectangle {
                height: Theme.artist-strip-height;
                clip: true;

                ScrollView {
                    width: 100%;
                    height: 100%;
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;

                    HorizontalLayout {
                        spacing: Theme.card-gap;
                        alignment: start;
                        for u in root.recommend-users : UserCard {
                            item: u;
                            card-width: Theme.artist-card-width;
                            open => { root.open-user(u.id); }
                        }
                    }
                }
            }
        }

        // A failed /ajax/discovery/users request used to draw nothing at all: the
        // only branch above requires state == 0 and a non-empty list, so the whole
        // artist band disappeared with no text and no way to retry - and the
        // message the shell fills (main.slint:812) was read by no page. This branch
        // is the band's error state, worded and retried exactly as the page's other
        // bands are: root.retry() is grid-retry, which on Discovery re-requests the
        // users alongside the works (src/app/callbacks/feed.rs:55).
        if root.recommend-users-state == 3 : VerticalLayout {
            spacing: Theme.space-2;

            HorizontalLayout {
                spacing: Theme.space-2;
                alignment: start;

                Label {
                    role: TextRole.Small;
                    emphasis: Emphasis.Semibold;
                    text: "推荐画师";
                    color: Theme.text;
                }
                Label {
                    role: TextRole.Caption;
                    text: root.recommend-users-message;
                    color: Theme.text-secondary;
                    horizontal-stretch: 1;
                }
                AppButton {
                    label: "重试";
                    icon: "refresh";
                    kind: ButtonKind.Subtle;
                    compact: true;
                    row-height: Theme.control-height-sm;
                    clicked => { root.retry(); }
                }
            }
        }

        Divider { }

        // ---------------- loading skeleton ----------------
        if root.state == 1 : HorizontalLayout {
            spacing: Theme.card-gap;
            alignment: start;
            height: 420px;

            for n in root.skeleton-columns : VerticalLayout {
                spacing: Theme.card-gap;
                width: root.card-width;
                alignment: start;
                Skeleton { height: root.card-width * 1.25; }
                Skeleton { height: root.card-width * 0.7; }
            }
        }

        // ---------------- content ----------------
        if root.state == 0 : ArtworkGrid {
            columns: root.columns;
            card-width: root.card-width;
            open-illust(id) => { root.open-illust(id); }
            open-author(id) => { root.open-author(id); }
            toggle-bookmark(id) => { root.toggle-bookmark(id); }
            card-clicked(id, ctrl, shift) => { root.card-clicked(id, ctrl, shift); }
            card-focused(id, y) => { root.card-focused(id, y); }
        }

        // ---------------- empty / error / locked ----------------
        //
        // Sized to the viewport so a single short message does not leave the page
        // looking half-built, but the recent-search chips sit directly under the
        // message: they are the next thing to click, so they belong next to the
        // prompt rather than pinned to the bottom of the window.
        if root.state > 1 : Rectangle {
            height: max(240px, page.viewport-height - 180px);

            VerticalLayout {
                alignment: center;
                spacing: Theme.space-3;

                StateView {
                    width: 100%;
                    kind: (root.state == 3) ? StateKind.Error
                        : (root.state == 4) ? StateKind.Locked
                        : StateKind.Empty;
                    // The page title is the *page's* name, not the state's: reusing it
                    // made the empty search state read "搜索" under a heading that
                    // already said "搜索", next to a picture-unavailable glyph.
                    glyph: root.state-glyph;
                    title: root.state-title != "" ? root.state-title : root.title;
                    description: root.message;
                    action-label: root.action-label;
                    retry => { root.retry(); }
                    action => { root.action(); }
                }

                // Recent searches, offered where they are useful: the empty result.
                // The app already recorded every submitted keyword in SQLite; before
                // this the list was write-only and unreachable from the UI.
                if root.state == 2 && root.recent-searches.length > 0 : VerticalLayout {
                    spacing: Theme.space-2;

                    Label {
                        role: TextRole.Caption;
                        emphasis: Emphasis.Semibold;
                        text: "最近搜索";
                        color: Theme.text-tertiary;
                        horizontal-alignment: center;
                    }

                    // Four chips to a line, wrapped. `search_history(8)` returns
                    // exactly eight of them, and eight chips on one line are wider
                    // than the body at 720 and 800 logical px: measured with a
                    // realistic history, the last chip's right edge was at x=742.7
                    // in a 720px window (46.7px past the body's right edge) and at
                    // x=818.7 in an 800px one. A
                    // horizontal scroller here would hide the chips that exist to
                    // be clicked, and Slint cannot measure text to break the line
                    // at the real chip widths, so the line length is fixed: four
                    // keeps the widest line inside the body at the 720px minimum
                    // window while the lines stay centred, which is this block's
                    // visual language.
                    VerticalLayout {
                        spacing: Theme.space-2;
                        for r in Math.ceil(root.recent-searches.length / 4) : HorizontalLayout {
                            spacing: Theme.space-2;
                            alignment: center;
                            // Indexed across the wrapped rows, not per line: the row is
                            // one stop even though the chips sit on several lines (U7).
                            for c in Math.min(4, root.recent-searches.length - r * 4) : TagChip {
                                label: root.recent-searches[r * 4 + c];
                                index: r * 4 + c;
                                cursor: root.recent-cursor;
                                gained-focus(idx) => { root.recent-cursor = idx; }

                                move-cursor(d) => {
                                    root.recent-cursor = Math.max(0, Math.min(
                                        root.recent-searches.length - 1,
                                        root.recent-cursor + d));
                                }
                                clicked => { root.pick-search(root.recent-searches[r * 4 + c]); }
                            }
                        }
                    }
                }
            }
        }

        // ---------------- infinite-scroll footer ----------------
        if root.state == 0 && root.loading-more : Rectangle {
            height: 48px;

            // Centred by construction: see `LoadingRow`. A bare `ProgressBar`
            // with an explicit width inside a centred vertical layout sits at the
            // left edge, which is where all four of these footers were.
            LoadingRow {
                y: (parent.height - self.height) / 2;
                label: "正在加载更多…";
            }
        }

        // Room for the floating batch bar, so the last row of cards can still be
        // scrolled clear of it. Only when the bar exists: the scroll body of a page
        // that is not in selection mode is byte for byte what it was.
        if root.selection-mode : Rectangle {
            height: Theme.batch-bar-height + Theme.space-3;
        }
    }

    // ---- floating batch bar (F2) ----
    // Anchored to the page, outside the scroll: a bar that lives in the scroll body
    // would slide away exactly when the user is reaching for it. Inset by one page
    // padding on each side so it reads as a control strip, not a second status bar.
    if root.selection-mode : BatchBar {
        x: Theme.space-3;
        width: max(0px, root.width - Theme.space-3 * 2);
        y: root.height - self.height - Theme.space-3;
        count: root.selected-count;
        select-all => { root.select-all(); }
        clear-selection => { root.clear-selection(); }
        batch-download => { root.batch-download(); }
        batch-bookmark => { root.batch-bookmark(); }
        close => { root.exit-selection(); }
    }
}