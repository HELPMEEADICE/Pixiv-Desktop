// Illustration detail page — the most important screen in the app.
//
// Layout follows Pixiv: the artwork dominates, metadata sits in a compact column
// on the right, page thumbnails run along the bottom. The viewer follows the
// WinUI media-surface idiom: fit / actual-size modes, wheel zoom anchored at the
// cursor, drag to pan, double-click to toggle, F11 for fullscreen.
//
// The zoom/pan arithmetic is *not* duplicated here. Slint forwards raw pointer
// geometry (including the viewer's own width/height, so no 520px magic constant)
// and Rust owns the transform, where it is unit tested in `src/zoom.rs`.

import { ScrollView } from "std-widgets.slint";
import { Theme, Type } from "../theme.slint";

import {
    AppButton, IconButton, ButtonKind, TagChip, Badge, Divider, StateView, StateKind, Avatar,
    Skeleton, HoverTip, InfoBar, InfoKind, PageScroll, ProgressBar, LoadingRow, SectionHeader,
    IconPresenter, IconSlot, BookmarkMenu,
} from "../components.slint";

/// One viewable page. `thumb` is the thumbnail-strip image; `source` is either
/// the tier the cache currently has or empty while it loads.
export struct ViewerPage {
    source: image,
    thumb: image,
    width: int,
    height: int,
    loaded: bool,
    failed: bool,
}

/// The pannable, zoomable image surface.
export component ZoomViewer inherits Rectangle {
    in property <ViewerPage> page;
    in property <bool> fit-mode: true;
    /// Multiplier applied on top of the fit scale.
    in-out property <float> zoom: 1.0;
    in-out property <length> pan-x: 0px;
    in-out property <length> pan-y: 0px;
    in property <bool> show-controls: true;
    /// Round nine (F1): the frame a playing ugoira is on. Slint images carry their
    /// own size, so an unset frame is `width == 0` and the viewer falls back to the
    /// still — which is why playback needs no second component and no second layout
    /// path, and why a paused or unwired film paints today's pixels.
    in property <image> frame;

    /// Cursor position (px), wheel delta (px), and the viewer's own viewport.
    callback request-zoom(float, float, float, float, float);
    callback request-pan(float, float);
    callback request-toggle-zoom(float, float);
    callback set-fit-mode(bool);
    callback set-zoom(float);
    callback toggle-fullscreen();
    /// Re-fetch the page whose image failed. Distinct from the zoom callbacks:
    /// this button used to call `request-toggle-zoom`, so pressing it changed the
    /// scale and never requested the image again.
    callback reload-image();

    clip: true;
    background: Theme.viewer-surface;

    // Fit scale: the largest scale that shows the whole page inside the box.
    out property <float> fit-scale:
        (root.page.width <= 0 || root.page.height <= 0 || root.width <= 0px || root.height <= 0px)
            ? 1.0
            : Math.min((root.width / 1px) / (root.page.width * 1.0),
                       (root.height / 1px) / (root.page.height * 1.0));
    // One geometry path for both modes. Fit mode is just "scale = fit * zoom",
    // so panning and cursor-anchored zoom keep working while fitted instead of
    // silently switching to a different code path with different maths.
    out property <float> scale: root.fit-mode ? root.fit-scale * root.zoom : root.zoom;

    // Last pointer position, so `moved` can produce a delta for panning.
    property <float> last-x: 0.0;
    property <float> last-y: 0.0;

    img := Image {
        source: root.frame.width > 0 ? root.frame : root.page.source;
        x: (root.width - self.width) / 2 + root.pan-x;
        y: (root.height - self.height) / 2 + root.pan-y;
        width: max(1px, root.page.width * root.scale * 1px);
        height: max(1px, root.page.height * root.scale * 1px);
        // Width and height are already aspect-correct, so `fill` cannot distort.
        image-fit: fill;
    }

    ta := TouchArea {
        scroll-event(e) => {
            root.request-zoom(ta.mouse-x / 1px, ta.mouse-y / 1px, e.delta-y / 1px,
                root.width / 1px, root.height / 1px);
            EventResult.accept
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.last-x = ta.mouse-x / 1px;
                root.last-y = ta.mouse-y / 1px;
            }
            EventResult.accept
        }
        moved => {
            if (ta.pressed && !root.fit-mode) {
                root.request-pan((ta.mouse-x / 1px) - root.last-x, (ta.mouse-y / 1px) - root.last-y);
            }
            root.last-x = ta.mouse-x / 1px;
            root.last-y = ta.mouse-y / 1px;
        }
        double-clicked => {
            root.request-toggle-zoom(ta.mouse-x / 1px, ta.mouse-y / 1px);
        }
        mouse-cursor: root.fit-mode ? MouseCursor.default : MouseCursor.grab;
    }

    // Non-image states must never look like a broken image.
    // `width: 100%` plus paired stretch spacers is what actually centres these
    // blocks: a layout's own `alignment` only orders children, it does not centre
    // a fixed-width child, and a bare layout inside a Rectangle shrinks to its
    // preferred width and hugs the left edge.
    //
    // Declared *after* the viewer's `ta`, because Slint hit-tests in reverse
    // declaration order — the law components.slint:386 and main.slint:1130 record.
    // While these two blocks sat above `ta`, the full-size TouchArea won every
    // press and 「重新载入」 could not be clicked at all: the only retry affordance
    // in the page was dead. Painting is unchanged, because `ta` draws nothing and
    // moving a transparent element past it cannot move a pixel.
    if root.page.failed : VerticalLayout {
        width: 100%;
        alignment: center;
        spacing: Theme.space-2;
        HorizontalLayout {
            width: 100%;
            Rectangle { horizontal-stretch: 1; }
            IconPresenter {
                name: "warning";
                glyph-size: 28px;
                tint: Theme.danger;
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Text {
            text: "图片加载失败";
            color: Theme.text-secondary;
            font-size: Theme.font-body;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            width: 100%;
            Rectangle { horizontal-stretch: 1; }
            AppButton {
                label: "重新载入";
                icon: "refresh";
                clicked => { root.reload-image(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    if !root.page.loaded && !root.page.failed : VerticalLayout {
        width: 100%;
        alignment: center;
        spacing: Theme.space-2;
        HorizontalLayout {
            width: 100%;
            Rectangle { horizontal-stretch: 1; }
            Skeleton { width: 96px; height: 6px; radius: Theme.radius-pill; }
            Rectangle { horizontal-stretch: 1; }
        }
        Text {
            text: "正在载入图片…";
            color: Theme.text-tertiary;
            font-size: Theme.font-small;
            horizontal-alignment: center;
        }
    }

    // Floating control bar, as in WinUI's media surfaces. Width is explicit:
    // a child Rectangle without one fills its parent, which turned this pill into
    // a full-width strip across the middle of the image.
    if root.show-controls : Rectangle {
        width: controls.preferred-width;
        x: (root.width - self.width) / 2;
        y: root.height - self.height - Theme.space-3;
        height: 36px;
        border-radius: Theme.radius-lg;
        background: Theme.viewer-chrome;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 12px;
        drop-shadow-color: Theme.shadow-2;
        drop-shadow-offset-y: 2px;

        // Same defect as the 44 px toolbar above, one metric smaller. The pill is
        // 36 px (Theme.control-height-lg) and each button is a fixed 28 px child of
        // a horizontal layout, so the cross axis puts it at the start: wash and
        // glyph centred on y=14 in a 36 px pill whose centre line is y=18 — 4 px
        // high, both before and after this comment. `row-height: 36px` makes the
        // element claim the pill's height and centre its own 28 px square
        // (IconButton draws wash at (36-28)/2 = 4 and glyph at (36-16)/2 = 10, so
        // both land on 18). The pill's own metric — 36 px tall, 1 px border,
        // width from `controls.preferred-width` — is untouched: IconButton's width
        // stays `size`, so the pill is exactly as wide as it was.
        controls := HorizontalLayout {
            padding-left: Theme.space-1;
            padding-right: Theme.space-1;
            spacing: 0px;
            alignment: center;

            IconButton {
                icon: "fit";
                tip: "适应窗口";
                active: root.fit-mode;
                size: 28px;
                row-height: 36px;
                clicked => { root.set-fit-mode(true); root.set-zoom(1.0); }
            }
            IconButton {
                icon: "actual-size";
                tip: "实际尺寸";
                active: !root.fit-mode;
                size: 28px;
                row-height: 36px;
                clicked => { root.set-fit-mode(false); root.set-zoom(1.0); }
            }
            IconButton {
                icon: "zoom-out";
                tip: "缩小";
                size: 28px;
                row-height: 36px;
                clicked => { root.set-zoom(Math.max(0.2, root.zoom * 0.8)); }
            }
            Text {
                text: Math.round(root.scale * 100) + "%";
                color: Theme.text-secondary;
                font-size: Theme.font-caption;
                vertical-alignment: center;
                min-width: 44px;
                horizontal-alignment: center;
            }
            IconButton {
                icon: "zoom-in";
                tip: "放大";
                size: 28px;
                row-height: 36px;
                clicked => { root.set-zoom(Math.min(8.0, root.zoom * 1.25)); }
            }
            IconButton {
                icon: "fullscreen";
                tip: "全屏 (F11)";
                size: 28px;
                row-height: 36px;
                clicked => { root.toggle-fullscreen(); }
            }
        }
    }
}

/// The metadata column itself: title, author, actions, statistics, description and
/// tags. Split out of `InfoPanel` for one reason — U5. The panel is used two ways:
/// filling a 589 px column that scrolls its own metadata (the wide layout), and
/// standing at its natural height inside the page's scroll (the narrow one). A
/// percent and a length cannot be chosen between in one binding, and a `min-height`
/// read back from the panel's own ScrollView is a binding loop (measured: Slint
/// names the cycle flickable.content-height -> body.height -> page.body-height ->
/// min-height). Two containers over one body is the version that compiles and has
/// one copy of the content.
component InfoBody inherits VerticalLayout {
    in property <string> title: "";
    in property <string> author: "";
    in property <string> author-id: "";
    in property <image> avatar;
    /// 0 ok, 1 loading, 2 failed or absent
    in property <int> avatar-state: 1;
    in property <string> description: "";
    in property <[string]> tags: [];
    in property <string> posted: "";
    in property <int> kind: 0;
    in property <int> page-count: 1;
    in property <int> views: 0;
    in property <int> bookmarks: 0;
    in property <int> likes: 0;
    in property <bool> bookmarked: false;
    in property <bool> authenticated: false;
    in property <bool> following: false;
    in property <bool> busy: false;
    in property <string> ugoira-hint: "";
    in property <int> bookmark-restrict: 0;
    /// Roving focus cursor for the tag chips (U7).
    in-out property <int> tag-cursor: 0;

    callback toggle-bookmark();
    callback open-author();
    callback open-tag(string);
    callback download-page();
    callback download-all();
    callback export-ugoira();
    callback open-external();
    callback follow();
    callback restrict-menu-at(length, length);

    spacing: Theme.space-3;


    Text {
        text: root.title;
        color: Theme.text;
        font-size: Theme.font-title;
        font-weight: Type.semibold;
        wrap: word-wrap;
    }

    // ---- author ----
    Rectangle {
        height: 44px;
        border-radius: Theme.radius-md;
        background: ta-author.has-hover ? Theme.layer-alt : transparent;

        HorizontalLayout {
            padding-left: Theme.space-1;
            padding-right: Theme.space-1;
            spacing: Theme.space-2;
            alignment: start;

            // The real face. A 32px blue disc with the character 画 was the last
            // thing in the app that looked like an avatar without being one; the
            // cards, the profile header and the top bar all switched to the real
            // image and this panel was left behind.
            //
            // Full-height cell, centred explicitly: a fixed-size child of a
            // horizontal layout is aligned to the start of the cross axis, which
            // is what put the old tile 6px high in a 44px row.
            Rectangle {
                width: 32px;
                height: 100%;
                Avatar {
                    size: 32px;
                    y: (parent.height - self.height) / 2;
                    source: root.avatar;
                    state: root.avatar-state;
                    fallback: root.author;
                }
            }

            // The author link must not cover the follow button. It used to be
            // a sibling declared *after* this layout, which in Slint puts it on
            // top of the whole row: every click on 「关注」 was swallowed by the
            // author touch area and the follow button never fired. Scoping the
            // touch area to the name column keeps the whole row clickable for
            // "open author" while giving the button its own hit region.
            ta-author := TouchArea {
                mouse-cursor: pointer;
                horizontal-stretch: 1;
                clicked => { root.open-author(); }

                VerticalLayout {
                    alignment: center;
                    spacing: 0px;
                    Text {
                        text: root.author;
                        color: Theme.text;
                        font-size: Theme.font-body;
                        font-weight: Type.medium;
                        overflow: elide;
                    }
                    Text {
                        text: "ID " + root.author-id;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-caption;
                        overflow: elide;
                    }
                }
            }

            AppButton {
                label: root.following ? "已关注" : "关注";
                icon: "artist";
                compact: true;
                // compact is 26 px; without the row height the button is placed
                // 9 px above the centre line of the 44 px author row.
                row-height: 44px;
                kind: root.following ? ButtonKind.Primary : ButtonKind.Secondary;
                enabled: root.authenticated && !root.busy;
                clicked => { root.follow(); }
            }
        }
    }

    // ---- primary actions ----
    //
    // F4: the bookmark is a Fluent SplitButton — the action, then a 24 px
    // chevron column (`Theme.split-chevron`) that opens the restriction menu.
    // Two interactive children, so two Tab stops, which is what a SplitButton
    // is: the main half and the menu half are different verbs. Both halves are
    // shared primitives (`AppButton`, `IconButton`), so hover, press, focus ring,
    // role and keyboard all come from the components rather than from here.
    HorizontalLayout {
        spacing: Theme.space-2;
        alignment: start;

        Rectangle {
            // Wraps the pair so the 32 px row and the 26 px `保存本页` button
            // beside it share one cross-axis rule: a fixed-size child of a
            // horizontal layout is aligned to the start of the cross axis.
            width: split.preferred-width;
            height: 32px;

            split := HorizontalLayout {
                spacing: 0px;
                alignment: start;

                AppButton {
                    label: root.bookmarked
                        ? (root.bookmark-restrict == 1 ? "私密收藏" : "已收藏")
                        : "收藏";
                    icon: "follow";
                    kind: root.bookmarked ? ButtonKind.Primary : ButtonKind.Secondary;
                    enabled: !root.busy;
                    row-height: 32px;
                    clicked => { root.toggle-bookmark(); }
                }

                chevron := IconButton {
                    icon: "chevron-down";
                    tip: "收藏可见范围";
                    size: Theme.split-chevron;
                    row-height: 32px;
                    enabled: !root.busy;
                    clicked => {
                        root.restrict-menu-at(
                            chevron.absolute-position.x,
                            chevron.absolute-position.y + chevron.height);
                    }
                }
            }
        }

        AppButton {
            label: "保存本页";
            icon: "downloads";
            clicked => { root.download-page(); }
        }
    }

    HorizontalLayout {
        spacing: Theme.space-2;
        alignment: start;
        AppButton {
            label: root.page-count > 1 ? ("下载全部 " + root.page-count) : "下载";
            icon: "downloads";
            kind: ButtonKind.Secondary;
            clicked => { root.download-all(); }
        }
        if root.kind == 2 : AppButton {
            label: "导出动图 GIF";
            icon: "play";
            kind: ButtonKind.Secondary;
            enabled: !root.busy;
            clicked => { root.export-ugoira(); }
        }
    }

    AppButton {
        label: "在浏览器中打开";
        icon: "open";
        kind: ButtonKind.Subtle;
        clicked => { root.open-external(); }
    }

    if !root.authenticated : InfoBar {
        kind: InfoKind.Warning;
        title: "只读模式";
        message: "收藏与关注需要先完成登录（设置 → 账户）。";
    }

    if root.kind == 2 && root.ugoira-hint != "" : InfoBar {
        kind: InfoKind.Info;
        title: "动图（Ugoira）";
        message: root.ugoira-hint;
    }

    Divider { }

    // ---- stats ----
    HorizontalLayout {
        spacing: Theme.space-4;
        alignment: start;
        Text { text: "浏览 " + root.views; color: Theme.text-secondary; font-size: Theme.font-small; vertical-alignment: center; }
        Text { text: "收藏 " + root.bookmarks; color: Theme.text-secondary; font-size: Theme.font-small; vertical-alignment: center; }
        Text { text: "赞 " + root.likes; color: Theme.text-secondary; font-size: Theme.font-small; vertical-alignment: center; }
        Text { text: root.posted; color: Theme.text-tertiary; font-size: Theme.font-small; vertical-alignment: center; overflow: elide; }
    }

    if root.description != "" : Text {
        text: root.description;
        color: Theme.text-secondary;
        font-size: Theme.font-small;
        wrap: word-wrap;
    }

    if root.tags.length > 0 : VerticalLayout {
        spacing: Theme.space-2;
        Text {
            text: "标签";
            color: Theme.text-tertiary;
            font-size: Theme.font-caption;
            font-weight: Type.semibold;
        }
        // Two chips per row, emitted as explicit cells. A horizontal ScrollView
        // was tried first (a strip fixed at 60px that grows a scrollbar as soon
        // as the labels are a few pixels too wide looks like a broken control),
        // and so was `GridLayout` (it lays every child on a single row and just
        // overflows). Conditional children are excluded from the layout, so a
        // row with one tag renders as one chip and never truncates.
        VerticalLayout {
            spacing: 6px;
            for r in Math.ceil(root.tags.length / 2) : HorizontalLayout {
                spacing: 6px;
                alignment: start;

                // U7: one Tab stop for the whole chip block, even though it wraps.
                // The index is the tag's position, not its cell, so Left/Right walk
                // the reader's order.
                if r * 2 < root.tags.length : TagChip {
                    label: root.tags[r * 2];
                    index: r * 2;
                    cursor: root.tag-cursor;
                    gained-focus(idx) => { root.tag-cursor = idx; }

                    move-cursor(d) => {
                        root.tag-cursor = Math.max(0, Math.min(
                            root.tags.length - 1, root.tag-cursor + d));
                    }
                    clicked => { root.open-tag(root.tags[r * 2]); }
                }
                if r * 2 + 1 < root.tags.length : TagChip {
                    label: root.tags[r * 2 + 1];
                    index: r * 2 + 1;
                    cursor: root.tag-cursor;
                    gained-focus(idx) => { root.tag-cursor = idx; }

                    move-cursor(d) => {
                        root.tag-cursor = Math.max(0, Math.min(
                            root.tags.length - 1, root.tag-cursor + d));
                    }
                    clicked => { root.open-tag(root.tags[r * 2 + 1]); }
                }
            }
        }
    }
}

/// Right-hand metadata column.
export component InfoPanel inherits Rectangle {
    in property <string> title: "";
    in property <string> author: "";
    in property <string> author-id: "";
    /// The author's real avatar, decoded by the same path the cards use.
    in property <image> avatar;
    /// 0 ok, 1 loading, 2 failed or absent
    in property <int> avatar-state: 1;
    in property <string> description: "";
    in property <[string]> tags: [];
    in property <string> posted: "";
    in property <int> kind: 0;
    in property <int> page-count: 1;
    in property <int> views: 0;
    in property <int> bookmarks: 0;
    in property <int> likes: 0;
    in property <bool> bookmarked: false;
    in property <bool> authenticated: false;
    in property <bool> following: false;
    in property <bool> busy: false;
    in property <string> ugoira-hint: "";
    /// Round nine (F4): which restriction the reply says is in force. The menu
    /// draws it, and the split button mines it for its tooltip — the panel never
    /// guesses from the last click.
    in property <int> bookmark-restrict: 0;

    callback toggle-bookmark();
    callback open-author();
    callback open-tag(string);
    callback download-page();
    callback download-all();
    callback export-ugoira();
    callback open-external();
    callback follow();
    /// The chevron was pressed: open the restriction menu at this point, in screen
    /// coordinates (the menu itself is painted by the page, because a flyout inside
    /// a clipped column or a scroll view is a flyout that cannot be reached).
    callback restrict-menu-at(length, length);
    /// Roving focus cursor for the tag chips this panel draws (U7).
    in-out property <int> tag-cursor: 0;

    background: Theme.layer;
    border-width: 1px;
    border-color: Theme.border;

    // U5. The panel fills the column the page sized (589 px at 1280 x 800) and scrolls
    // its metadata inside it — unchanged from every previous round. The narrow layout
    // does not use this component at all: it draws `InfoBody` inline, because a scroll
    // view inside a scroll view is two scrollbars for one gesture.
    page := PageScroll {
        width: 100%;
        height: 100%;
        padding-x: Theme.space-4;
        padding-y: Theme.space-4;
        gutter: false;
        spacing: Theme.space-3;

        InfoBody {
            title: root.title;
            author: root.author;
            author-id: root.author-id;
            avatar: root.avatar;
            avatar-state: root.avatar-state;
            description: root.description;
            tags: root.tags;
            posted: root.posted;
            kind: root.kind;
            page-count: root.page-count;
            views: root.views;
            bookmarks: root.bookmarks;
            likes: root.likes;
            bookmarked: root.bookmarked;
            authenticated: root.authenticated;
            following: root.following;
            busy: root.busy;
            ugoira-hint: root.ugoira-hint;
            bookmark-restrict: root.bookmark-restrict;
            tag-cursor <=> root.tag-cursor;
            toggle-bookmark => { root.toggle-bookmark(); }
            open-author => { root.open-author(); }
            open-tag(t) => { root.open-tag(t); }
            download-page => { root.download-page(); }
            download-all => { root.download-all(); }
            export-ugoira => { root.export-ugoira(); }
            open-external => { root.open-external(); }
            follow => { root.follow(); }
            restrict-menu-at(x, y) => { root.restrict-menu-at(x, y); }
        }
    }
}

/// Full page: toolbar + viewer + metadata + thumbnail strip.
export component DetailPage inherits Rectangle {
    in property <string> title: "";
    in property <string> author: "";
    in property <string> author-id: "";
    in property <image> author-avatar;
    in property <int> author-avatar-state: 1;
    in property <string> description: "";
    in property <[string]> tags: [];
    in property <string> posted: "";
    in property <int> kind: 0;
    in property <int> page-count: 1;
    in property <int> views: 0;
    in property <int> bookmarks: 0;
    in property <int> likes: 0;
    in property <bool> bookmarked: false;
    in property <bool> authenticated: false;
    in property <bool> following: false;
    in property <bool> busy: false;
    /// 0 content, 1 loading, 3 error
    in property <int> state: 0;
    in property <string> message: "";
    in property <string> ugoira-hint: "";

    in property <[ViewerPage]> pages: [];
    in-out property <int> current-page: 0;

    in-out property <float> zoom: 1.0;
    in-out property <length> pan-x: 0px;
    in-out property <length> pan-y: 0px;
    in property <bool> fit-mode: true;

    callback back();
    callback toggle-bookmark();
    callback open-author();
    callback open-tag(string);
    callback download-page();
    callback download-all();
    callback export-ugoira();
    callback open-external();
    callback follow();
    callback retry();
    callback select-page(int);
    callback request-zoom(float, float, float, float, float);
    callback request-pan(float, float);
    callback request-toggle-zoom(float, float);
    callback set-fit-mode(bool);
    callback set-zoom(float);
    callback toggle-fullscreen();
    callback reload-image();

    // ---- round nine: F1 playback, F4 bookmark visibility, U29 page stepping ----
    // The frozen seams, all with defaults that draw exactly what the page drew
    // before this round: `film-ready` false hides the whole playback control (no
    // gap, no disabled ghost), `film-frame` unset leaves the still in the viewer,
    // `bookmark-restrict` 0 is the only restriction the app could create so far,
    // and `page-step` with no listener changes no page.
    in property <bool> film-ready: false;
    /// The decoded frame the film is on. Slint images carry their own size, so
    /// "unset" is `width == 0` and the viewer keeps the still.
    in property <image> film-frame;
    in property <int> film-index: 0;
    in property <int> film-count: 0;
    /// Whether the 16 ms timer is running. Not in the plan's table because the table
    /// lists what Rust writes, but the control cannot draw its own state without it:
    /// a play/pause toggle that shows the same glyph in both states is not a toggle.
    /// Rust is expected to publish it; the button also flips it optimistically, so
    /// the demo (and the `ugoira` capture fixture) reaches the playing state offline.
    in-out property <bool> film-playing: false;
    callback toggle-playback();
    /// Left/Right on a thumbnail: -1 / +1, in pages. The shell clamps it against
    /// `pages`, which is the only place that knows how many there are.
    callback page-step(int);
    /// 0 public / 1 private, from the reply.
    in property <int> bookmark-restrict: 0;
    callback pick-restrict(int);
    /// Roving focus cursor for the tag chips (U7).
    in-out property <int> tag-cursor: 0;

    // ---- the bookmark restriction flyout (F4) ----
    // Painted by the page, not by the InfoPanel: the panel lives inside a clipped
    // column in the wide layout and inside the page scroll in the narrow one, and a
    // flyout that inherits either clip cannot be reached. The panel reports the
    // chevron's screen position; the page subtracts its own to place the menu.
    property <bool> restrict-open: false;
    property <length> restrict-anchor-x: 0px;
    property <length> restrict-anchor-y: 0px;

    // ---- vertical budget (U5) ----
    /// Height the pinned thumbnail strip consumes: 68 px when there is more than one
    /// page, nothing when there is one (the strip is not drawn at all).
    out property <length> strip-height: (root.state == 0 && root.pages.length > 1) ? 68px : 0px;
    /// What is left for the scrolling body, i.e. the page box minus the toolbar, the
    /// rule under it and the strip. The wide layout hands its viewer exactly this,
    /// which is why the 1280 x 800 capture is unchanged.
    out property <length> body-height: max(0px, root.height - toolbar.height - rule.height - root.strip-height);

    background: Theme.canvas;

    /// Content box width, pushed in by the shell. Reading the window width here
    /// reports as a binding loop.
    in property <length> available-width: 900px;
    out property <bool> wide: root.available-width >= 900px;

    /// Height / width of the page being viewed, clamped to a usable band. The
    /// narrow layout uses it to size the viewer from the artwork instead of from a
    /// stretch factor: a portrait work in a 3:2 stretch box was fitted at 25% with
    /// most of the box empty. Unknown dimensions fall back to 1:1, which is what
    /// `IllustCard` does and keeps the two consistent.
    out property <float> viewer-aspect: (
        root.pages.length == 0
        || root.pages[Math.min(root.current-page, root.pages.length - 1)].width <= 0
        || root.pages[Math.min(root.current-page, root.pages.length - 1)].height <= 0
    ) ? 1.0 : Math.max(0.55, Math.min(1.6,
        root.pages[Math.min(root.current-page, root.pages.length - 1)].height * 1.0
            / (root.pages[Math.min(root.current-page, root.pages.length - 1)].width * 1.0)
    ));

    VerticalLayout {
        // ---- toolbar (outside the scroll: a document toolbar must not scroll away) ----
        //
        // This row's width is the page's width anchor, not decoration. The page
        // area is one element shared by six pages and it is sized from its
        // resolved content, so a page whose widest child is narrow is only as
        // wide as that child: measured before the fix, the error state's widest
        // child was `StateView`'s 420px block plus padding = 452px, so the
        // toolbar stopped 348px short of the page's right edge and the state
        // block sat 170px left of the page centre. Stating the width on the body
        // layout itself does not work (`width: 100%`, `width: root.width` and
        // `width: 700px` all resolved back to the preferred 452px — measured);
        // stating it on a child that relays it into the layout's preferred width
        // does. `available-width` is the content box the shell computed
        // (window minus the navigation pane, from `src/app.rs`), so this row and
        // every row under it are exactly as wide as the page.
        toolbar := Rectangle {
            height: 44px;
            background: Theme.canvas;

            HorizontalLayout {
                padding-left: Theme.space-2;
                padding-right: Theme.space-2;
                spacing: Theme.space-1;

                IconButton {
                    icon: "back";
                    tip: "返回";
                    row-height: 44px;
                    clicked => { root.back(); }
                }

                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: Theme.font-body;
                    font-weight: Type.medium;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                // The badge is 18 px in a 44 px row and a fixed-size child of a
                // horizontal layout is aligned to the start of the cross axis
                // (i-slint-core-1.18.1/layout.rs:1373-1382), so it sat 13 px above
                // the row's centre line. A wrapper that claims the row height and
                // centres the 18 px chip is the shape downloads.slint:120 already
                // uses for its status badge; the chip itself keeps its metrics.
                if root.page-count > 1 : Rectangle {
                    width: page-badge.width;
                    height: 100%;

                    page-badge := Badge {
                        y: (parent.height - self.height) / 2;
                        label: (root.current-page + 1) + " / " + root.page-count;
                        fill: Theme.layer-alt;
                        ink: Theme.text-secondary;
                    }
                }

                // ---- F1: playback, in the toolbar it already has ----
                // Same IconButton as the four beside it, so the row keeps one control
                // metric (32 px inside a 44 px row) and one focus-ring treatment. The
                // caption is the plan's "frame 12/24": an index a user can read, not a
                // percentage, because a ugoira's frames are not evenly spaced.
                if root.film-ready : IconButton {
                    icon: root.film-playing ? "pause" : "play";
                    tip: root.film-playing ? "暂停播放" : "播放动图";
                    active: root.film-playing;
                    row-height: 44px;
                    clicked => {
                        root.film-playing = !root.film-playing;
                        root.toggle-playback();
                    }
                }
                if root.film-ready && root.film-count > 0 : Text {
                    text: "第 " + Math.min(root.film-index + 1, root.film-count)
                        + " / " + root.film-count + " 帧";
                    color: Theme.text-secondary;
                    font-size: Theme.font-caption;
                    vertical-alignment: center;
                }

                IconButton {
                    icon: "fit";
                    tip: root.fit-mode ? "当前：适应窗口" : "当前：实际尺寸";
                    active: root.fit-mode;
                    // Same 44 px as the back button above it: without row-height a
                    // fixed 32 px child sits at the padding edge of the 44 px row,
                    // 12 px above its centre line.
                    row-height: 44px;
                    clicked => {
                        root.set-fit-mode(!root.fit-mode);
                        root.set-zoom(1.0);
                    }
                }
                IconButton {
                    icon: "open";
                    tip: "在浏览器中打开";
                    row-height: 44px;
                    clicked => { root.open-external(); }
                }
                IconButton {
                    icon: "refresh";
                    tip: "重新载入";
                    row-height: 44px;
                    clicked => { root.retry(); }
                }
            }
        }

        rule := Divider { }

        // ---- vertical budget, stated once (U5) ----
        //
        // The page is a fixed-height column. At 800 x 600 the window is 600 px tall,
        // the shell spends 48 (top bar) + 26 (status bar) on chrome, so this page is
        // handed 526 px. Inside it: 44 (toolbar) + 1 (rule) + 68 (thumbnail strip) =
        // 113 px of furniture, i.e. 413 px of viewport. The narrow layout draws a
        // viewer of min(526 * 0.55, aspect cap) = 289 px and an InfoPanel whose
        // preferred height is its whole metadata column (~600 px for a title, a
        // 20-line description, twelve tags and the stats): 289 + 600 = 889 px in a
        // 413 px box. A bare `VerticalLayout` has nowhere to put the surplus — it
        // squeezes the panel down to `min-height: 160px` and the description, the tags
        // and the statistics are simply not on screen and not reachable.
        //
        // So the *body* scrolls and nothing else does: the toolbar stays where it is
        // (a document toolbar that scrolls away is a different control), the 68 px
        // strip stays pinned (it is the navigation for the thing being read), and
        // `body-height` below is the exact height the wide layout gives its viewer so
        // that the 1280 x 800 screenshot does not move by a pixel.
        body-scroll := ScrollView {
            vertical-stretch: 1;
            width: 100%;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;

            body := VerticalLayout {
                // The content box, not the window: the vertical scrollbar is an
                // overlay, so a child sized from the window would paint under it.
                width: max(0px, body-scroll.visible-width);

                if root.state == 1 : Rectangle {
                    height: 96px;
                    LoadingRow {
                        y: (parent.height - self.height) / 2;
                        bar-width: 140px;
                        label: "正在载入作品…";
                    }
                }

                // Centred, not stretched. `StateView` starts its 420px description at the
                // beginning of its content box, so a stretched block centres the heading
                // over a left-shifted description; the paired stretch spacers centre the
                // block itself, which keeps heading, description and button on one axis at
                // the page centre.
                if root.state == 3 : HorizontalLayout {
                    width: 100%;

                    Rectangle { horizontal-stretch: 1; }

                    StateView {
                        kind: StateKind.Error;
                        title: "无法载入作品";
                        description: root.message;
                        action-label: "重试";
                        retry => { root.retry(); }
                    }

                    Rectangle { horizontal-stretch: 1; }
                }

                if root.state == 0 && root.pages.length > 0 && root.wide : HorizontalLayout {
                    spacing: Theme.space-3;
                    padding: Theme.space-3;
                    // Inside a scroll body nothing hands out leftover height, so the row
                    // states the height it used to inherit and the viewer inside it keeps
                    // exactly the box it has today (`body-height` - the two 12 px paddings,
                    // with a 320 px floor so a short window still shows a usable picture
                    // and the strip below it stays reachable).
                    height: max(320px, root.body-height);

                    ZoomViewer {
                        horizontal-stretch: 1;
                        frame: root.film-frame;
                        page: root.pages[Math.min(root.current-page, root.pages.length - 1)];
                        fit-mode: root.fit-mode;
                        zoom <=> root.zoom;
                        pan-x <=> root.pan-x;
                        pan-y <=> root.pan-y;
                        request-zoom(px, py, dy, w, h) => { root.request-zoom(px, py, dy, w, h); }
                        request-pan(dx, dy) => { root.request-pan(dx, dy); }
                        request-toggle-zoom(px, py) => { root.request-toggle-zoom(px, py); }
                        set-fit-mode(m) => { root.set-fit-mode(m); }
                        set-zoom(z) => { root.set-zoom(z); }
                        toggle-fullscreen => { root.toggle-fullscreen(); }
                        reload-image => { root.reload-image(); }
                    }

                    Rectangle {
                        width: Math.min(360px, root.available-width * 0.38);
                        border-radius: Theme.radius-lg;
                        clip: true;

                        InfoPanel {
                            width: parent.width;
                            height: parent.height;
                            title: root.title;
                            author: root.author;
                            author-id: root.author-id;

                            avatar: root.author-avatar;

                            avatar-state: root.author-avatar-state;
                            description: root.description;
                            tags: root.tags;
                            posted: root.posted;
                            kind: root.kind;
                            page-count: root.page-count;
                            views: root.views;
                            bookmarks: root.bookmarks;
                            likes: root.likes;
                            bookmarked: root.bookmarked;
                            authenticated: root.authenticated;
                            following: root.following;
                            busy: root.busy;
                            ugoira-hint: root.ugoira-hint;
                            bookmark-restrict: root.bookmark-restrict;
                            tag-cursor <=> root.tag-cursor;
                            restrict-menu-at(x, y) => {
                                root.restrict-anchor-x = x;
                                root.restrict-anchor-y = y;
                                root.restrict-open = true;
                            }
                            toggle-bookmark => { root.toggle-bookmark(); }
                            open-author => { root.open-author(); }
                            open-tag(t) => { root.open-tag(t); }
                            download-page => { root.download-page(); }
                            download-all => { root.download-all(); }
                            export-ugoira => { root.export-ugoira(); }
                            open-external => { root.open-external(); }
                            follow => { root.follow(); }
                        }
                    }
                }

                // Narrow layout: the viewer's height is derived from the page's own aspect
                // ratio instead of a stretch factor. A 3:2 stretch gave a portrait artwork a
                // 1100x430 box, so "fit" scaled it to 25% and the box was mostly empty
                // backdrop. Sizing the box to the artwork (capped to the space available)
                // means the embedded viewer shows the picture it was given.
                if root.state == 0 && root.pages.length > 0 && !root.wide : VerticalLayout {
                    ZoomViewer {
                        // `available-width` is the content box, so the estimate subtracts the
                        // page padding the surrounding layout adds.
                        //
                        // Two caps, both necessary: the aspect cap stops a 1:1.6 portrait from
                        // being fitted at 25% inside a wide letterbox, and the height cap stops
                        // the artwork from pushing the whole metadata column below the fold in
                        // a short window. Whichever is smaller wins.
                        height: Math.min(
                            root.height * 0.55,
                            max(200px, root.available-width - Theme.space-6) * root.viewer-aspect
                                + Theme.space-6
                        );
                        page: root.pages[Math.min(root.current-page, root.pages.length - 1)];
                        frame: root.film-frame;
                        fit-mode: root.fit-mode;
                        zoom <=> root.zoom;
                        pan-x <=> root.pan-x;
                        pan-y <=> root.pan-y;
                        request-zoom(px, py, dy, w, h) => { root.request-zoom(px, py, dy, w, h); }
                        request-pan(dx, dy) => { root.request-pan(dx, dy); }
                        request-toggle-zoom(px, py) => { root.request-toggle-zoom(px, py); }
                        set-fit-mode(m) => { root.set-fit-mode(m); }
                        set-zoom(z) => { root.set-zoom(z); }
                        toggle-fullscreen => { root.toggle-fullscreen(); }
                        reload-image => { root.reload-image(); }
                    }
                    // U5: the metadata column, inline. Not `InfoPanel`, and not because
                    // the panel is wrong — because a *scroll view* here would put a
                    // second scrollbar inside the page scroll, and because a Rectangle
                    // whose only child is a conditional does not report a preferred
                    // height: measured with `natural`, the panel came out 0 px tall, the
                    // body had nothing to scroll and the description was simply clipped.
                    // The surface is the panel's (one `layer` card, 1 px border) and the
                    // content is the same `InfoBody` the wide layout uses.
                    Rectangle {
                        background: Theme.layer;
                        border-width: 1px;
                        border-color: Theme.border;

                        VerticalLayout {
                            padding: Theme.space-4;
                            spacing: 0px;

                            InfoBody {
                                title: root.title;
                                author: root.author;
                                author-id: root.author-id;
                                avatar: root.author-avatar;
                                avatar-state: root.author-avatar-state;
                                description: root.description;
                                tags: root.tags;
                                posted: root.posted;
                                kind: root.kind;
                                page-count: root.page-count;
                                views: root.views;
                                bookmarks: root.bookmarks;
                                likes: root.likes;
                                bookmarked: root.bookmarked;
                                authenticated: root.authenticated;
                                following: root.following;
                                busy: root.busy;
                                ugoira-hint: root.ugoira-hint;
                                bookmark-restrict: root.bookmark-restrict;
                                tag-cursor <=> root.tag-cursor;
                                restrict-menu-at(x, y) => {
                                    root.restrict-anchor-x = x;
                                    root.restrict-anchor-y = y;
                                    root.restrict-open = true;
                                }
                                toggle-bookmark => { root.toggle-bookmark(); }
                                open-author => { root.open-author(); }
                                open-tag(t) => { root.open-tag(t); }
                                download-page => { root.download-page(); }
                                download-all => { root.download-all(); }
                                export-ugoira => { root.export-ugoira(); }
                                open-external => { root.open-external(); }
                                follow => { root.follow(); }
                            }
                        }
                    }
                }

            }
        }
        // ---- page thumbnail strip ----
        if root.strip-height > 0 : Rectangle {
            height: 68px;
            background: Theme.layer;

            ScrollView {
                width: 100%;
                height: 100%;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;

                // Two bands, not one, exactly as gallery.slint:183 does for its tag
                // strip. With padding: Theme.space-2 the 48 px thumbs occupied
                // 8..56 and the 14 px overlay bar 54..68, so the bar was painted
                // over the last 2 px of every thumbnail. Theme.space-1 on top puts
                // the thumbs at 4..52 and leaves the bar's band 54..68 to itself.
                // The strip height (68 px) and the thumbnail size (48 px) are
                // unchanged, which is what keeps this out of U5's vertical budget.
                HorizontalLayout {
                    padding-top: Theme.space-1;
                    padding-left: Theme.space-2;
                    padding-bottom: Theme.space-2;
                    spacing: Theme.space-2;
                    alignment: start;

                    // U29: every thumbnail is a Tab stop with Enter/Space to view it,
                    // and Left/Right step the page through `page-step`. Two wraps of
                    // one cell — a focus scope (declared first, so the TouchArea below
                    // still wins the press) and the pointer target — plus a ring that is
                    // opacity, not an `if`, so an unfocused thumb paints today's pixels.
                    for p[i] in root.pages : Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: Theme.radius-sm;
                        border-width: (i == root.current-page) ? 2px : 1px;
                        border-color: (i == root.current-page) ? Theme.accent-fill : Theme.border;
                        background: Theme.layer-alt;
                        clip: true;

                        Image {
                            source: p.thumb;
                            width: 100%;
                            height: 100%;
                            image-fit: cover;
                        }

                        thumb-focus := FocusScope {
                            accessible-role: AccessibleRole.button;
                            accessible-label: "第 " + (i + 1) + " 页，共 " + root.pages.length + " 页";
                            accessible-action-default => { root.select-page(i); }
                            key-pressed(e) => {
                                if (e.text == "\n" || e.text == " ") {
                                    root.select-page(i);
                                    return EventResult.accept;
                                }
                                // U+F702 / U+F703: the arrow *character codes*. A
                                // comparison against "LeftArrow" compiles and never
                                // matches, which is what `uiaudit` exists to prevent.
                                if (e.text == "\u{F702}") { root.page-step(-1); return EventResult.accept; }
                                if (e.text == "\u{F703}") { root.page-step(1); return EventResult.accept; }
                                EventResult.reject
                            }
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.select-page(i); }
                        }

                        // Fluent's focus visual, which is two strokes and not one: 2 px of
                        // `focus-ring` and a 1 px `layer` inside it. A single blue stroke on
                        // a 48 px thumbnail is nearly invisible — the first camera-read of
                        // this capture could not tell the focused strip cell from its
                        // neighbours, and the ring a keyboard user cannot see is the same
                        // defect as no ring. Both strokes are inside the cell's clip, so
                        // nothing moves and no neighbour is covered.
                        Rectangle {
                            border-radius: Theme.radius-sm;
                            border-width: 2px;
                            border-color: Theme.focus-ring;
                            background: transparent;
                            opacity: thumb-focus.has-focus ? 1.0 : 0.0;
                            animate opacity { duration: Theme.motion-fast; easing: ease-out; }

                            Rectangle {
                                x: 2px;
                                y: 2px;
                                width: parent.width - 8px;
                                height: parent.height - 8px;
                                border-radius: Theme.radius-sm;
                                border-width: 1px;
                                border-color: Theme.layer;
                                background: transparent;
                            }
                        }
                    }
                }
            }
        }
    }
    // ---- bookmark restriction flyout (F4) ----
    // A sibling of the page column, so nothing clips it: the wide layout's info
    // column has `clip: true` for its rounded corners and the narrow layout lives
    // inside the page scroll. The click-outside scrim is declared *first* because
    // Slint hit-tests in reverse declaration order and the menu has to win its own
    // area.
    if root.restrict-open : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: transparent;

        scrim := TouchArea {
            clicked => { root.restrict-open = false; }
        }
    }

    if root.restrict-open : BookmarkMenu {
        // Right-aligned with the chevron that opened it (both are 24 px wide, the
        // menu is 200), and clamped into the page so a 720 px window cannot push the
        // menu half off the right edge.
        x: Math.max(Theme.space-2, Math.min(
            root.width - Theme.menu-width - Theme.space-2,
            root.restrict-anchor-x - root.absolute-position.x
                + Theme.split-chevron - Theme.menu-width));
        y: root.restrict-anchor-y - root.absolute-position.y + Theme.space-1;
        restrict: root.bookmark-restrict;
        bookmarked: root.bookmarked;
        pick(r) => {
            root.restrict-open = false;
            root.pick-restrict(r);
        }
        remove => {
            root.restrict-open = false;
            root.toggle-bookmark();
        }
        closed => { root.restrict-open = false; }
    }
}
