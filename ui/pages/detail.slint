// Illustration detail page — the most important screen in the app.
//
// Layout follows Pixiv: the artwork dominates, metadata sits in a compact column
// on the right, page thumbnails run along the bottom. The viewer follows the
// WinUI media-surface idiom: fit / actual-size modes, wheel zoom anchored at the
// cursor, drag to pan, double-click to toggle, F11 for fullscreen.
//
// The zoom/pan arithmetic is *not* duplicated here. Slint forwards raw pointer
// geometry (including the viewer's own width/height, so no 520px magic constant)
// and Rust owns the transform, where it is unit tested in `src/zoom.rs`.

import { ScrollView } from "std-widgets.slint";
import { Theme, Type } from "../theme.slint";

import {
    AppButton, IconButton, ButtonKind, TagChip, Badge, Divider, StateView, StateKind, Avatar,
    Skeleton, HoverTip, InfoBar, InfoKind, PageScroll, ProgressBar, LoadingRow, SectionHeader,
    IconPresenter, IconSlot,
} from "../components.slint";

/// One viewable page. `thumb` is the thumbnail-strip image; `source` is either
/// the tier the cache currently has or empty while it loads.
export struct ViewerPage {
    source: image,
    thumb: image,
    width: int,
    height: int,
    loaded: bool,
    failed: bool,
}

/// The pannable, zoomable image surface.
export component ZoomViewer inherits Rectangle {
    in property <ViewerPage> page;
    in property <bool> fit-mode: true;
    /// Multiplier applied on top of the fit scale.
    in-out property <float> zoom: 1.0;
    in-out property <length> pan-x: 0px;
    in-out property <length> pan-y: 0px;
    in property <bool> show-controls: true;

    /// Cursor position (px), wheel delta (px), and the viewer's own viewport.
    callback request-zoom(float, float, float, float, float);
    callback request-pan(float, float);
    callback request-toggle-zoom(float, float);
    callback set-fit-mode(bool);
    callback set-zoom(float);
    callback toggle-fullscreen();
    /// Re-fetch the page whose image failed. Distinct from the zoom callbacks:
    /// this button used to call `request-toggle-zoom`, so pressing it changed the
    /// scale and never requested the image again.
    callback reload-image();

    clip: true;
    background: Theme.viewer-surface;

    // Fit scale: the largest scale that shows the whole page inside the box.
    out property <float> fit-scale:
        (root.page.width <= 0 || root.page.height <= 0 || root.width <= 0px || root.height <= 0px)
            ? 1.0
            : Math.min((root.width / 1px) / (root.page.width * 1.0),
                       (root.height / 1px) / (root.page.height * 1.0));
    // One geometry path for both modes. Fit mode is just "scale = fit * zoom",
    // so panning and cursor-anchored zoom keep working while fitted instead of
    // silently switching to a different code path with different maths.
    out property <float> scale: root.fit-mode ? root.fit-scale * root.zoom : root.zoom;

    // Last pointer position, so `moved` can produce a delta for panning.
    property <float> last-x: 0.0;
    property <float> last-y: 0.0;

    img := Image {
        source: root.page.source;
        x: (root.width - self.width) / 2 + root.pan-x;
        y: (root.height - self.height) / 2 + root.pan-y;
        width: max(1px, root.page.width * root.scale * 1px);
        height: max(1px, root.page.height * root.scale * 1px);
        // Width and height are already aspect-correct, so `fill` cannot distort.
        image-fit: fill;
    }

    // Non-image states must never look like a broken image.
    // `width: 100%` plus paired stretch spacers is what actually centres these
    // blocks: a layout's own `alignment` only orders children, it does not centre
    // a fixed-width child, and a bare layout inside a Rectangle shrinks to its
    // preferred width and hugs the left edge.
    if root.page.failed : VerticalLayout {
        width: 100%;
        alignment: center;
        spacing: Theme.space-2;
        HorizontalLayout {
            width: 100%;
            Rectangle { horizontal-stretch: 1; }
            IconPresenter {
                name: "warning";
                glyph-size: 28px;
                tint: Theme.danger;
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Text {
            text: "图片加载失败";
            color: Theme.text-secondary;
            font-size: Theme.font-body;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            width: 100%;
            Rectangle { horizontal-stretch: 1; }
            AppButton {
                label: "重新载入";
                icon: "refresh";
                clicked => { root.reload-image(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    if !root.page.loaded && !root.page.failed : VerticalLayout {
        width: 100%;
        alignment: center;
        spacing: Theme.space-2;
        HorizontalLayout {
            width: 100%;
            Rectangle { horizontal-stretch: 1; }
            Skeleton { width: 96px; height: 6px; radius: Theme.radius-pill; }
            Rectangle { horizontal-stretch: 1; }
        }
        Text {
            text: "正在载入图片…";
            color: Theme.text-tertiary;
            font-size: Theme.font-small;
            horizontal-alignment: center;
        }
    }

    ta := TouchArea {
        scroll-event(e) => {
            root.request-zoom(ta.mouse-x / 1px, ta.mouse-y / 1px, e.delta-y / 1px,
                root.width / 1px, root.height / 1px);
            EventResult.accept
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.last-x = ta.mouse-x / 1px;
                root.last-y = ta.mouse-y / 1px;
            }
            EventResult.accept
        }
        moved => {
            if (ta.pressed && !root.fit-mode) {
                root.request-pan((ta.mouse-x / 1px) - root.last-x, (ta.mouse-y / 1px) - root.last-y);
            }
            root.last-x = ta.mouse-x / 1px;
            root.last-y = ta.mouse-y / 1px;
        }
        double-clicked => {
            root.request-toggle-zoom(ta.mouse-x / 1px, ta.mouse-y / 1px);
        }
        mouse-cursor: root.fit-mode ? MouseCursor.default : MouseCursor.grab;
    }

    // Floating control bar, as in WinUI's media surfaces. Width is explicit:
    // a child Rectangle without one fills its parent, which turned this pill into
    // a full-width strip across the middle of the image.
    if root.show-controls : Rectangle {
        width: controls.preferred-width;
        x: (root.width - self.width) / 2;
        y: root.height - self.height - Theme.space-3;
        height: 36px;
        border-radius: Theme.radius-lg;
        background: Theme.viewer-chrome;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 12px;
        drop-shadow-color: Theme.shadow-2;
        drop-shadow-offset-y: 2px;

        controls := HorizontalLayout {
            padding-left: Theme.space-1;
            padding-right: Theme.space-1;
            spacing: 0px;
            alignment: center;

            IconButton {
                icon: "fit";
                tip: "适应窗口";
                active: root.fit-mode;
                size: 28px;
                clicked => { root.set-fit-mode(true); root.set-zoom(1.0); }
            }
            IconButton {
                icon: "actual-size";
                tip: "实际尺寸";
                active: !root.fit-mode;
                size: 28px;
                clicked => { root.set-fit-mode(false); root.set-zoom(1.0); }
            }
            IconButton {
                icon: "zoom-out";
                tip: "缩小";
                size: 28px;
                clicked => { root.set-zoom(Math.max(0.2, root.zoom * 0.8)); }
            }
            Text {
                text: Math.round(root.scale * 100) + "%";
                color: Theme.text-secondary;
                font-size: Theme.font-caption;
                vertical-alignment: center;
                min-width: 44px;
                horizontal-alignment: center;
            }
            IconButton {
                icon: "zoom-in";
                tip: "放大";
                size: 28px;
                clicked => { root.set-zoom(Math.min(8.0, root.zoom * 1.25)); }
            }
            IconButton {
                icon: "fullscreen";
                tip: "全屏 (F11)";
                size: 28px;
                clicked => { root.toggle-fullscreen(); }
            }
        }
    }
}

/// Right-hand metadata column.
export component InfoPanel inherits Rectangle {
    in property <string> title: "";
    in property <string> author: "";
    in property <string> author-id: "";
    /// The author's real avatar, decoded by the same path the cards use.
    in property <image> avatar;
    /// 0 ok, 1 loading, 2 failed or absent
    in property <int> avatar-state: 1;
    in property <string> description: "";
    in property <[string]> tags: [];
    in property <string> posted: "";
    in property <int> kind: 0;
    in property <int> page-count: 1;
    in property <int> views: 0;
    in property <int> bookmarks: 0;
    in property <int> likes: 0;
    in property <bool> bookmarked: false;
    in property <bool> authenticated: false;
    in property <bool> following: false;
    in property <bool> busy: false;
    in property <string> ugoira-hint: "";

    callback toggle-bookmark();
    callback open-author();
    callback open-tag(string);
    callback download-page();
    callback download-all();
    callback export-ugoira();
    callback open-external();
    callback follow();

    background: Theme.layer;
    border-width: 1px;
    border-color: Theme.border;

    page := PageScroll {
        width: 100%;
        height: 100%;
        padding-x: Theme.space-4;
        padding-y: Theme.space-4;
        gutter: false;
        spacing: Theme.space-3;

        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.font-title;
            font-weight: Type.semibold;
            wrap: word-wrap;
        }

        // ---- author ----
        Rectangle {
            height: 44px;
            border-radius: Theme.radius-md;
            background: ta-author.has-hover ? Theme.layer-alt : transparent;

            HorizontalLayout {
                padding-left: Theme.space-1;
                padding-right: Theme.space-1;
                spacing: Theme.space-2;
                alignment: start;

                // The real face. A 32px blue disc with the character 画 was the last
                // thing in the app that looked like an avatar without being one; the
                // cards, the profile header and the top bar all switched to the real
                // image and this panel was left behind.
                //
                // Full-height cell, centred explicitly: a fixed-size child of a
                // horizontal layout is aligned to the start of the cross axis, which
                // is what put the old tile 6px high in a 44px row.
                Rectangle {
                    width: 32px;
                    height: 100%;
                    Avatar {
                        size: 32px;
                        y: (parent.height - self.height) / 2;
                        source: root.avatar;
                        state: root.avatar-state;
                        fallback: root.author;
                    }
                }

                // The author link must not cover the follow button. It used to be
                // a sibling declared *after* this layout, which in Slint puts it on
                // top of the whole row: every click on 「关注」 was swallowed by the
                // author touch area and the follow button never fired. Scoping the
                // touch area to the name column keeps the whole row clickable for
                // "open author" while giving the button its own hit region.
                ta-author := TouchArea {
                    mouse-cursor: pointer;
                    horizontal-stretch: 1;
                    clicked => { root.open-author(); }

                    VerticalLayout {
                        alignment: center;
                        spacing: 0px;
                        Text {
                            text: root.author;
                            color: Theme.text;
                            font-size: Theme.font-body;
                            font-weight: Type.medium;
                            overflow: elide;
                        }
                        Text {
                            text: "ID " + root.author-id;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-caption;
                            overflow: elide;
                        }
                    }
                }

                AppButton {
                    label: root.following ? "已关注" : "关注";
                    icon: "artist";
                    compact: true;
                    kind: root.following ? ButtonKind.Primary : ButtonKind.Secondary;
                    enabled: root.authenticated && !root.busy;
                    clicked => { root.follow(); }
                }
            }
        }

        // ---- primary actions ----
        HorizontalLayout {
            spacing: Theme.space-2;
            alignment: start;

            AppButton {
                label: root.bookmarked ? "已收藏" : "收藏";
                icon: "follow";
                kind: root.bookmarked ? ButtonKind.Primary : ButtonKind.Secondary;
                enabled: !root.busy;
                clicked => { root.toggle-bookmark(); }
            }
            AppButton {
                label: "保存本页";
                icon: "downloads";
                clicked => { root.download-page(); }
            }
        }

        HorizontalLayout {
            spacing: Theme.space-2;
            alignment: start;
            AppButton {
                label: root.page-count > 1 ? ("下载全部 " + root.page-count) : "下载";
                icon: "downloads";
                kind: ButtonKind.Secondary;
                clicked => { root.download-all(); }
            }
            if root.kind == 2 : AppButton {
                label: "导出动图 GIF";
                icon: "play";
                kind: ButtonKind.Secondary;
                enabled: !root.busy;
                clicked => { root.export-ugoira(); }
            }
        }

        AppButton {
            label: "在浏览器中打开";
            icon: "open";
            kind: ButtonKind.Subtle;
            clicked => { root.open-external(); }
        }

        if !root.authenticated : InfoBar {
            kind: InfoKind.Warning;
            title: "只读模式";
            message: "收藏与关注需要先完成登录（设置 → 账户）。";
        }

        if root.kind == 2 && root.ugoira-hint != "" : InfoBar {
            kind: InfoKind.Info;
            title: "动图（Ugoira）";
            message: root.ugoira-hint;
        }

        Divider { }

        // ---- stats ----
        HorizontalLayout {
            spacing: Theme.space-4;
            alignment: start;
            Text { text: "浏览 " + root.views; color: Theme.text-secondary; font-size: Theme.font-small; vertical-alignment: center; }
            Text { text: "收藏 " + root.bookmarks; color: Theme.text-secondary; font-size: Theme.font-small; vertical-alignment: center; }
            Text { text: "赞 " + root.likes; color: Theme.text-secondary; font-size: Theme.font-small; vertical-alignment: center; }
            Text { text: root.posted; color: Theme.text-tertiary; font-size: Theme.font-small; vertical-alignment: center; overflow: elide; }
        }

        if root.description != "" : Text {
            text: root.description;
            color: Theme.text-secondary;
            font-size: Theme.font-small;
            wrap: word-wrap;
        }

        if root.tags.length > 0 : VerticalLayout {
            spacing: Theme.space-2;
            Text {
                text: "标签";
                color: Theme.text-tertiary;
                font-size: Theme.font-caption;
                font-weight: Type.semibold;
            }
            // Two chips per row, emitted as explicit cells. A horizontal ScrollView
            // was tried first (a strip fixed at 60px that grows a scrollbar as soon
            // as the labels are a few pixels too wide looks like a broken control),
            // and so was `GridLayout` (it lays every child on a single row and just
            // overflows). Conditional children are excluded from the layout, so a
            // row with one tag renders as one chip and never truncates.
            VerticalLayout {
                spacing: 6px;
                for r in Math.ceil(root.tags.length / 2) : HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    if r * 2 < root.tags.length : TagChip {
                        label: root.tags[r * 2];
                        clicked => { root.open-tag(root.tags[r * 2]); }
                    }
                    if r * 2 + 1 < root.tags.length : TagChip {
                        label: root.tags[r * 2 + 1];
                        clicked => { root.open-tag(root.tags[r * 2 + 1]); }
                    }
                }
            }
        }
    }
}

/// Full page: toolbar + viewer + metadata + thumbnail strip.
export component DetailPage inherits Rectangle {
    in property <string> title: "";
    in property <string> author: "";
    in property <string> author-id: "";
    in property <image> author-avatar;
    in property <int> author-avatar-state: 1;
    in property <string> description: "";
    in property <[string]> tags: [];
    in property <string> posted: "";
    in property <int> kind: 0;
    in property <int> page-count: 1;
    in property <int> views: 0;
    in property <int> bookmarks: 0;
    in property <int> likes: 0;
    in property <bool> bookmarked: false;
    in property <bool> authenticated: false;
    in property <bool> following: false;
    in property <bool> busy: false;
    /// 0 content, 1 loading, 3 error
    in property <int> state: 0;
    in property <string> message: "";
    in property <string> ugoira-hint: "";

    in property <[ViewerPage]> pages: [];
    in-out property <int> current-page: 0;

    in-out property <float> zoom: 1.0;
    in-out property <length> pan-x: 0px;
    in-out property <length> pan-y: 0px;
    in property <bool> fit-mode: true;

    callback back();
    callback toggle-bookmark();
    callback open-author();
    callback open-tag(string);
    callback download-page();
    callback download-all();
    callback export-ugoira();
    callback open-external();
    callback follow();
    callback retry();
    callback select-page(int);
    callback request-zoom(float, float, float, float, float);
    callback request-pan(float, float);
    callback request-toggle-zoom(float, float);
    callback set-fit-mode(bool);
    callback set-zoom(float);
    callback toggle-fullscreen();
    callback reload-image();

    background: Theme.canvas;

    /// Content box width, pushed in by the shell. Reading the window width here
    /// reports as a binding loop.
    in property <length> available-width: 900px;
    out property <bool> wide: root.available-width >= 900px;

    /// Height / width of the page being viewed, clamped to a usable band. The
    /// narrow layout uses it to size the viewer from the artwork instead of from a
    /// stretch factor: a portrait work in a 3:2 stretch box was fitted at 25% with
    /// most of the box empty. Unknown dimensions fall back to 1:1, which is what
    /// `IllustCard` does and keeps the two consistent.
    out property <float> viewer-aspect: (
        root.pages.length == 0
        || root.pages[Math.min(root.current-page, root.pages.length - 1)].width <= 0
        || root.pages[Math.min(root.current-page, root.pages.length - 1)].height <= 0
    ) ? 1.0 : Math.max(0.55, Math.min(1.6,
        root.pages[Math.min(root.current-page, root.pages.length - 1)].height * 1.0
            / (root.pages[Math.min(root.current-page, root.pages.length - 1)].width * 1.0)
    ));

    VerticalLayout {
        // ---- toolbar ----
        //
        // This row's width is the page's width anchor, not decoration. The page
        // area is one element shared by six pages and it is sized from its
        // resolved content, so a page whose widest child is narrow is only as
        // wide as that child: measured before the fix, the error state's widest
        // child was `StateView`'s 420px block plus padding = 452px, so the
        // toolbar stopped 348px short of the page's right edge and the state
        // block sat 170px left of the page centre. Stating the width on the body
        // layout itself does not work (`width: 100%`, `width: root.width` and
        // `width: 700px` all resolved back to the preferred 452px — measured);
        // stating it on a child that relays it into the layout's preferred width
        // does. `available-width` is the content box the shell computed
        // (window minus the navigation pane, from `src/app.rs`), so this row and
        // every row under it are exactly as wide as the page.
        Rectangle {
            height: 44px;
            background: Theme.canvas;

            HorizontalLayout {
                padding-left: Theme.space-2;
                padding-right: Theme.space-2;
                spacing: Theme.space-1;

                IconButton {
                    icon: "back";
                    tip: "返回";
                    row-height: 44px;
                    clicked => { root.back(); }
                }

                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: Theme.font-body;
                    font-weight: Type.medium;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                if root.page-count > 1 : Badge {
                    label: (root.current-page + 1) + " / " + root.page-count;
                    fill: Theme.layer-alt;
                    ink: Theme.text-secondary;
                }

                IconButton {
                    icon: "fit";
                    tip: root.fit-mode ? "当前：适应窗口" : "当前：实际尺寸";
                    active: root.fit-mode;
                    clicked => {
                        root.set-fit-mode(!root.fit-mode);
                        root.set-zoom(1.0);
                    }
                }
                IconButton {
                    icon: "open";
                    tip: "在浏览器中打开";
                    clicked => { root.open-external(); }
                }
                IconButton {
                    icon: "refresh";
                    tip: "重新载入";
                    clicked => { root.retry(); }
                }
            }
        }

        Divider { }

        if root.state == 1 : Rectangle {
            height: 96px;
            LoadingRow {
                y: (parent.height - self.height) / 2;
                bar-width: 140px;
                label: "正在载入作品…";
            }
        }

        // Centred, not stretched. `StateView` starts its 420px description at the
        // beginning of its content box, so a stretched block centres the heading
        // over a left-shifted description; the paired stretch spacers centre the
        // block itself, which keeps heading, description and button on one axis at
        // the page centre.
        if root.state == 3 : HorizontalLayout {
            width: 100%;

            Rectangle { horizontal-stretch: 1; }

            StateView {
                kind: StateKind.Error;
                title: "无法载入作品";
                description: root.message;
                action-label: "重试";
                retry => { root.retry(); }
            }

            Rectangle { horizontal-stretch: 1; }
        }

        if root.state == 0 && root.pages.length > 0 && root.wide : HorizontalLayout {
            spacing: Theme.space-3;
            padding: Theme.space-3;

            ZoomViewer {
                horizontal-stretch: 1;
                page: root.pages[Math.min(root.current-page, root.pages.length - 1)];
                fit-mode: root.fit-mode;
                zoom <=> root.zoom;
                pan-x <=> root.pan-x;
                pan-y <=> root.pan-y;
                request-zoom(px, py, dy, w, h) => { root.request-zoom(px, py, dy, w, h); }
                request-pan(dx, dy) => { root.request-pan(dx, dy); }
                request-toggle-zoom(px, py) => { root.request-toggle-zoom(px, py); }
                set-fit-mode(m) => { root.set-fit-mode(m); }
                set-zoom(z) => { root.set-zoom(z); }
                toggle-fullscreen => { root.toggle-fullscreen(); }
                reload-image => { root.reload-image(); }
            }

            Rectangle {
                width: Math.min(360px, root.available-width * 0.38);
                border-radius: Theme.radius-lg;
                clip: true;

                InfoPanel {
                    width: parent.width;
                    height: parent.height;
                    title: root.title;
                    author: root.author;
                    author-id: root.author-id;

                    avatar: root.author-avatar;

                    avatar-state: root.author-avatar-state;
                    description: root.description;
                    tags: root.tags;
                    posted: root.posted;
                    kind: root.kind;
                    page-count: root.page-count;
                    views: root.views;
                    bookmarks: root.bookmarks;
                    likes: root.likes;
                    bookmarked: root.bookmarked;
                    authenticated: root.authenticated;
                    following: root.following;
                    busy: root.busy;
                    ugoira-hint: root.ugoira-hint;
                    toggle-bookmark => { root.toggle-bookmark(); }
                    open-author => { root.open-author(); }
                    open-tag(t) => { root.open-tag(t); }
                    download-page => { root.download-page(); }
                    download-all => { root.download-all(); }
                    export-ugoira => { root.export-ugoira(); }
                    open-external => { root.open-external(); }
                    follow => { root.follow(); }
                }
            }
        }

        // Narrow layout: the viewer's height is derived from the page's own aspect
        // ratio instead of a stretch factor. A 3:2 stretch gave a portrait artwork a
        // 1100x430 box, so "fit" scaled it to 25% and the box was mostly empty
        // backdrop. Sizing the box to the artwork (capped to the space available)
        // means the embedded viewer shows the picture it was given.
        if root.state == 0 && root.pages.length > 0 && !root.wide : VerticalLayout {
            ZoomViewer {
                // `available-width` is the content box, so the estimate subtracts the
                // page padding the surrounding layout adds.
                //
                // Two caps, both necessary: the aspect cap stops a 1:1.6 portrait from
                // being fitted at 25% inside a wide letterbox, and the height cap stops
                // the artwork from pushing the whole metadata column below the fold in
                // a short window. Whichever is smaller wins.
                height: Math.min(
                    root.height * 0.55,
                    max(200px, root.available-width - Theme.space-6) * root.viewer-aspect
                        + Theme.space-6
                );
                page: root.pages[Math.min(root.current-page, root.pages.length - 1)];
                fit-mode: root.fit-mode;
                zoom <=> root.zoom;
                pan-x <=> root.pan-x;
                pan-y <=> root.pan-y;
                request-zoom(px, py, dy, w, h) => { root.request-zoom(px, py, dy, w, h); }
                request-pan(dx, dy) => { root.request-pan(dx, dy); }
                request-toggle-zoom(px, py) => { root.request-toggle-zoom(px, py); }
                set-fit-mode(m) => { root.set-fit-mode(m); }
                set-zoom(z) => { root.set-zoom(z); }
                toggle-fullscreen => { root.toggle-fullscreen(); }
                reload-image => { root.reload-image(); }
            }
            InfoPanel {
                vertical-stretch: 2;
                min-height: 160px;
                title: root.title;
                author: root.author;
                author-id: root.author-id;

                avatar: root.author-avatar;

                avatar-state: root.author-avatar-state;
                description: root.description;
                tags: root.tags;
                posted: root.posted;
                kind: root.kind;
                page-count: root.page-count;
                views: root.views;
                bookmarks: root.bookmarks;
                likes: root.likes;
                bookmarked: root.bookmarked;
                authenticated: root.authenticated;
                following: root.following;
                busy: root.busy;
                ugoira-hint: root.ugoira-hint;
                toggle-bookmark => { root.toggle-bookmark(); }
                open-author => { root.open-author(); }
                open-tag(t) => { root.open-tag(t); }
                download-page => { root.download-page(); }
                download-all => { root.download-all(); }
                export-ugoira => { root.export-ugoira(); }
                open-external => { root.open-external(); }
                follow => { root.follow(); }
            }
        }

        // ---- page thumbnail strip ----
        if root.state == 0 && root.pages.length > 1 : Rectangle {
            height: 68px;
            background: Theme.layer;

            ScrollView {
                width: 100%;
                height: 100%;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;

                HorizontalLayout {
                    padding: Theme.space-2;
                    spacing: Theme.space-2;
                    alignment: start;

                    for p[i] in root.pages : Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: Theme.radius-sm;
                        border-width: (i == root.current-page) ? 2px : 1px;
                        border-color: (i == root.current-page) ? Theme.accent-fill : Theme.border;
                        background: Theme.layer-alt;
                        clip: true;

                        Image {
                            source: p.thumb;
                            width: 100%;
                            height: 100%;
                            image-fit: cover;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.select-page(i); }
                        }
                    }
                }
            }
        }
    }
}
