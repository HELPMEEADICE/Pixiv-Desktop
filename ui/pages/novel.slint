// Novel landing page: what the novel is, and the way into it.
//
// Deliberately a *reading* page and not another gallery: a novel has one cover,
// a title that can be two lines long, an author, a character count, and a body.
// The page therefore spends its width on the title block and keeps the cover a
// fixed 150x210 (a book, next to its metadata), which is the same relationship
// Pixiv's own novel page uses.
//
// Layout rules this page follows, because every page in this app must:
//   * no literal font size or weight - Label/BodyText pick a role;
//   * no text in a horizontal row without a stated vertical alignment;
//   * a cover is a fixed box, so the metadata column can never be pushed around
//     by an image that has not decoded yet (state 1 keeps the box).

import { ScrollView } from "std-widgets.slint";
import { Theme, Type, Emphasis, TextRole } from "../theme.slint";
import {
    PageScroll, AppButton, ButtonKind, IconButton, Label, BodyText, TagChip, Divider,
    StateView, StateKind, Skeleton, Avatar, SectionHeader, IconSlot, InfoBar, InfoKind,
} from "../components.slint";
import { NovelView, NovelChapter } from "../novel-model.slint";

component ChapterRow inherits Rectangle {
    in property <NovelChapter> chapter;
    callback open();
    callback reveal(length, length);

    height: 44px;
    border-radius: Theme.radius-sm;
    background: root.chapter.current ? Theme.accent-subtle
        : (row.has-hover ? Theme.layer-alt : transparent);

    accessible-role: AccessibleRole.list-item;
    accessible-label: root.chapter.current
        ? "第 " + root.chapter.order + " 章：" + root.chapter.title + "（当前）"
        : "第 " + root.chapter.order + " 章：" + root.chapter.title;
    accessible-action-default => { root.open(); }
    forward-focus: key-focus;

    property <bool> held: key-focus.has-focus;
    changed held => {
        if (root.held) { root.reveal(root.absolute-position.y, root.height); }
    }
    border-width: root.held ? Theme.select-ring : 0px;
    border-color: Theme.focus-ring;

    key-focus := FocusScope {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        key-pressed(e) => {
            if (e.text == "\n" || e.text == " ") {
                root.open();
                return EventResult.accept;
            }
            EventResult.reject
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;
        spacing: Theme.space-3;

        // The order is a fixed 28px column so every chapter
        // title starts on one vertical rule.
        Label {
            role: TextRole.Caption;
            text: root.chapter.order;
            color: root.chapter.current ? Theme.accent-ink : Theme.text-tertiary;
            width: 28px;
            horizontal-alignment: right;
        }
        Label {
            role: TextRole.Body;
            text: root.chapter.title;
            color: root.chapter.current ? Theme.accent-ink : Theme.text;
            horizontal-stretch: 1;
        }
        if root.chapter.meta != "" : Label {
            role: TextRole.Caption;
            text: root.chapter.meta;
            color: Theme.text-tertiary;
        }
        if root.chapter.current : IconSlot {
            name: "check";
            slot: Theme.icon-size;
            tint: Theme.accent-ink;
        }
    }

    row := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }
    }
}

export component NovelPage inherits Rectangle {
    in-out property <length> scroll-y: 0px;
    in property <NovelView> view;
    in property <[string]> tags: [];
    in property <[NovelChapter]> chapters: [];
    /// Which chip holds the tag strip's single keyboard cursor (U6, the idiom
    /// `home.slint`'s recommend-tags band already uses).
    in-out property <int> tag-cursor: 0;

    callback scrolled(length);
    callback read();
    callback open-author();
    callback open-tag(string);
    callback open-chapter(string);
    callback toggle-bookmark();
    callback retry();
    callback open-external();

    background: Theme.canvas;

    if root.view.state == 1 : Rectangle {
        background: Theme.canvas;
        VerticalLayout {
            alignment: center;
            StateView {
                kind: StateKind.Loading;
                title: "正在载入小说…";
            }
        }
    }

    if root.view.state == 2 || root.view.state == 3 : PageScroll {
        scroll-y <=> root.scroll-y;
        scrolled(y) => { root.scrolled(y); }
        VerticalLayout {
            spacing: Theme.space-4;
            StateView {
                kind: root.view.state == 2 ? StateKind.Empty : StateKind.Error;
                glyph: "novel";
                title: root.view.state == 2 ? "这本小说打不开" : "小说载入失败";
                description: root.view.message;
                action-label: root.view.state == 3 ? "重试" : "";
                retry => { root.retry(); }
                action => { root.retry(); }
            }
        }
    }

    if root.view.state == 0 : detail-scroll := PageScroll {
        scroll-y <=> root.scroll-y;
        scrolled(y) => { root.scrolled(y); }

        VerticalLayout {
            spacing: Theme.space-5;

            // ---------------- title block ----------------
            Rectangle {
                height: hero.preferred-height;
                border-radius: Theme.radius-lg;
                background: Theme.layer;
                border-width: 1px;
                border-color: Theme.border;

                hero := VerticalLayout {
                    padding-top: Theme.space-4;
                    padding-bottom: Theme.space-4;
                    padding-left: Theme.space-4;
                    padding-right: Theme.space-4;
                    spacing: Theme.space-4;

                    HorizontalLayout {
                        spacing: Theme.space-4;

                        // The cover box is fixed whatever the image is doing, so the
                        // title column never reflows when a decode lands.
                        Rectangle {
                            width: 150px;
                            height: 210px;
                            border-radius: Theme.radius-md;
                            background: Theme.layer-alt;
                            border-width: 1px;
                            border-color: Theme.border;
                            clip: true;

                            Image {
                                source: root.view.cover;
                                image-fit: cover;
                                width: 100%;
                                height: 100%;
                                visible: root.view.cover-state == 0;
                            }
                            if root.view.cover-state != 0 : IconSlot {
                                name: "novel";
                                slot: 28px;
                                glyph-size: 28px;
                                tint: Theme.text-disabled;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: Theme.space-3;

                            BodyText {
                                role: TextRole.Page;
                                emphasis: Emphasis.Semibold;
                                text: root.view.title;
                                color: Theme.text;
                                max-lines: 3;
                                overflow: elide;
                            }

                            // Author row: avatar, name, handle. One centre line for
                            // all three, which is what Avatar + Label buy.
                            Rectangle {
                                height: 32px;
                                background: transparent;
                                width: author-row.preferred-width;

                                author-row := HorizontalLayout {
                                    spacing: Theme.space-2;

                                    Avatar {
                                        size: 32px;
                                        source: root.view.author-avatar;
                                        state: root.view.author-avatar-state;
                                        fallback: root.view.author;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 1px;
                                        Label {
                                            role: TextRole.Body;
                                            emphasis: Emphasis.Medium;
                                            text: root.view.author;
                                            color: Theme.text;
                                        }
                                        if root.view.account != "" : Label {
                                            role: TextRole.Caption;
                                            text: "@" + root.view.account;
                                            color: Theme.text-tertiary;
                                        }
                                    }
                                }

                                // U2 (plan R10 §2.2): the author block was a click
                                // target and nothing else — two TouchAreas and zero
                                // roles on the whole page. One name, one action, and a
                                // FocusScope *before* the TouchArea, exactly as
                                // IllustCard orders its three pieces.
                                accessible-role: AccessibleRole.button;
                                accessible-label: root.view.account != ""
                                    ? root.view.author + " (@" + root.view.account + ")"
                                    : root.view.author;
                                accessible-action-default => { root.open-author(); }

                                key_focus := FocusScope {
                                    key-pressed(e) => {
                                        if (e.text == "\n" || e.text == " ") {
                                            root.open-author();
                                            return EventResult.accept;
                                        }
                                        EventResult.reject
                                    }
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.open-author(); }
                                }
                            }

                            if root.view.stats != "" : Label {
                                role: TextRole.Caption;
                                text: root.view.stats;
                                color: Theme.text-tertiary;
                            }

                            // Actions. Primary verb first, as on every other page.
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                height: Theme.control-height;

                                AppButton {
                                    kind: ButtonKind.Primary;
                                    icon: "novel";
                                    label: root.view.read-label;
                                    clicked => { root.read(); }
                                }
                                AppButton {
                                    kind: ButtonKind.Secondary;
                                    icon: root.view.bookmarked ? "star" : "star";
                                    label: root.view.bookmarked ? "已收藏" : "收藏";
                                    enabled: root.view.busy;
                                    clicked => { root.toggle-bookmark(); }
                                }
                                AppButton {
                                    kind: ButtonKind.Subtle;
                                    icon: "open";
                                    label: "在 pixiv 打开";
                                    clicked => { root.open-external(); }
                                }
                            }
                        }
                    }

                    // U6 + U11 (plan R10 §2.2).
                    //
                    // U6: this was 26 px of chip in a `clip: true` box around a bare
                    // `Flickable` with both scrollbars off. Chips past the width could
                    // not be wheel-scrolled (the flickable was drag-only and competed
                    // with the page's own vertical drag), could not be reached by the
                    // keyboard, and the drag gesture moved the page under the pointer.
                    // The strip is now the shape `home.slint`'s recommend-tags band
                    // already uses — a `ScrollView` with the chips' roving focus, so
                    // Left/Right walk the row and Tab leaves it in one press — plus
                    // the two arrow buttons a strip this short needs, because the
                    // horizontal bar cannot be drawn on it: R9 §12d measured the bar
                    // landing on the chip baseline.
                    //
                    // U11: the height was the literal 26 twice (container and the
                    // flickable's `content-height`), unrelated to the chip it was
                    // supposed to hold. It is now the chip row's own height, so a
                    // taller `TagChip` can only make the band taller, never crop.
                    if root.tags.length > 0 : tag-strip := Rectangle {
                        height: chip-row.preferred-height;
                        background: transparent;

                        IconButton {
                            x: 0px;
                            y: 0px;
                            icon: "chevron-left";
                            tip: "向左滚动标签";
                            size: Theme.control-height-sm;
                            row-height: Theme.control-height-sm;
                            enabled: strip.content-x < 0px;
                            clicked => {
                                strip.content-x = min(0px, strip.content-x + strip.visible-width);
                            }
                        }

                        strip := ScrollView {
                            x: Theme.control-height-sm + Theme.space-1;
                            width: max(0px, tag-strip.width - (Theme.control-height-sm + Theme.space-1) * 2);
                            height: 100%;
                            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                            chip-row := HorizontalLayout {
                                spacing: Theme.space-2;
                                alignment: start;
                                for t[i] in root.tags : TagChip {
                                    label: t;
                                    index: i;
                                    cursor: root.tag-cursor;
                                    gained-focus(idx) => { root.tag-cursor = idx; }
                                    move-cursor(d) => {
                                        root.tag-cursor = Math.max(0, Math.min(
                                            root.tags.length - 1, root.tag-cursor + d));
                                    }
                                    clicked => { root.open-tag(t); }
                                }
                            }
                        }

                        IconButton {
                            x: tag-strip.width - Theme.control-height-sm;
                            y: 0px;
                            icon: "chevron-right";
                            tip: "向右滚动标签";
                            size: Theme.control-height-sm;
                            row-height: Theme.control-height-sm;
                            enabled: strip.content-x > strip.visible-width - strip.content-width + 1px;
                            clicked => {
                                strip.content-x = max(
                                    strip.visible-width - strip.content-width,
                                    strip.content-x - strip.visible-width);
                            }
                        }
                    }

                    if root.view.caption != "" : BodyText {
                        role: TextRole.Small;
                        text: root.view.caption;
                        color: Theme.text-secondary;
                        max-lines: 6;
                        overflow: elide;
                    }
                }
            }

            // ---------------- series ----------------
            Rectangle {
                visible: root.view.series-title != "";
                height: self.visible ? series-card.preferred-height : 0px;
                border-radius: Theme.radius-lg;
                background: Theme.layer;
                border-width: 1px;
                border-color: Theme.border;

                series-card := VerticalLayout {
                    padding-top: Theme.space-3;
                    padding-bottom: Theme.space-3;
                    padding-left: Theme.space-4;
                    padding-right: Theme.space-4;
                    spacing: Theme.space-2;

                    SectionHeader {
                        title: "章节目录";
                        subtitle: root.view.series-title + (root.view.series-meta == "" ? "" : " · " + root.view.series-meta);
                    }
                    Divider { }

                    if root.view.chapters-state == 1 : Label {
                        height: 40px;
                        role: TextRole.Small;
                        text: "正在载入章节…";
                        color: Theme.text-tertiary;
                    }
                    if root.view.chapters-state == 3 : InfoBar {
                        kind: InfoKind.Warning;
                        title: "章节列表载入失败";
                        message: root.view.chapters-message;
                        action-label: "重试";
                        action => { root.retry(); }
                    }
                    if root.view.chapters-state == 0 && root.chapters.length == 0 : Label {
                        height: 40px;
                        role: TextRole.Small;
                        text: "这个系列没有可见章节";
                        color: Theme.text-tertiary;
                    }

                    for chapter in root.chapters : ChapterRow {
                        chapter: chapter;
                        open => { root.open-chapter(chapter.id); }
                        reveal(y, h) => {
                            let top = y - detail-scroll.absolute-position.y;
                            let overflow = max(0px, detail-scroll.body-height - detail-scroll.viewport-height);
                            let above = min(0px, top - Theme.space-2);
                            let below = max(0px, top + h + Theme.space-2 - detail-scroll.viewport-height);
                            detail-scroll.scroll-y = max(-overflow, min(0px,
                                detail-scroll.scroll-y - above - below));
                        }
                    }
                }
            }

            // Footer: the one place the page says where the data came from.
            Label {
                height: 28px;
                role: TextRole.Caption;
                text: root.view.posted == "" ? "" : "发布于 " + root.view.posted + " · 数据来自 Pixiv 小说 API";
                color: Theme.text-tertiary;
                horizontal-alignment: center;
            }
        }
    }
}
