// Novel search and recent reading.
//
// The page exists because a novel is not an illustration: it has no pages, no
// aspect ratio and no bookmark-pill overlay, and the artwork grid would have to
// special-case all three. A list of rows is the honest shape for search results
// (title, author, length) and it is also what "recent reading" is.
//
// It reuses the shell's search box for the *artwork* search, so this page has its
// own field: two searches that share one input is how a query ends up being sent
// to the wrong endpoint.

import { ScrollView } from "std-widgets.slint";
import { Theme, Type, Emphasis, TextRole } from "../theme.slint";
import {
    PageScroll, AppButton, ButtonKind, IconSlot, Label, BodyText, TextField, Divider,
    StateView, StateKind, SectionHeader, IconPresenter, Skeleton,
} from "../components.slint";
import { NovelRow } from "../novel-model.slint";

/// One result row: a 48x64 cover, the title, the author and one metadata line.
///
/// The cover is a fixed box for the same reason the card cover is: a decode that
/// lands late must not move the text beside it. The row is 72px tall, so a
/// two-line title still leaves 4px of air.
component NovelRowView inherits Rectangle {
    in property <NovelRow> entry;
    callback open(string);

    /// The reading position as a whole percentage, for the caption. `Math.round`
    /// returns an int, so the string is built from an int and not from a float
    /// with a locale-dependent tail.
    out property <int> progress-pct: Math.round(root.entry.progress);
    /// True only when the store actually had a position for this row.
    out property <bool> has-progress: root.entry.progress >= 0.0;

    // A floor, not a ceiling: a row with a progress line is taller than one
    // without, and a fixed 72 px would have clipped the line it just added. The
    // same shape `ui/pages/profile.slint` uses for its identity card (U10).
    height: max(72px, row-layout.preferred-height);
    border-radius: Theme.radius-md;
    background: ta.has-hover ? Theme.layer-alt : transparent;

    // U1 (plan R10 §2.2): the row's only hit surface was a bare `TouchArea`, so it
    // was unreachable by keyboard and anonymous in the UIA tree. Same three pieces
    // as `IllustCard`: one role and one name on the row, Enter/Space as its
    // default action, and the FocusScope declared *before* the TouchArea — a scope
    // declared after it is the topmost input element and swallows the first press
    // to take focus, so the row would need two clicks to open (`uiaudit` keeps
    // that order).
    accessible-role: AccessibleRole.list-item;
    accessible-label: root.entry.author != ""
        ? root.entry.title + " · " + root.entry.author
        : root.entry.title;
    accessible-action-default => { root.open(root.entry.id); }

    row-layout := HorizontalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-3;
        spacing: Theme.space-3;

        Rectangle {
            width: 48px;
            height: 64px;
            border-radius: Theme.radius-sm;
            background: Theme.layer-alt;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            Image {
                source: root.entry.cover;
                image-fit: cover;
                width: 100%;
                height: 100%;
                visible: root.entry.cover-state == 0;
            }
            if root.entry.cover-state != 0 : IconSlot {
                name: "novel";
                slot: Theme.icon-size;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                tint: Theme.text-disabled;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Label {
                role: TextRole.Body;
                emphasis: Emphasis.Medium;
                text: root.entry.title;
                color: Theme.text;
            }
            HorizontalLayout {
                height: 18px;
                spacing: Theme.space-2;
                Label {
                    role: TextRole.Caption;
                    text: root.entry.author;
                    color: Theme.text-secondary;
                }
                if root.entry.series != "" : Label {
                    role: TextRole.Caption;
                    text: "· " + root.entry.series;
                    color: Theme.text-tertiary;
                }
            }
            Label {
                role: TextRole.Caption;
                text: root.entry.meta;
                color: Theme.text-tertiary;
            }

            // ---- F4: where the reader stopped ----
            // A 3 px rule and its percentage, under the metadata line. The rule's
            // height is `Theme.progress-rule-height` (the theme is the only place
            // a length may be written, and this one is declared there for exactly
            // this row). A row at -1 draws neither: `has-progress` is false, so
            // nothing here exists to paint a 0 % bar.
            if root.has-progress : HorizontalLayout {
                spacing: Theme.space-2;
                // Cross-axis centred: a 3 px rule in a 26 px line top-aligned would
                // read as an underline of the meta line above it.
                alignment: center;
                height: Theme.control-height-sm;

                Rectangle {
                    horizontal-stretch: 1;
                    height: Theme.progress-rule-height;
                    border-radius: Theme.radius-pill;
                    background: Theme.layer-sunken;

                    Rectangle {
                        width: parent.width * Math.max(0.0, Math.min(1.0, root.entry.progress / 100.0));
                        height: parent.height;
                        border-radius: Theme.radius-pill;
                        background: Theme.accent-ink;
                    }
                }

                // "读了 42%", not "42%": the number needs a verb or it reads as a
                // completion of something the row never started.
                Label {
                    role: TextRole.Caption;
                    text: "读了 " + root.progress-pct + "%";
                    color: Theme.text-tertiary;
                }
            }
        }

        Label {
            role: TextRole.Caption;
            text: "#" + root.entry.id;
            color: Theme.text-tertiary;
        }
    }

    key_focus := FocusScope {
        key-pressed(e) => {
            if (e.text == "\n" || e.text == " ") {
                root.open(root.entry.id);
                return EventResult.accept;
            }
            EventResult.reject
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(root.entry.id); }
    }
}

export component NovelsPage inherits Rectangle {
    in-out property <string> query: "";
    in property <[NovelRow]> rows: [];
    in property <[NovelRow]> recent: [];
    /// 0 content, 1 loading, 2 empty, 3 error.
    in property <int> state: 0;
    in property <string> message: "";
    in property <string> title: "小说";
    in property <string> subtitle: "Pixiv 小说搜索与本机阅读记录";
    callback search(string);
    callback open(string);
    callback refresh();
    callback load-more();

    background: Theme.canvas;

    PageScroll {
        padding-y: Theme.space-4;
        VerticalLayout {
            spacing: Theme.space-4;

            // ---- header ----
            HorizontalLayout {
                height: 40px;
                spacing: Theme.space-3;

                VerticalLayout {
                    alignment: center;
                    spacing: 0px;
                    horizontal-stretch: 1;
                    Label {
                        role: TextRole.Page;
                        emphasis: Emphasis.Semibold;
                        text: root.title;
                        color: Theme.text;
                    }
                    Label {
                        role: TextRole.Small;
                        text: root.subtitle;
                        color: Theme.text-tertiary;
                    }
                }

                AppButton {
                    kind: ButtonKind.Subtle;
                    icon: "refresh";
                    label: "刷新";
                    row-height: 40px;
                    clicked => { root.refresh(); }
                }
            }

            // ---- search ----
            HorizontalLayout {
                height: Theme.control-height-lg;
                spacing: Theme.space-2;

                TextField {
                    height: Theme.control-height-lg;
                    leading-icon: "search";
                    placeholder: "搜索 Pixiv 小说：标题、标签或作者…";
                    text <=> root.query;
                    accepted(t) => { root.search(t); }
                    horizontal-stretch: 1;
                }
                AppButton {
                    kind: ButtonKind.Primary;
                    icon: "search";
                    label: "搜索";
                    visual-height: Theme.control-height-lg;
                    clicked => { root.search(root.query); }
                }
            }

            if root.state == 1 : Rectangle {
                height: 120px;
                background: transparent;
                StateView {
                    kind: StateKind.Loading;
                    title: "正在搜索小说…";
                    description: "/ajax/search/novels/" + root.query;
                }
            }
            if root.state == 2 : Rectangle {
                height: 140px;
                background: transparent;
                StateView {
                    kind: StateKind.Empty;
                    glyph: "novel";
                    title: root.query == "" ? "还没有搜索过小说" : "没有找到小说";
                    description: root.message;
                }
            }
            if root.state == 3 : Rectangle {
                height: 140px;
                background: transparent;
                StateView {
                    kind: StateKind.Error;
                    title: "小说搜索失败";
                    description: root.message;
                    action-label: "重试";
                    retry => { root.search(root.query); }
                    action => { root.search(root.query); }
                }
            }

            // ---- recent reading ----
            if root.recent.length > 0 : Rectangle {
                height: recent-card.preferred-height;
                border-radius: Theme.radius-lg;
                background: Theme.layer;
                border-width: 1px;
                border-color: Theme.border;

                recent-card := VerticalLayout {
                    padding-top: Theme.space-2;
                    padding-bottom: Theme.space-2;
                    padding-left: Theme.space-3;
                    padding-right: Theme.space-3;
                    spacing: Theme.space-1;

                    SectionHeader {
                        title: "最近阅读";
                        subtitle: "本机记录，按最近打开的先后排序";
                    }
                    for r[i] in root.recent : NovelRowView {
                        entry: r;
                        open(id) => { root.open(id); }
                    }
                }
            }

            // ---- results ----
            // A10: `state == 1` is "this search is in flight" and the loading block above is
            // 120 px in the same column. Both used to render, so every search pushed the
            // previous result list down 120 px and pulled it back when the payload landed —
            // the page jumped instead of refreshing. The two are exclusive: while a search
            // runs, the block above is what the column says.
            if root.rows.length > 0 && root.state != 1 : Rectangle {
                height: results-card.preferred-height;
                border-radius: Theme.radius-lg;
                background: Theme.layer;
                border-width: 1px;
                border-color: Theme.border;

                results-card := VerticalLayout {
                    padding-top: Theme.space-2;
                    padding-bottom: Theme.space-2;
                    padding-left: Theme.space-3;
                    padding-right: Theme.space-3;
                    spacing: 0px;

                    HorizontalLayout {
                        height: 32px;
                        spacing: Theme.space-2;
                        Label {
                            role: TextRole.Small;
                            emphasis: Emphasis.Semibold;
                            text: root.query == "" ? "全部结果" : "搜索结果";
                            color: Theme.text;
                            horizontal-stretch: 1;
                        }
                        Label {
                            role: TextRole.Caption;
                            text: root.rows.length + " 项";
                            color: Theme.text-tertiary;
                        }
                    }
                    Divider { }
                    for r[i] in root.rows : NovelRowView {
                        entry: r;
                        open(id) => { root.open(id); }
                    }

                    HorizontalLayout {
                        height: Theme.control-height;
                        alignment: center;
                        if root.rows.length >= 20 : AppButton {
                            kind: ButtonKind.Subtle;
                            label: "加载更多";
                            clicked => { root.load-more(); }
                        }
                    }
                }
            }
        }
    }
}
