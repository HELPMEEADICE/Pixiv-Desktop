import { ScrollView } from "std-widgets.slint";
// Reusable illustration grid page.
//
// Home, Discovery, Ranking, Search, Bookmarks, History and Artist all share this
// layout, so scrolling behaviour, skeleton states and the masonry algorithm are
// implemented exactly once.
//
// Masonry note: cards derive their height from their own width and the
// illustration's aspect ratio, and the page is laid out as independent vertical
// columns. That means no cropping, no letterboxing and no row equalisation —
// which is what Pixiv's own feed looks like.

import { Theme, Type } from "../theme.slint";
import {
    IllustCard, IllustItem, StateView, StateKind, Skeleton, SectionHeader,
    TagChip, AppButton, ButtonKind,
} from "../components.slint";

export component IllustGrid inherits Rectangle {
    /// Column-major buckets, computed by Rust for the current window width.
    in property <[[IllustItem]]> columns: [];
    /// Width of one column. Computed in Rust from the window width so the card
    /// never has to derive its own width from its layout parent (that forms a
    /// binding loop through the scroll view's content width).
    in property <length> card-width: 220px;
    /// 0 content, 1 loading, 2 empty, 3 error, 4 locked (needs sign-in).
    in property <int> state: 0;
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <string> message: "";
    in property <string> action-label: "";
    in property <[string]> tags: [];
    in property <string> active-tag: "";
    in property <bool> loading-more: false;
    in property <bool> show-header: true;
    /// Preserved across page switches so navigation does not lose scroll position.
    in-out property <length> scroll-y: 0px;

    callback open-illust(string);
    callback open-author(string);
    callback toggle-bookmark(string);
    callback open-tag(string);
    callback retry();
    callback action();
    callback load-more();

    background: Theme.canvas;

    scroll := ScrollView {
        content-y <=> root.scroll-y;
        // Horizontal scrolling is never wanted; the grid is width-driven.
        content-x: 0px;

        // Ask for the next page a little before the user hits the bottom, so the
        // grid never stalls at an empty edge.
        changed content-y => {
            if (root.state == 0 && !root.loading-more) {
                if (self.content-y + self.height + 400px >= inner.height) {
                    root.load-more();
                }
            }
        }

        inner := VerticalLayout {
            padding-left: Theme.page-padding;
            padding-right: Theme.page-padding;
            padding-top: Theme.space-4;
            padding-bottom: Theme.space-8;
            spacing: Theme.space-4;

            // ---------------- header ----------------
            if root.show-header : VerticalLayout {
                spacing: Theme.space-2;

                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: Theme.font-page;
                    font-weight: Type.semibold;
                }
                if root.subtitle != "" : Text {
                    text: root.subtitle;
                    color: Theme.text-secondary;
                    font-size: Theme.font-small;
                }
                if root.tags.length > 0 : HorizontalLayout {
                    spacing: Theme.space-2;
                    
                    for t in root.tags : TagChip {
                        label: t;
                        active: t == root.active-tag;
                        clicked => { root.open-tag(t); }
                    }
                }
            }

            // ---------------- loading ----------------
            if root.state == 1 : HorizontalLayout {
                spacing: Theme.space-3;
                for n in [0, 1, 2, 3] : VerticalLayout {
                    spacing: Theme.space-3;
                    horizontal-stretch: 1;
                    Skeleton { height: 220px; }
                    Skeleton { height: 160px; }
                }
            }

            // ---------------- content ----------------
            if root.state == 0 : HorizontalLayout {
                spacing: Theme.space-3;
                alignment: start;

                for col in root.columns : VerticalLayout {
                    spacing: Theme.space-3;
                    width: root.card-width;

                    for it in col : IllustCard {
                        item: it;
                        column-width: root.card-width;
                        open => { root.open-illust(it.id); }
                        open-author => { root.open-author(it.author-id); }
                        toggle-bookmark => { root.toggle-bookmark(it.id); }
                    }
                }
            }

            // ---------------- empty / error / locked ----------------
            if root.state != 0 && root.state != 1 : StateView {
                kind: (root.state == 3) ? StateKind.Error
                    : (root.state == 4) ? StateKind.Locked
                    : StateKind.Empty;
                title: root.title;
                description: root.message;
                action-label: root.action-label;
                retry => { root.retry(); }
                action => { root.action(); }
            }

            // ---------------- infinite scroll footer ----------------
            if root.state == 0 && root.loading-more : Rectangle {
                height: 48px;
                Text {
                    text: "正在加载更多…";
                    color: Theme.text-tertiary;
                    font-size: Theme.font-small;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}


