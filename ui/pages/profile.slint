// A native artist / user profile.
//
// This is the page every author link used to bypass by opening a browser. It is
// built from the same data the official user page reads: /ajax/user/{id}?full=1
// for the identity, /ajax/user/{id}/profile/all for the work ids, and a batched
// detail call for the thumbnails. Nothing here is invented: a field the endpoint
// did not send is simply not shown.

import { Theme, Type } from "../theme.slint";
import {
    AppButton, ButtonKind, IconButton, IconSlot, PageScroll, StateView, StateKind, Skeleton,
    ProgressBar, LoadingRow, Avatar, IllustItem, ProfileStatItem,
} from "../components.slint";
import { ArtworkGrid } from "gallery.slint";

export component ProfilePage inherits Rectangle {
    // ---- identity ----
    in property <string> user-name: "";
    in property <string> user-account: "";
    in property <string> user-id: "";
    in property <string> user-comment: "";
    in property <string> webpage: "";
    in property <image> avatar;
    /// 0 ok, 1 loading, 2 failed or absent
    in property <int> avatar-state: 1;
    /// Profile cover image. Named cover, not background: Rectangle already owns
    /// a brush called background and the two cannot share a name.
    in property <image> cover;
    in property <bool> premium: false;
    /// True when this profile is the signed-in account's own page.
    in property <bool> self: false;
    in property <[ProfileStatItem]> stats: [];

    // ---- follow ----
    in property <bool> followed: false;
    /// Disabled while a follow request is in flight, so a double click cannot
    /// send two mutations for one intention.
    in property <bool> busy: false;

    // ---- works ----
    in property <[[IllustItem]]> columns: [];
    in property <length> card-width: 220px;
    /// 0 content, 1 loading, 3 error, 4 empty
    in property <int> state: 0;
    in property <string> message: "";
    in property <bool> loading-more: false;
    in property <string> count-label: "";

    in-out property <length> scroll-y: 0px;

    callback measured(length);
    callback back();
    callback refresh();
    callback retry();
    callback toggle-follow();
    callback open-illust(string);
    callback open-author(string);
    callback toggle-bookmark(string);
    callback open-external();
    callback load-more();

    background: Theme.canvas;

    page := PageScroll {
        width: 100%;
        height: 100%;
        scroll-y <=> root.scroll-y;
        spacing: Theme.space-4;
        width-changed(w) => { root.measured(w); }
        scrolled(y) => {
            if (root.state == 0 && !root.loading-more) {
                if (y + page.viewport-height + 600px >= page.body-height) {
                    root.load-more();
                }
            }
        }

        // ---------------- identity card ----------------
        //
        // Layout note: this Rectangle holds *only* absolutely positioned
        // children. A Rectangle that contains a layout element is itself laid
        // out by Slint, and every explicit x/y inside it is then ignored -- that
        // is what once stacked the name under the statistics. Each band that
        // needs a layout therefore gets its own sub-rectangle whose single child
        // is that layout.
        Rectangle {
            height: 208px;
            border-radius: Theme.radius-lg;
            background: Theme.layer;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            // Cover image, darkened so the text above it stays legible in both
            // themes. A profile without a cover keeps the plain card.
            if root.cover.width > 0 : Rectangle {
                width: 100%;
                height: 92px;
                clip: true;

                Image {
                    source: root.cover;
                    image-fit: ImageFit.cover;
                    width: 100%;
                    height: 100%;
                }
                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: @linear-gradient(180deg, Theme.cover-scrim-top 0%, Theme.cover-scrim-bottom 100%);
                }
            }

            // Back to where you came from.
            IconButton {
                icon: "back";
                x: Theme.space-2;
                y: Theme.space-2;
                tip: "返回";
                clicked => { root.back(); }
            }

            Avatar {
                x: Theme.space-4;
                y: 52px;
                size: 88px;
                ring: true;
                source: root.avatar;
                state: root.avatar-state;
                fallback: root.user-name;
            }

            info-block := Rectangle {
                x: Theme.space-4 + 88px + Theme.space-4;
                y: 56px;
                width: max(0px, parent.width - self.x - 250px);
                height: 46px;

                VerticalLayout {
                    spacing: 2px;
                    alignment: start;

                    HorizontalLayout {
                        spacing: Theme.space-2;
                        alignment: start;

                        Text {
                            text: root.user-name;
                            color: Theme.text;
                            font-size: Theme.font-page;
                            font-weight: Type.semibold;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        if root.premium : Rectangle {
                            width: premium-label.width + 12px;
                            height: 18px;
                            border-radius: Theme.radius-sm;
                            background: Theme.accent-fill;

                            premium-label := Text {
                                x: 6px;
                                y: 0px;
                                height: parent.height;
                                text: "Premium";
                                color: Theme.on-accent;
                                font-size: Theme.font-caption;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Text {
                        text: (root.user-account == "" ? "" : "@" + root.user-account)
                            + (root.user-id == "" ? "" : "   UID " + root.user-id);
                        color: Theme.text-tertiary;
                        font-size: Theme.font-small;
                        overflow: elide;
                    }
                }
            }

            action-block := Rectangle {
                x: parent.width - self.width - Theme.space-4;
                y: 56px;
                width: 210px;
                height: 34px;

                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: end;

                    if !root.self : AppButton {
                        label: root.followed ? "已关注" : "关注";
                        icon: root.followed ? "check" : "follow";
                        kind: root.followed ? ButtonKind.Secondary : ButtonKind.Primary;
                        enabled: !root.busy;
                        clicked => { root.toggle-follow(); }
                    }
                    AppButton {
                        label: "刷新";
                        icon: "refresh";
                        kind: ButtonKind.Secondary;
                        enabled: !root.busy;
                        clicked => { root.refresh(); }
                    }
                }
            }

            // Bio: two lines, fixed height, so a long comment cannot push the
            // grid around while the page loads.
            Text {
                x: Theme.space-4 + 88px + Theme.space-4;
                y: 112px;
                width: max(0px, parent.width - self.x - Theme.space-4);
                height: 34px;
                text: root.user-comment == "" ? "这个用户还没有写简介。" : root.user-comment;
                color: Theme.text-secondary;
                font-size: Theme.font-small;
                wrap: word-wrap;
                overflow: elide;
                max-height: 34px;
            }

            stat-block := Rectangle {
                x: Theme.space-4 + 88px + Theme.space-4;
                y: 158px;
                width: max(0px, parent.width - self.x - Theme.space-4);
                height: 40px;

                VerticalLayout {
                    spacing: 4px;

                    HorizontalLayout {
                        spacing: Theme.space-4;
                        alignment: start;

                        for stat in root.stats : HorizontalLayout {
                            spacing: 4px;
                            alignment: start;
                            Text {
                                text: stat.value;
                                color: Theme.text;
                                font-size: Theme.font-small;
                                font-weight: Type.semibold;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: stat.label;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-caption;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if root.count-label != "" : Text {
                        text: root.count-label;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-caption;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ---------------- works ----------------
        if root.state == 0 : ArtworkGrid {
            columns: root.columns;
            card-width: root.card-width;
            open-illust(id) => { root.open-illust(id); }
            open-author(id) => { root.open-author(id); }
            toggle-bookmark(id) => { root.toggle-bookmark(id); }
        }

        if root.state == 1 : HorizontalLayout {
            spacing: Theme.card-gap;
            alignment: start;
            height: 320px;
            for n in [0, 1, 2, 3] : VerticalLayout {
                spacing: Theme.card-gap;
                width: root.card-width;
                alignment: start;
                Skeleton { height: root.card-width * 1.25; }
                Skeleton { height: 44px; }
            }
        }

        if root.state > 1 : Rectangle {
            height: max(200px, page.viewport-height - 260px);
            StateView {
                width: parent.width;
                height: parent.height;
                kind: (root.state == 3) ? StateKind.Error : StateKind.Empty;
                title: (root.state == 3) ? "无法载入用户主页" : "这个用户还没有公开作品";
                description: root.message;
                action-label: (root.state == 3) ? "重试" : "";
                retry => { root.retry(); }
                action => { root.refresh(); }
            }
        }

        if root.state == 0 && root.loading-more : Rectangle {
            height: 48px;
            LoadingRow {
                y: (parent.height - self.height) / 2;
                label: "正在加载更多作品…";
            }
        }
    }
}
