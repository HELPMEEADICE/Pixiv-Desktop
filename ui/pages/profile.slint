// A native artist / user profile.
//
// This is the page every author link used to bypass by opening a browser. It is
// built from the same data the official user page reads: /ajax/user/{id}?full=1
// for the identity, /ajax/user/{id}/profile/all for the work ids, and a batched
// detail call for the thumbnails. Nothing here is invented: a field the endpoint
// did not send is simply not shown.

import { Theme, Type, Emphasis, TextRole } from "../theme.slint";
import { AppButton, ButtonKind, IconButton, IconSlot, PageScroll, StateView, StateKind, Skeleton, ProgressBar, LoadingRow, Avatar, IllustItem, ProfileStatItem, BatchBar, Label, BodyText } from "../components.slint";
import { ArtworkGrid } from "gallery.slint";

export component ProfilePage inherits Rectangle {
    // ---- identity ----
    in property <string> user-name: "";
    in property <string> user-account: "";
    in property <string> user-id: "";
    in property <string> user-comment: "";
    in property <string> webpage: "";
    in property <image> avatar;
    /// 0 ok, 1 loading, 2 failed or absent
    in property <int> avatar-state: 1;
    /// Profile cover image. Named cover, not background: Rectangle already owns
    /// a brush called background and the two cannot share a name.
    in property <image> cover;
    in property <bool> premium: false;
    /// True when this profile is the signed-in account's own page.
    in property <bool> self: false;
    in property <[ProfileStatItem]> stats: [];

    // ---- follow ----
    in property <bool> followed: false;
    /// Disabled while a follow request is in flight, so a double click cannot
    /// send two mutations for one intention.
    in property <bool> busy: false;

    // ---- works ----
    in property <[[IllustItem]]> columns: [];
    in property <length> card-width: 220px;
    /// 0 content, 1 loading, 3 error, 4 empty
    in property <int> state: 0;
    in property <string> message: "";
    in property <bool> loading-more: false;
    in property <string> count-label: "";

    /// How many placeholder columns to draw while the first page is in flight.
    ///
    /// The same derivation home.slint:126 and gallery.slint:120 use: the resolved
    /// grid answers whenever there is one, and otherwise the arithmetic
    /// `layout::column_count` itself uses — (usable + gap) / (card + gap), floored,
    /// at least one. A literal four only fits one window size; at the 720 px minimum
    /// the body is 618 px and four columns need 829 px in a stream whose horizontal
    /// scrollbar is `always-off`, so the fourth placeholder was sliced off.
    ///
    /// This reads the measured content box, which `PageScroll` derives from the
    /// viewport, so it cannot feed back into itself. `wide` above deliberately does
    /// not read it: the header's own layout would make layout depend on layout.
    property <float> skeleton-columns: root.columns.length > 0
        ? root.columns.length
        : Math.max(1.0, Math.floor(
            (page.body-width + Theme.card-gap)
                / Math.max(1px, root.card-width + Theme.card-gap)));

    in-out property <length> scroll-y: 0px;
    /// Content box is wide enough for the two-column header. Pushed from Rust,
    /// which is the only owner of the measured width - deriving it here from
    /// `page.body-width` would make layout depend on layout, the binding loop
    /// documented in UI-NOTES 1b.
    in property <bool> wide: true;

    callback measured(length);
    callback back();
    callback refresh();
    callback retry();
    callback toggle-follow();
    callback open-illust(string);
    callback open-author(string);
    callback toggle-bookmark(string);
    callback open-external();
    callback load-more();

    // ---- round nine: multi-select (F2) ----
    // The frozen seam, identical to the two grid pages'.
    in-out property <bool> selection-mode: false;
    in property <int> selected-count: 0;
    callback select-all();
    callback clear-selection();
    callback batch-download();
    callback batch-bookmark();
    /// Enter/leave the mode from the page's own toggle. The page does not assign
    /// `selection-mode` itself: the mode is one decision for the whole window (the
    /// same `Selection::active` Rust owns), so the page reports the gesture and the
    /// shell writes the property the page is bound to.
    callback toggle-selection-mode();
    /// Leave the mode outright — the batch bar's 「完成」.
    callback exit-selection();
    /// The keyboard path into select-all. A callback cannot be invoked from outside
    /// the component that declares it, so the shell's Ctrl+A calls this function,
    /// which fires the page's own `select-all` and lets the shell forward it to Rust
    /// like every other gesture.
    public function request-select-all() { root.select-all(); }
    callback card-clicked(string, bool, bool);
    /// U3: which card the Tab walk arrived on, by work id (see `ArtworkGrid`).
    callback card-focused(string);

    background: Theme.canvas;

    page := PageScroll {
        width: 100%;
        height: 100%;
        scroll-y <=> root.scroll-y;
        spacing: Theme.space-4;
        width-changed(w) => { root.measured(w); }
        scrolled(y) => {
            if (root.state == 0 && !root.loading-more) {
                if (y + page.viewport-height + 600px >= page.body-height) {
                    root.load-more();
                }
            }
        }

        // ---------------- identity card ----------------
        //
        // Layout note: this Rectangle holds *only* absolutely positioned
        // children. A Rectangle that contains a layout element is itself laid
        // out by Slint, and every explicit x/y inside it is then ignored -- that
        // is what once stacked the name under the statistics. Each band that
        // needs a layout therefore gets its own sub-rectangle whose single child
        // is that layout.
        Rectangle {
            // U10: the card is as tall as the lowest band it draws, plus one step
            // of air, and never shorter than the two-column shape needs. It used to
            // be a fixed 208/254 px box, so a fifth stat row or a longer comment
            // was cut without a trace; the comment that used to sit here explained
            // why the numbers were two, not why they were constants.
            //
            // `clip` stays: the cover's own corners have to follow the card's
            // radius. It can no longer hide anything, because the height follows
            // the content instead of the content being fitted into a height.
            height: max(
                root.wide ? 208px : 254px,
                stat-block.y + stat-block.height + Theme.space-2);
            border-radius: Theme.radius-lg;
            background: Theme.layer;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            // Cover image, darkened so the text above it stays legible in both
            // themes. A profile without a cover keeps the plain card.
            if root.cover.width > 0 : Rectangle {
                width: 100%;
                height: 92px;
                clip: true;

                Image {
                    source: root.cover;
                    image-fit: ImageFit.cover;
                    width: 100%;
                    height: 100%;
                }
                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: @linear-gradient(180deg, Theme.cover-scrim-top 0%, Theme.cover-scrim-bottom 100%);
                }
            }

            // Back to where you came from.
            IconButton {
                icon: "back";
                x: Theme.space-2;
                y: Theme.space-2;
                tip: "返回";
                clicked => { root.back(); }
            }

            Avatar {
                x: Theme.space-4;
                y: root.wide ? 52px : 44px;
                size: root.wide ? 88px : 56px;
                ring: true;
                source: root.avatar;
                state: root.avatar-state;
                fallback: root.user-name;
            }

            info-block := Rectangle {
                x: root.wide ? Theme.space-4 + 88px + Theme.space-4 : Theme.space-4 + 56px + Theme.space-4;
                y: root.wide ? 56px : 44px;
                // Wide reserves 250px for the action block on the right; narrow has
                // the actions on their own row, so the name gets the whole width.
                width: max(0px, parent.width - self.x - (root.wide ? 250px : Theme.space-4));
                height: 46px;

                VerticalLayout {
                    spacing: 2px;
                    alignment: start;

                    HorizontalLayout {
                        spacing: Theme.space-2;
                        alignment: start;

                        Label {
                            role: TextRole.Page;
                            emphasis: Emphasis.Semibold;
                            text: root.user-name;
                            color: Theme.text;
                            // U10: the fallback is stated here rather than inherited
                            // silently. `Label` elides by default, and the bound it
                            // needs is this block's width - which is
                            // `parent.width - self.x - 250px` in the wide header - so
                            // a long display name now ends in an ellipsis instead of
                            // being cut by the card's clip.
                            overflow: elide;
                        }
                        if root.premium : Rectangle {
                            width: premium-label.width + 12px;
                            height: 18px;
                            border-radius: Theme.radius-sm;
                            background: Theme.accent-fill;

                            premium-label := Text {
                                x: 6px;
                                y: 0px;
                                height: parent.height;
                                text: "Premium";
                                color: Theme.on-accent;
                                font-size: Theme.font-caption;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Label {
                        role: TextRole.Small;
                        text: (root.user-account == "" ? "" : "@" + root.user-account)
                            + (root.user-id == "" ? "" : "   UID " + root.user-id);
                        color: Theme.text-tertiary;
                    }
                }
            }

            action-block := Rectangle {
                // Explicit widths, not `parent.width - self.width`: in the narrow
                // branch `self.width` would depend on `x`, which depends on the
                // width - a loop Slint reports instead of resolving.
                x: root.wide ? parent.width - 210px - Theme.space-4
                    : Theme.space-4 + 56px + Theme.space-4;
                y: root.wide ? 56px : 110px;
                width: root.wide ? 210px
                    : max(0px, parent.width - (Theme.space-4 + 56px + Theme.space-4) - Theme.space-4);
                height: 34px;

                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: end;

                    if !root.self : AppButton {
                        label: root.followed ? "已关注" : "关注";
                        icon: root.followed ? "check" : "follow";
                        kind: root.followed ? ButtonKind.Secondary : ButtonKind.Primary;
                        enabled: !root.busy;
                        clicked => { root.toggle-follow(); }
                    }
                    // The selection toggle is icon-only here and labelled on the two
                    // grid pages: the action block is a fixed 210 px and two labelled
                    // buttons already fill 176 px of it, so a third label would be
                    // clipped. 32 px of square control fits, and `IconButton` names
                    // itself from its tip, so nothing is anonymous to a screen reader.
                    IconButton {
                        icon: root.selection-mode ? "close" : "check";
                        tip: root.selection-mode ? "退出多选" : "多选";
                        active: root.selection-mode;
                        row-height: 34px;
                        clicked => { root.toggle-selection-mode(); }
                    }
                    AppButton {
                        label: "刷新";
                        icon: "refresh";
                        kind: ButtonKind.Secondary;
                        enabled: !root.busy;
                        clicked => { root.refresh(); }
                    }
                }
            }

            // Bio: two lines, fixed height, so a long comment cannot push the
            // grid around while the page loads.
            Text {
                x: root.wide ? Theme.space-4 + 88px + Theme.space-4 : Theme.space-4;
                y: root.wide ? 112px : 150px;
                width: max(0px, parent.width - self.x - Theme.space-4);
                height: root.wide ? 34px : 44px;
                text: root.user-comment == "" ? "这个用户还没有写简介。" : root.user-comment;
                color: Theme.text-secondary;
                font-size: Theme.font-small;
                wrap: word-wrap;
                overflow: elide;
                max-height: root.wide ? 34px : 44px;
            }

            stat-block := Rectangle {
                x: root.wide ? Theme.space-4 + 88px + Theme.space-4 : Theme.space-4;
                y: root.wide ? 158px : 200px;
                width: max(0px, parent.width - self.x - Theme.space-4);
                // A floor, not a ceiling: the two rows it draws fit in 40 px, and
                // a third one grows the card instead of being cut by the card's
                // own clip (U10).
                height: max(root.wide ? 40px : 44px, stat-layout.preferred-height);

                stat-layout := VerticalLayout {
                    spacing: 4px;

                    HorizontalLayout {
                        spacing: Theme.space-4;
                        alignment: start;

                        for stat in root.stats : HorizontalLayout {
                            spacing: 4px;
                            alignment: start;
                            Label {
                                role: TextRole.Small;
                                emphasis: Emphasis.Semibold;
                                text: stat.value;
                                color: Theme.text;
                            }
                            Label {
                                role: TextRole.Caption;
                                text: stat.label;
                                color: Theme.text-tertiary;
                            }
                        }
                    }

                    if root.count-label != "" : Label {
                        role: TextRole.Caption;
                        text: root.count-label;
                        color: Theme.text-tertiary;
                    }
                }
            }
        }

        // ---------------- works ----------------
        if root.state == 0 : ArtworkGrid {
            columns: root.columns;
            card-width: root.card-width;
            open-illust(id) => { root.open-illust(id); }
            open-author(id) => { root.open-author(id); }
            toggle-bookmark(id) => { root.toggle-bookmark(id); }
            card-clicked(id, ctrl, shift) => { root.card-clicked(id, ctrl, shift); }
            card-focused(id) => { root.card-focused(id); }
        }

        if root.state == 1 : HorizontalLayout {
            spacing: Theme.card-gap;
            alignment: start;
            height: 320px;
            for n in root.skeleton-columns : VerticalLayout {
                spacing: Theme.card-gap;
                width: root.card-width;
                alignment: start;
                Skeleton { height: root.card-width * 1.25; }
                Skeleton { height: 44px; }
            }
        }

        if root.state > 1 : Rectangle {
            height: max(200px, page.viewport-height - 260px);
            StateView {
                width: parent.width;
                height: parent.height;
                kind: (root.state == 3) ? StateKind.Error : StateKind.Empty;
                title: (root.state == 3) ? "无法载入用户主页" : "这个用户还没有公开作品";
                description: root.message;
                action-label: (root.state == 3) ? "重试" : "";
                retry => { root.retry(); }
                action => { root.refresh(); }
            }
        }

        if root.state == 0 && root.loading-more : Rectangle {
            height: 48px;
            LoadingRow {
                y: (parent.height - self.height) / 2;
                label: "正在加载更多作品…";
            }
        }

        // Room for the floating batch bar (F2), only while it exists.
        if root.selection-mode : Rectangle {
            height: 48px + Theme.space-3;
        }
    }

    // ---- floating batch bar (F2) ----
    if root.selection-mode : BatchBar {
        x: Theme.space-3;
        width: max(0px, root.width - Theme.space-3 * 2);
        y: root.height - self.height - Theme.space-3;
        count: root.selected-count;
        select-all => { root.select-all(); }
        clear-selection => { root.clear-selection(); }
        batch-download => { root.batch-download(); }
        batch-bookmark => { root.batch-bookmark(); }
        close => { root.exit-selection(); }
    }
}
